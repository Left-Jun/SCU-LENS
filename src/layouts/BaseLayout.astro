---
const {
  title = "SCU LENS · 四川大学摄影协会",
  description = "四川大学摄影协会的线上影像空间，记录作品、活动、每月九图与校园中的光。",
  active = "/",
} = Astro.props;

const nav = [
  { href: "/", label: "首页" },
  { href: "/monthly-nine", label: "每月九图" },
  { href: "/gallery", label: "作品" },
  { href: "/events", label: "活动" },
  { href: "/submit", label: "投稿" },
  { href: "/join", label: "加入我们" },
  { href: "/about", label: "关于" },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f0f0d" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="SCU LENS 首页">
        <span class="brand-mark">SCU</span>
        <span class="brand-word">LENS</span>
        <img class="brand-icon" src="/images/brand/scu-lens-logo-simple.png" alt="" />
      </a>
      <nav aria-label="主导航">
        {nav.map((item) => (
          <a href={item.href} class:list={["nav-link", { active: active === item.href }]}>{item.label}</a>
        ))}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-brand">
        <strong>SCU LENS</strong>
        <span>四川大学摄影协会</span>
      </div>
      <div class="footer-links">
        <a href="/monthly-nine">每月九图</a>
        <a href="/submit">投稿</a>
        <a href="/join">加入我们</a>
        <a href="/about#links">联系与联动</a>
      </div>
      <div class="footer-note">
        <p>记录光，也记录我们在川大的这一段时间。</p>
        <span>Built by Left Jun · 2026</span>
      </div>
    </footer>
    <div class="photo-viewer" id="photo-viewer" hidden aria-hidden="true">
      <button class="photo-viewer-close" type="button" aria-label="关闭看图">×</button>
      <button class="photo-viewer-nav photo-viewer-prev" type="button" aria-label="上一张">‹</button>
      <div class="photo-viewer-stage">
        <div class="photo-viewer-media">
          <div class="photo-viewer-track" id="photo-viewer-track"></div>
        </div>
        <div class="photo-viewer-info">
          <div class="photo-viewer-copy">
            <div class="photo-viewer-kicker" id="photo-viewer-kicker"></div>
            <h2 id="photo-viewer-title"></h2>
            <p id="photo-viewer-author"></p>
            <p class="photo-viewer-description" id="photo-viewer-description"></p>
          </div>
          <div class="photo-viewer-footer">
            <div>
              <span id="photo-viewer-issue"></span>
              <strong id="photo-viewer-count"></strong>
            </div>
            <a id="photo-viewer-original" href="#" target="_blank" rel="noopener">查看原图 ↗</a>
          </div>
        </div>
        <div class="photo-viewer-next-issue" id="photo-viewer-next-issue" hidden>
          <div class="photo-viewer-next-copy">
            <div class="photo-viewer-next-kicker">Next Issue · 下一期</div>
            <h2 id="photo-viewer-next-title"></h2>
            <p id="photo-viewer-next-summary"></p>
            <a id="photo-viewer-next-link" href="/monthly-nine">进入下一期 →</a>
          </div>
          <div class="photo-viewer-next-preview" id="photo-viewer-next-preview" hidden></div>
        </div>
      </div>
      <button class="photo-viewer-nav photo-viewer-next" type="button" aria-label="下一张">›</button>
    </div>
    <script is:inline>
      (() => {
        const viewer = document.getElementById("photo-viewer");
        const track = document.getElementById("photo-viewer-track");
        const kicker = document.getElementById("photo-viewer-kicker");
        const title = document.getElementById("photo-viewer-title");
        const author = document.getElementById("photo-viewer-author");
        const description = document.getElementById("photo-viewer-description");
        const issue = document.getElementById("photo-viewer-issue");
        const count = document.getElementById("photo-viewer-count");
        const original = document.getElementById("photo-viewer-original");
        const nextIssue = document.getElementById("photo-viewer-next-issue");
        const nextTitle = document.getElementById("photo-viewer-next-title");
        const nextSummary = document.getElementById("photo-viewer-next-summary");
        const nextLink = document.getElementById("photo-viewer-next-link");
        const nextPreview = document.getElementById("photo-viewer-next-preview");
        const close = viewer?.querySelector(".photo-viewer-close");
        const prev = viewer?.querySelector(".photo-viewer-prev");
        const next = viewer?.querySelector(".photo-viewer-next");
        let items = [];
        let index = 0;
        let touchStartX = 0;
        let touchStartY = 0;
        let dragging = false;

        const readItems = (group) => Array.from(document.querySelectorAll(`[data-viewer-item][data-viewer-group="${group}"]`));

        const render = () => {
          if (!viewer) return;
          const atNextIssue = index === items.length;
          viewer.classList.toggle("show-next-issue", atNextIssue);
          nextIssue?.toggleAttribute("hidden", !atNextIssue);
          viewer.querySelector(".photo-viewer-media")?.toggleAttribute("hidden", atNextIssue);
          viewer.querySelector(".photo-viewer-info")?.toggleAttribute("hidden", atNextIssue);
          if (atNextIssue) {
            const source = items[items.length - 1];
            if (nextTitle) nextTitle.textContent = source?.dataset.nextTitle || "下一期";
            if (nextSummary) nextSummary.textContent = source?.dataset.nextSummary || "";
            if (nextLink) nextLink.setAttribute("href", source?.dataset.nextHref || "/monthly-nine");
            if (nextPreview instanceof HTMLElement) {
              nextPreview.innerHTML = "";
              let previews = [];
              try {
                previews = JSON.parse(source?.dataset.nextPreviews || "[]");
              } catch {}
              nextPreview.toggleAttribute("hidden", previews.length === 0);
              nextIssue?.classList.toggle("has-preview", previews.length > 0);
              for (const preview of previews.slice(0, 1)) {
                const figure = document.createElement("figure");
                const img = document.createElement("img");
                img.src = preview.src || "";
                img.alt = preview.alt || "";
                img.draggable = false;
                figure.appendChild(img);
                nextPreview.appendChild(figure);
              }
            }
            if (prev instanceof HTMLButtonElement) prev.disabled = false;
            if (next instanceof HTMLButtonElement) next.disabled = true;
            return;
          }
          const item = items[index];
          if (!(item instanceof HTMLElement)) return;
          if (track instanceof HTMLElement) {
            track.style.transition = dragging ? "none" : "transform .32s cubic-bezier(.22,.72,.24,1)";
            track.style.transform = `translate3d(-${index * 100}%,0,0)`;
          }
          if (kicker) kicker.textContent = item.dataset.viewerKicker || "";
          if (title) title.textContent = item.dataset.viewerTitle || "";
          if (author) author.textContent = item.dataset.viewerAuthor ? `摄影 / ${item.dataset.viewerAuthor}` : "";
          if (description) description.textContent = item.dataset.viewerDescription || "";
          if (issue) issue.textContent = item.dataset.viewerIssue || "";
          if (count) count.textContent = `${index + 1} / ${items.length}`;
          if (original) original.setAttribute("href", item.dataset.originalSrc || item.dataset.viewerSrc || "#");
          if (prev instanceof HTMLButtonElement) prev.disabled = index <= 0;
          if (next instanceof HTMLButtonElement) next.disabled = false;
        };

        const openViewer = (group, startIndex) => {
          items = readItems(group);
          if (!viewer || !items.length) return;
          if (track instanceof HTMLElement) {
            track.innerHTML = "";
            for (const item of items) {
              const slide = document.createElement("div");
              slide.className = "photo-viewer-slide";
              const img = document.createElement("img");
              img.src = item.dataset.viewerSrc || item.dataset.originalSrc || "";
              img.alt = item.dataset.viewerAlt || "";
              img.draggable = false;
              slide.appendChild(img);
              track.appendChild(slide);
            }
          }
          index = Math.max(0, Math.min(startIndex, items.length - 1));
          viewer.hidden = false;
          viewer.setAttribute("aria-hidden", "false");
          document.documentElement.classList.add("viewer-open");
          render();
        };

        const closeViewer = () => {
          if (!viewer) return;
          viewer.hidden = true;
          viewer.setAttribute("aria-hidden", "true");
          document.documentElement.classList.remove("viewer-open");
          if (track instanceof HTMLElement) track.innerHTML = "";
        };

        const go = (delta) => {
          index = Math.max(0, Math.min(index + delta, items.length));
          render();
        };

        document.addEventListener("click", (event) => {
          const opener = event.target instanceof Element ? event.target.closest("[data-viewer-open]") : null;
          if (!(opener instanceof HTMLElement)) return;
          event.preventDefault();
          const value = opener.dataset.viewerOpen || "";
          const split = value.lastIndexOf(":");
          if (split < 0) return;
          openViewer(value.slice(0, split), Number(value.slice(split + 1)) || 0);
        });
        close?.addEventListener("click", closeViewer);
        prev?.addEventListener("click", () => go(-1));
        next?.addEventListener("click", () => go(1));
        document.addEventListener("keydown", (event) => {
          if (!viewer || viewer.hidden) return;
          if (event.key === "Escape") closeViewer();
          if (event.key === "ArrowLeft") go(-1);
          if (event.key === "ArrowRight") go(1);
        });
        viewer?.addEventListener("touchstart", (event) => {
          const touch = event.changedTouches[0];
          touchStartX = touch.clientX;
          touchStartY = touch.clientY;
          dragging = true;
          if (track instanceof HTMLElement) track.style.transition = "none";
        }, { passive: true });
        viewer?.addEventListener("touchmove", (event) => {
          if (!dragging || !(track instanceof HTMLElement) || index >= items.length) return;
          const touch = event.changedTouches[0];
          const dx = touch.clientX - touchStartX;
          const dy = touch.clientY - touchStartY;
          if (Math.abs(dx) <= Math.abs(dy)) return;
          const width = viewer.clientWidth || window.innerWidth;
          track.style.transform = `translate3d(${-index * width + dx}px,0,0)`;
        }, { passive: true });
        viewer?.addEventListener("touchend", (event) => {
          const touch = event.changedTouches[0];
          const dx = touch.clientX - touchStartX;
          const dy = touch.clientY - touchStartY;
          dragging = false;
          if (Math.abs(dx) > 52 && Math.abs(dx) > Math.abs(dy)) {
            if (index === items.length && dx < 0) {
              const source = items[items.length - 1];
              const href = source?.dataset.nextHref;
              if (href) window.location.href = href;
              else render();
            } else {
              go(dx < 0 ? 1 : -1);
            }
          }
          else render();
        }, { passive: true });
      })();
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
