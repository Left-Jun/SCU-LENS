---
const {
  title = "SCU LENS · 四川大学摄影协会",
  description = "四川大学摄影协会的线上影像空间，记录作品、活动、每月九图与校园中的光。",
  active = "/",
} = Astro.props;

const nav = [
  { href: "/", label: "首页" },
  { href: "/gallery", label: "作品" },
  { href: "/monthly-nine", label: "每月九图" },
  { href: "/events", label: "活动" },
  { href: "/join", label: "加入我们" },
  { href: "/about", label: "关于" },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f0f0d" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="SCU LENS 首页">
        <span class="brand-mark">SCU</span>
        <span class="brand-word">LENS</span>
      </a>
      <nav aria-label="主导航">
        {nav.map((item) => (
          <a href={item.href} class:list={["nav-link", { active: active === item.href }]}>{item.label}</a>
        ))}
      </nav>
      <button class="image-quality-switch" id="image-quality-switch" type="button" aria-label="切换图片加载质量" aria-pressed="false">
        <span>图片</span>
        <strong data-quality-label>浏览图 · 轻量</strong>
      </button>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-brand">
        <strong>SCU LENS</strong>
        <span>四川大学摄影协会</span>
      </div>
      <div class="footer-links">
        <a href="/monthly-nine">每月九图</a>
        <a href="/join">加入我们</a>
        <a href="/about#links">联系与联动</a>
      </div>
      <p>记录光，也记录我们在川大的这一段时间。</p>
    </footer>
    <script is:inline>
      (() => {
        const key = "scu-lens-image-quality";
        const root = document.documentElement;
        const switcher = document.getElementById("image-quality-switch");
        const label = switcher?.querySelector("[data-quality-label]");
        const getMode = () => localStorage.getItem(key) === "original" ? "original" : "browser";

        const applyImageMode = (img, mode) => {
          if (!(img instanceof HTMLImageElement)) return;
          const browserSrc = img.dataset.browserSrc;
          const originalSrc = img.dataset.originalSrc;
          if (!browserSrc || !originalSrc) return;
          img.src = mode === "original" ? originalSrc : browserSrc;
          if (mode === "browser" && img.dataset.browserSrcset) img.setAttribute("srcset", img.dataset.browserSrcset);
          if (mode === "original") img.removeAttribute("srcset");
          img.dataset.loadedQuality = mode;
        };

        const applyMode = (mode) => {
          root.dataset.imageQuality = mode;
          switcher?.setAttribute("aria-pressed", String(mode === "original"));
          if (label) label.textContent = mode === "original" ? "原图 · 高清" : "浏览图 · 轻量";
          document.querySelectorAll("img[data-browser-src][data-original-src]").forEach((img) => applyImageMode(img, mode));
        };

        applyMode(getMode());
        switcher?.addEventListener("click", () => {
          const next = getMode() === "original" ? "browser" : "original";
          localStorage.setItem(key, next);
          applyMode(next);
        });

        document.addEventListener("click", (event) => {
          const target = event.target instanceof Element ? event.target.closest("[data-load-original]") : null;
          if (!(target instanceof HTMLElement)) return;
          const figure = target.closest("[data-photo-frame]");
          const img = figure?.querySelector("img[data-original-src]");
          if (!(img instanceof HTMLImageElement) || !img.dataset.originalSrc) return;
          img.removeAttribute("srcset");
          img.src = img.dataset.originalSrc;
          img.dataset.loadedQuality = "original";
          target.textContent = "已加载原图";
          target.setAttribute("aria-pressed", "true");
          target.setAttribute("disabled", "");
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
