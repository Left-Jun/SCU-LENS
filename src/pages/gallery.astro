---
import BaseLayout from "../layouts/BaseLayout.astro";

const categories = [
  { slug:"campus", title:"校园", en:"Campus", cls:"visual-campus" },
  { slug:"humanity", title:"人文", en:"Humanity", cls:"visual-documentary" },
  { slug:"urban", title:"城市", en:"Urban", cls:"visual-city" },
  { slug:"nature", title:"自然", en:"Nature", cls:"visual-flower" },
  { slug:"portrait", title:"人像", en:"Portrait", cls:"visual-portrait" },
  { slug:"animals", title:"动物", en:"Animals", cls:"visual-night" },
];
---
<BaseLayout title="作品 · SCU LENS" active="/gallery">
  <div class="page-shell">
    <section class="page-hero">
      <div class="page-hero-title">
        <div class="eyebrow">Selected Works</div>
        <h1 class="display">作品</h1>
      </div>
      <p>从校园出发，沿着人文、城市、自然、人像与动物六类主题浏览属于川大的不同影像。</p>
    </section>

    <section class="section">
      <div class="gallery-grid gallery-category-grid">
        {categories.map((category, i) => (
          <a class:list={["photo-card","gallery-category-card","photo-" + (i + 1)]} href={`/gallery/${category.slug}`}>
            <div class:list={["photo-visual",category.cls]}></div>
            <div class="photo-caption">
              <div>
                <h2>{category.title} / <em>{category.en}</em></h2>
                <p>进入主题分区 →</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section gallery-source">
      <div class="eyebrow">Contribute</div>
      <p>作品来自摄影协会日常投稿与「每月九图」等长期影像项目。</p>
      <a class="text-link" href="/submit">前往投稿专区 <span>↗</span></a>
    </section>
  </div>
</BaseLayout>
