---
import BaseLayout from "../layouts/BaseLayout.astro";

const categories = [
  { slug:"campus", title:"校园", en:"Campus", cls:"visual-campus" },
  { slug:"portrait", title:"人物", en:"Portrait", cls:"visual-portrait" },
  { slug:"spring", title:"春日", en:"Spring", cls:"visual-flower" },
  { slug:"city", title:"城市", en:"City", cls:"visual-city" },
  { slug:"night", title:"夜色", en:"Night", cls:"visual-night" },
  { slug:"everyday", title:"日常", en:"Everyday", cls:"visual-film" },
];
---
<BaseLayout title="作品 · SCU LENS" active="/gallery">
  <div class="page-shell">
    <section class="page-hero">
      <div class="eyebrow">Selected Works</div>
      <h1 class="display">作品</h1>
      <p>作品按主题与内容进入不同分区。相机、手机与胶片只是作品的来源信息，不再决定它属于哪一种作品。</p>
    </section>

    <section class="section">
      <div class="gallery-grid gallery-category-grid">
        {categories.map((category, i) => (
          <a class:list={["photo-card","gallery-category-card","photo-" + (i + 1)]} href={`/gallery/${category.slug}`}>
            <div class:list={["photo-visual",category.cls]}></div>
            <div class="photo-caption">
              <div>
                <h2>{category.title} / <em>{category.en}</em></h2>
                <p>进入主题分区 →</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section gallery-source">
      <div class="eyebrow">Contribute</div>
      <p>作品来自摄影协会日常投稿与「每月九图」等长期影像项目。进入具体作品后，可以看到它的来源与摄影者署名。</p>
      <a class="text-link" href="/submit">前往投稿专区 <span>↗</span></a>
    </section>
  </div>
</BaseLayout>
