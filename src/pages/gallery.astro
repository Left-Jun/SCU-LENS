---
import BaseLayout from "../layouts/BaseLayout.astro";
import galleryData from "../data/gallery.generated.json";

const categoryDefs = [
  { slug:"campus", title:"校园", en:"Campus" },
  { slug:"humanity", title:"人文", en:"Humanity" },
  { slug:"urban", title:"城市", en:"Urban" },
  { slug:"nature", title:"自然", en:"Nature" },
  { slug:"portrait", title:"人像", en:"Portrait" },
  { slug:"animals", title:"动物", en:"Animals" },
];

const categories = categoryDefs.map((category) => {
  const works = galleryData.items.filter((item) => item.category === category.slug);
  return {
    ...category,
    count: works.length,
    cover: works[0]?.src,
  };
});

---

<BaseLayout title="作品 · SCU LENS" active="/gallery">
  <div class="page-shell">
    <section class="page-hero gallery-overview">
      <div class="page-hero-title">
        <div class="eyebrow">Selected Works</div>
        <h1 class="display">作品</h1>
      </div>
      <div class="gallery-overview-copy">
        <p>这里汇集摄协成员记录下的校园、人文、城市、自然、人像与动物影像，六种题材共同构成持续生长的作品档案。</p>
        <a class="view-all-link" href="/gallery/all">查看全部 →</a>
      </div>
    </section>

    <section class="section">
      <div class="gallery-grid gallery-category-grid">
        {categories.map((category) => (
          <a class="photo-card gallery-category-card" href={`/gallery/${category.slug}`}>
            {category.cover
              ? <img class="photo-visual category-cover" src={category.cover} alt={`${category.title}分类代表图`} loading="lazy" decoding="async" />
              : <div class="photo-visual category-cover-empty"></div>}
            <div class="photo-caption">
              <div>
                <h2>{category.title} / <em>{category.en}</em></h2>
                <p>{category.count} 张已归档作品 · 进入分类 →</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section gallery-source">
      <div class="eyebrow">Archive Logic</div>
      <p>校园、人文、城市、自然、人像与动物构成作品库的六个观看方向；每张照片同时保留原本的投稿来源与「每月九图」专题身份。</p>
      <a class="text-link" href="/monthly-nine">查看每月九图 <span>→</span></a>
    </section>
  </div>
</BaseLayout>

<style>
  .category-cover { display:block; object-fit:cover; }
  .category-cover-empty { background:var(--panel); }
  .gallery-overview { padding-bottom:18px; }
  .gallery-overview-copy { position:relative; align-self:end; }
  .gallery-overview-copy p { width:100%; max-width:620px; margin:0; color:var(--muted); font-size:var(--font-body); line-height:var(--line-body); }
  .view-all-link { position:absolute; right:0; bottom:-8px; padding-bottom:3px; border-bottom:1px solid var(--ink); font-size:.78rem; font-weight:700; }
  @media (max-width:700px) {
    .gallery-overview { padding-bottom:14px; }
    .gallery-overview-copy { margin-top:14px; }
    .gallery-overview-copy p { max-width:none; }
    .view-all-link { bottom:-2px; font-size:.76rem; }
  }
</style>
