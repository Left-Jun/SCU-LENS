---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GuangyingPhotoGrid from "../../components/GuangyingPhotoGrid.astro";
import { exhibitions } from "../../lib/guangying-exhibitions";
export function getStaticPaths() {
  return exhibitions.map(exhibition => ({ params: { exhibition: exhibition.slug }, props: { exhibition } }));
}
interface Props { exhibition: (typeof exhibitions)[number]; }
const { exhibition }: Props = Astro.props;
---
<BaseLayout title={`${exhibition.title} · 光影川大 · SCU LENS`} description={exhibition.description} active="/guangying-chuanda">
  <div class="page-shell exhibition-page">
    <a class="back-link text-link" href="/guangying-chuanda#awards">← 返回展览目录</a>
    <header class="exhibition-heading">
      <div class="eyebrow">Light &amp; Life at SCU · Exhibition</div>
      <h1>{exhibition.title}</h1>
      <p class="exhibition-count">{exhibition.count} 张照片</p>
      <p>{exhibition.description}</p>
    </header>
    {exhibition.sections.length > 1 && <nav class="chapter-links" aria-label="展览主题">{exhibition.sections.map(section => <a href={`#${section.id}`}>{section.title}<span>{section.photos.length}</span></a>)}</nav>}
    {exhibition.sections.map((section, index) => (
      <section class="exhibition-chapter" id={section.id} aria-labelledby={`${section.id}-title`}>
        <div class="chapter-heading"><h2 id={`${section.id}-title`}>{section.title}</h2><span>{section.photos.length} 张</span></div>
        <GuangyingPhotoGrid exhibition={exhibition} section={section} priority={index === 0} />
      </section>
    ))}
    <a class="text-link" href="/guangying-chuanda#awards">← 返回展览目录</a>
  </div>
</BaseLayout>
<style>
  .back-link { display:inline-block; margin-bottom:32px; font-size:.8rem; }
  .exhibition-heading { max-width:760px; margin-bottom:32px; }
  h1 { margin:12px 0 14px; font:400 clamp(2.4rem,6vw,5rem)/1.15 var(--font-serif); }
  .exhibition-heading p { color:var(--muted); font-size:.9rem; margin:10px 0 0; }
  .exhibition-heading .exhibition-count { color:var(--ink); font-size:.78rem; }
  .chapter-links { display:flex; flex-wrap:wrap; gap:12px 26px; padding:18px 0; border-block:1px solid var(--line); margin-bottom:36px; }
  .chapter-links a { font-size:.85rem; } .chapter-links span { margin-left:8px; color:var(--muted); font-size:.68rem; }
  .exhibition-chapter { scroll-margin-top:110px; margin-bottom:48px; }
  .chapter-heading { display:flex; align-items:baseline; justify-content:space-between; gap:16px; padding:18px 0; border-top:1px solid var(--line); }
  h2 { margin:0; font:400 clamp(1.5rem,3vw,2.2rem)/1.3 var(--font-serif); }
  .chapter-heading > span { font-size:.72rem; color:var(--muted); }
  @media(max-width:700px) { .back-link { margin-bottom:24px; } .chapter-links { gap:12px 20px; } .exhibition-chapter { margin-bottom:30px; } }
</style>
