---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubmissionCodeDialog from "../components/SubmissionCodeDialog.astro";
import GuangyingFeaturedStrip from "../components/GuangyingFeaturedStrip.astro";


import { exhibitions } from "../lib/guangying-exhibitions";
const album = exhibitions.find(exhibition => exhibition.slug === "album")!;
const albumPhotos = album.sections.flatMap(section => section.photos);
const calendar = exhibitions.find(exhibition => exhibition.slug === "calendar")!;
const calendarPhotos = calendar.sections.flatMap(section => section.photos);
const qrSrc = "/images/guangying-chuanda/submission-code.jpg";
const channelUrl = "https://pd.qq.com/s/g39qgegw0?b=9";
---
<BaseLayout title="光影川大 · SCU LENS" description="光影川大联合征稿与投稿入口，记录四川大学的校园影像。" active="/guangying-chuanda">
  <div class="page-shell guangying-home">
    <section class="call-opening" aria-labelledby="current-call-title">
      <div class="call-brand">
        <h1><img src="/images/guangying-chuanda/logo.svg" alt="光影川大" width="160" height="193" fetchpriority="high" /></h1>
        <span>联合征稿</span>
      </div>
      <div class="call-heading">
        <div class="call-kicker"><span>本期征集</span><span>长期开放</span></div>
        <h2 id="current-call-title">看见川大，<br />留住此刻。</h2>
      </div>
      <div class="call-invitation">
        <p>光穿过校园，也经过我们的日常。<br />持续征集校园影像，留下你眼中的川大。</p>
        <div class="call-actions"><a class="text-link" href="#contribute">参与本期征集 →</a><a class="text-link" href="#calendar">看看往期影像 ↓</a></div>
      </div>
    </section>
    <section class="section calendar-section" id="calendar" aria-labelledby="calendar-title">
      <div class="calendar-intro"><div class="eyebrow">Calendar &amp; Campus Design</div><h2 class="section-display" id="calendar-title">台历里的川大</h2><p>从征集作品中选取部分影像，用于川大台历等文创设计，让镜头里的校园风景走进日常。</p></div>
      <GuangyingFeaturedStrip photos={calendarPhotos} sideThumbs groupId="guangying-calendar-preview" allHref="/guangying-chuanda/calendar" />
    </section>
    <section class="section featured-section" id="awards" aria-labelledby="awards-title">
      <div class="section-kicker-row">
        <div><div class="eyebrow">Selected Photographs</div><h2 class="section-display" id="awards-title">往期影像</h2></div>
        <p>校园的四季、熟悉的角落与日常中的片刻。这里收录往期画册影像，也期待下一幅来自你的镜头。</p>
      </div>
      <GuangyingFeaturedStrip photos={albumPhotos} />
    </section>
    <section class="section contribute-section" id="contribute" aria-labelledby="contribute-title">
      <span id="submissions" class="submission-anchor" aria-hidden="true"></span>
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Open Call</div>
          <h2 class="section-display" id="contribute-title">投来你的<br class="desktop-break" />川大影像。</h2><p class="contribute-intro">持续征集校园风景与日常 · 选择一种方式投稿即可</p>
        </div>
      </div>
      <div class="call-notes" aria-labelledby="call-notes-title">
        <h3 id="call-notes-title">本期征集说明</h3>
        <dl class="call-details">
          <div><dt>征集内容</dt><dd>与四川大学有关，能辨识出川大场景或相关符号的校园摄影作品。</dd></div>
          <div><dt>作品要求</dt><dd>内容积极、画面美观，记录真实的校园生活。</dd></div>
          <div><dt>展示机会</dt><dd>部分入选影像有机会参与线下展览，或用于川大台历等文创设计。</dd></div>
        </dl>
      </div>
      <div class="contribute-grid">
        <div class="channel-contribute" aria-labelledby="channel-title">
          <span class="channel-recommendation">协会合作征集</span>
          <h3 id="channel-title">QQ 频道投稿</h3>
          <p>进入摄影协会 QQ 频道，在「光影川大」栏目发布作品。</p>
          <p class="contribution-flow">频道投稿 → 协会筛选 → 推荐至光影川大</p>
          <a class="text-link channel-link" href={channelUrl} target="_blank" rel="noreferrer">进入 QQ 频道 ↗</a>
        </div>
        <div class="official-contribute" aria-labelledby="official-title">
          <span class="channel-recommendation">直接向光影川大投稿</span>
          <h3 id="official-title">官方投稿</h3>
          <p>使用微信扫描下方小程序码，直接向「光影川大」提交作品。</p>
          <SubmissionCodeDialog src={qrSrc} />
        </div>
      </div>
      <p class="contribute-note">同一作品选择一种方式提交即可，两个入口的投稿不会自动同步。</p>
    </section>
  </div>
</BaseLayout>
<style>
  :global(body:has(.featured-section)){min-width:0}
  .section{padding-block:48px}
  .section-display{font:400 clamp(32px,4vw,54px)/1.15 var(--font-serif);letter-spacing:-.035em;margin:10px 0 0}
  .section-kicker-row{grid-template-columns:minmax(0,1fr) minmax(0,.75fr);gap:24px;margin-bottom:28px;align-items:end}.section-kicker-row>p{font-size:13px;line-height:1.6;max-width:290px;justify-self:end}
  .featured-section,.calendar-section,.contribute-section,.submission-anchor{scroll-margin-top:110px}
  .calendar-section{position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(0,.65fr) minmax(0,1.35fr);gap:clamp(32px,5vw,72px);align-items:center;padding-block:48px}
  .calendar-section::before{content:"";position:absolute;inset:0;background:rgba(115,95,61,.035);z-index:-1;pointer-events:none}
  .calendar-intro .section-display{font-size:30px}.calendar-statement{font:400 clamp(36px,4vw,54px)/1.25 var(--font-serif);letter-spacing:-.035em;margin:28px 0 24px;color:var(--ink)!important}
  .calendar-intro>p:not(.calendar-statement){font-size:13px;line-height:1.6;color:var(--muted);margin:0}
  .contribute-section{position:relative;display:grid;grid-template-columns:minmax(0,.65fr) minmax(0,1.35fr);column-gap:clamp(32px,5vw,72px);row-gap:22px}
  .contribute-section>.section-kicker-row{display:block;grid-column:1;grid-row:1/span 3;margin:0}.contribute-section .section-display{font-size:clamp(32px,3.3vw,44px);line-height:1.3}.contribute-intro{font-size:12px;line-height:1.6;color:var(--muted);margin:20px 0 0}
  .call-notes,.contribute-grid,.contribute-note{grid-column:2;min-width:0}
  .call-notes{margin:0;border-bottom:1px solid var(--line)}.call-notes summary{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:44px;padding:0 0 16px;cursor:pointer;list-style:none;font-size:13px}.call-notes summary::-webkit-details-marker{display:none}.call-notes summary span{font-size:11px;color:var(--muted)}
  .call-details{display:grid;grid-template-columns:1fr;gap:14px;margin:0 0 20px}.call-details>div{display:grid;grid-template-columns:64px minmax(0,1fr);gap:14px}.call-details dt{font-size:12px}.call-details dd{margin:0;font-size:12px;line-height:1.6;color:var(--muted)}
  .contribute-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:28px;align-items:start}.contribute-grid h3{font:400 24px/1.3 var(--font-serif);margin:8px 0 16px}.channel-recommendation{display:block;font-size:11px;color:var(--muted);margin-bottom:8px}.contribute-grid p{font-size:13px;color:var(--muted);line-height:1.6;margin:0 0 16px}.contribute-grid .contribution-flow{font-size:11px;color:var(--ink)}
  .contribute-grid a{display:inline-flex;align-items:center;min-height:44px;font-size:13px}.official-contribute{border-left:1px solid var(--line);padding-left:28px}.official-contribute h3{margin-top:27px}
  .contribute-note{margin:0;padding-top:18px;border-top:1px solid var(--line);font-size:11px;line-height:1.6;color:var(--muted)}
  .submission-anchor{position:absolute;top:0;left:0}
  @media(min-width:701px) and (max-width:1000px){.contribute-section{grid-template-columns:1fr;gap:24px}.contribute-section>.section-kicker-row{grid-row:auto;grid-column:1}.contribute-section .section-display br{display:none}.call-notes,.contribute-grid,.contribute-note{grid-column:1}.contribute-intro{margin-top:12px}}
  @media(max-width:700px){
    .section{padding-block:32px}.section-display{font-size:32px}.section-kicker-row{grid-template-columns:1fr;gap:12px;margin-bottom:22px}.section-kicker-row>p{justify-self:start;max-width:none;font-size:12px}
    .calendar-section{grid-template-columns:1fr;gap:22px}.calendar-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px 20px;align-items:end}.calendar-intro>.eyebrow{grid-column:1/-1}.calendar-intro .section-display{grid-column:1;grid-row:2;font-size:30px;margin:4px 0 0}.calendar-intro .calendar-statement{display:none}.calendar-intro>p:not(.calendar-statement){grid-column:1/-1;grid-row:3;font-size:12px;line-height:1.6;margin-top:6px}.calendar-intro .section-display{grid-column:1/-1}
    .contribute-section{grid-template-columns:1fr;gap:22px}.contribute-section>.section-kicker-row{grid-column:1;grid-row:auto}.contribute-section .section-display{font-size:32px}.desktop-break{display:none}.contribute-intro{margin-top:12px}.call-notes,.contribute-grid,.contribute-note{grid-column:1}.call-notes summary{flex-wrap:wrap}.call-details>div{gap:10px}
    .contribute-grid{grid-template-columns:1fr;gap:22px}.contribute-grid h3{font-size:24px}.official-contribute{padding:22px 0 0;border-left:0;border-top:1px solid var(--line);display:grid;grid-template-columns:minmax(0,1fr) 132px;column-gap:16px;align-content:start}.official-contribute h3{margin:0 0 12px;grid-column:1}.official-contribute>p{grid-column:1;font-size:12px;margin:0}.official-contribute :global(.submission-code){grid-column:2;grid-row:1/span 2;margin:0}.official-contribute :global(.submission-code figcaption){font-size:10px}.contribute-note{padding-top:16px}
  }

  .call-notes h3{margin:0 0 18px;font-size:13px;font-weight:500}
  @media(min-width:701px){
    .calendar-section{display:block;background:none}.calendar-section::before{display:none}
    .calendar-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.75fr);column-gap:24px;align-items:end;margin-bottom:28px}
    .calendar-intro>.eyebrow{grid-column:1;grid-row:1}.calendar-intro .section-display{grid-column:1;grid-row:2;font-size:clamp(32px,4vw,54px)}
    .calendar-intro>p:not(.calendar-statement){grid-column:2;grid-row:1/span 2;justify-self:end;max-width:430px;font-size:13px;line-height:1.6}.calendar-intro>p br{display:none}
    .contribute-section{display:block}.contribute-section>.section-kicker-row{display:block;margin-bottom:30px}.contribute-section .section-display{font-size:clamp(32px,4vw,54px)}.desktop-break{display:none}.contribute-intro{margin:14px 0 0}
    .call-notes{border-block:1px solid var(--line);padding:22px 0;margin-bottom:30px}.call-details{grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;margin:0}.call-details>div{display:block}.call-details dt{margin-bottom:8px}.call-details dd{font-size:13px}
    .contribute-grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;margin-bottom:28px}.contribute-grid h3{font-size:28px}.channel-contribute{padding-right:16px}.official-contribute{display:grid;grid-template-columns:minmax(0,1fr) 156px;column-gap:24px;padding-left:36px}.official-contribute h3{grid-column:1;margin-top:27px}.official-contribute>p{grid-column:1}.official-contribute :global(.submission-code){grid-column:2;grid-row:1/span 2;margin:0;align-self:start}.contribute-grid p{font-size:14px}
  }
  @media(max-width:700px){.call-notes{border-block:1px solid var(--line);padding:18px 0}.calendar-intro>p br{display:none}}

  @media(max-width:700px){
    .section{padding-block:28px}.calendar-intro{margin-bottom:0}.calendar-intro .section-display,.section-display{font-size:30px}
    .calendar-intro>p:not(.calendar-statement),.section-kicker-row>p{font-size:13px;line-height:1.6;max-width:none}
    .calendar-section{gap:18px}.section-kicker-row{margin-bottom:20px}
    .call-details{gap:18px}.call-details>div{display:block}.call-details dt{margin-bottom:6px;font-size:13px}.call-details dd{font-size:13px;line-height:1.6}
    .contribute-grid p{font-size:13px}.contribute-note{font-size:12px}
  }
  @media(max-width:360px){.official-contribute{grid-template-columns:minmax(0,1fr) 112px;column-gap:12px}.contribute-section .section-display{font-size:28px}}

  .page-shell>section{width:100%;min-width:0;box-sizing:border-box}
  .section-kicker-row,.calendar-intro,.contribute-grid,.call-details{min-width:0}
  .section-kicker-row>p,.calendar-intro>p:not(.calendar-statement){width:100%;max-width:none;justify-self:stretch}
  .contribute-note{width:100%;box-sizing:border-box}
  @media(min-width:701px){
    .section-kicker-row,.calendar-intro{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:48px}
    .section-kicker-row>p,.calendar-intro>p:not(.calendar-statement){max-width:none;justify-self:stretch}
    .channel-contribute{padding-right:0}
    .official-contribute{position:relative;padding-left:0;border-left:0;align-content:start}
    .official-contribute::before{content:"";position:absolute;left:-24px;top:0;bottom:0;border-left:1px solid var(--line)}
    .official-contribute>.channel-recommendation{grid-column:1;grid-row:1}
    .official-contribute h3{grid-column:1;grid-row:2;margin:8px 0 16px}
    .official-contribute>p{grid-column:1;grid-row:3}
    .official-contribute :global(.submission-code){grid-column:2;grid-row:1/span 3;width:100%;max-width:none;margin:0}
  }
  @media(max-width:700px){
    .section-kicker-row,.calendar-intro{width:100%;grid-template-columns:minmax(0,1fr)}
    .calendar-intro .section-display{grid-column:1;grid-row:2}
    .calendar-intro>.eyebrow,.calendar-intro>p:not(.calendar-statement){grid-column:1}
    .official-contribute>.channel-recommendation{grid-column:1;grid-row:1}
    .official-contribute h3{grid-column:1;grid-row:2;margin:0 0 12px}
    .official-contribute>p{grid-column:1;grid-row:3}
    .official-contribute :global(.submission-code){grid-column:2;grid-row:1/span 3;width:100%;max-width:none;margin:0}
    .contribute-grid{width:100%}
  }
  @media(max-width:700px){
    .calendar-intro,.section-kicker-row,.call-notes,.contribute-grid,.contribute-note{text-align:left}
    .calendar-intro>p:not(.calendar-statement),.section-kicker-row>p{justify-self:start;text-align:left}
    .official-contribute :global(.submission-code figcaption){text-align:left}
  }
  .calendar-intro{display:block;width:100%;text-align:left;margin-bottom:24px}
  .calendar-intro>.eyebrow,.calendar-intro .section-display,.calendar-intro>p:not(.calendar-statement){text-align:left;justify-self:start}
  .calendar-intro>p:not(.calendar-statement){margin:12px 0 0;width:100%;max-width:none;line-height:1.6}
  @media(max-width:700px){.calendar-intro{margin-bottom:0}.call-details{gap:14px}}
  @media(max-width:900px){
    .guangying-home .section-kicker-row{display:block;width:100%;align-items:flex-start;justify-content:flex-start;margin:0 0 14px;text-align:left}
    .guangying-home .section-kicker-row>div{display:block;width:100%;margin:0;text-align:left}
    .guangying-home .section-kicker-row>p{width:100%;max-width:none;margin:8px 0 0;text-align:left;line-height:1.45}
    .guangying-home .section-display,.guangying-home .calendar-intro .section-display{font-size:26px;line-height:1.2;margin:6px 0 0;text-align:left}
    .guangying-home .eyebrow{font-size:10px;line-height:1.35;letter-spacing:.1em}
    .guangying-home .calendar-intro{display:block;margin:0;text-align:left}
    .guangying-home .calendar-intro>p:not(.calendar-statement){margin:8px 0 0;line-height:1.45}
    .guangying-home .section{padding-block:22px}.guangying-home .calendar-section{gap:14px}
    .guangying-home .contribute-intro,.guangying-home .contribute-grid p,.guangying-home .call-details dd,.guangying-home .contribute-note{line-height:1.5}
  }

  .call-opening{display:grid;grid-template-columns:160px minmax(0,1fr) minmax(0,.95fr);align-items:center;gap:clamp(32px,4vw,60px);padding:40px 0 44px;text-align:left}
  .call-brand h1{margin:0;line-height:1}.call-brand img{display:block;width:auto;height:160px;max-width:100%}
  .call-brand>span{display:block;margin-top:12px;font-size:11px;line-height:1.4;letter-spacing:.14em}
  .call-kicker{display:flex;flex-wrap:wrap;gap:8px 16px;font-size:11px;line-height:1.4;letter-spacing:.08em;color:var(--muted)}
  .call-heading h2{margin:14px 0 0;font:400 clamp(36px,4vw,56px)/1.2 var(--font-serif);letter-spacing:-.035em}
  .call-invitation{min-width:0}.call-invitation>p{margin:0;color:var(--muted);font-size:14px;line-height:1.6}
  .call-actions{display:flex;flex-wrap:wrap;gap:8px 24px;margin-top:20px}
  .call-actions a{display:inline-flex;align-items:center;min-height:44px;padding:6px 0;border-bottom:1px solid var(--ink);font-size:13px;line-height:1.4}
  .call-actions a:first-child{font-weight:700}.call-actions a:last-child{color:var(--muted);border-color:var(--line)}
  @media(max-width:1000px){
    .call-opening{grid-template-columns:132px minmax(0,1fr);gap:24px 32px;padding:32px 0}
    .call-brand{grid-row:1/span 2;align-self:start}.call-brand img{height:132px}
    .call-heading h2{font-size:40px}.call-invitation{grid-column:2}.call-actions{margin-top:12px}
  }
  @media(max-width:600px){
    .call-opening{grid-template-columns:74px minmax(0,1fr);gap:20px 20px;padding:24px 0 28px}
    .call-brand{grid-row:1;align-self:center}.call-brand img{height:88px}.call-brand>span{margin-top:8px;font-size:11px;letter-spacing:.08em}
    .call-kicker{gap:8px 12px;font-size:10px}.call-heading h2{margin-top:10px;font-size:clamp(28px,7.7vw,40px);line-height:1.2}
    .call-invitation{grid-column:1/-1}.call-invitation>p{font-size:13px;line-height:1.5}.call-invitation>p br{display:none}
    .call-actions{gap:8px 24px;margin-top:12px}.call-actions a{font-size:12px}
  }

  .guangying-home .section{padding-block:var(--space-heading-gap)}
  .guangying-home .call-opening{gap:24px;padding-block:var(--space-heading-gap)}
  .guangying-home .call-invitation>p,.guangying-home .calendar-intro>p:not(.calendar-statement),.guangying-home .section-kicker-row>p,.guangying-home .contribute-grid p{font-size:var(--font-body);line-height:var(--line-body)}
  .guangying-home .call-actions{gap:12px 20px;margin-top:8px}
  .guangying-home .call-actions a,.guangying-home .contribute-grid a{display:inline-block;position:relative;min-height:0;padding:0 0 5px;font-size:.86rem;font-weight:600;line-height:var(--line-body)}
  .guangying-home .call-actions a::before,.guangying-home .contribute-grid a::before{content:"";position:absolute;inset:-8px 0;min-height:44px}
  .guangying-home .calendar-intro{margin-bottom:16px}
  .guangying-home .section-kicker-row{margin-bottom:16px}
  .guangying-home .contribute-section>.section-kicker-row{margin-bottom:16px}
  .guangying-home .call-notes{padding-block:16px;margin-bottom:16px}
  .guangying-home .call-notes h3{margin-bottom:12px}
  .guangying-home .contribute-grid{gap:24px;margin-bottom:16px}
  .guangying-home .official-contribute::before{left:-12px}
  @media(max-width:700px){
    .guangying-home .call-opening{gap:16px 20px}
    .guangying-home .calendar-intro{margin-bottom:0}
    .guangying-home .contribute-grid{gap:16px}
    .guangying-home .official-contribute::before{display:none}
  }
</style>
