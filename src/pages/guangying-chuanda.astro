---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubmissionCodeDialog from "../components/SubmissionCodeDialog.astro";
import GuangyingWorkList from "../components/GuangyingWorkList.astro";
import { collections } from "../lib/guangying-chuanda";
import GalleryImage from "../components/GalleryImage.astro";
import { themeIssues } from "../lib/guangying-exhibitions";
const openingPhoto = themeIssues.flatMap(issue => issue.photos).find(photo => photo.id === "7207c5023eaf61d6bd2b")!;
const submissions = collections.find((collection) => collection.id === "submissions")!;
const qrSrc = "/images/guangying-chuanda/submission-code.jpg";
const channelUrl = "https://pd.qq.com/s/g39qgegw0?b=9";
---
<BaseLayout title="光影川大 · SCU LENS" description="光影川大本期征稿、往期展览与投稿入口，记录四川大学的校园影像。" active="/guangying-chuanda">
  <div class="page-shell">
    <section class="guangying-opening" aria-labelledby="current-call-title">
      <div class="opening-main">
        <div class="opening-brand">
          <h1 class="guangying-heading"><img class="guangying-logo" src="/images/guangying-chuanda/logo.svg" alt="光影川大" width="160" height="193" fetchpriority="high" /></h1>
          <span class="eyebrow">Light &amp; Life at SCU</span>
        </div>
        <div class="opening-copy">
          <div class="opening-kicker"><span class="eyebrow">Current Call · 本期征集</span><span class="call-status">长期开放</span></div>
          <h2 id="current-call-title">看见川大，<br />留住此刻。</h2>
          <p>光穿过校园，也经过我们的日常。<br />光影川大持续征集校园影像，邀你留下属于川大的这一刻。</p>
          <div class="current-actions"><a class="current-submit" href="#contribute">参与本期征集 →</a><a class="text-link" href="#awards">回看往期主题 ↓</a></div>
        </div>
        <figure class="opening-photograph">
          <GalleryImage photo={openingPhoto} alt="逆光下的江安校门，一位骑车人经过门前" sizes="(max-width:700px) calc(100vw - 40px), (max-width:1280px) 60vw, 740px" priority />
          <figcaption><span>《{openingPhoto.title}》{openingPhoto.author ? ` · ${openingPhoto.author}` : ""}</span><span>选自往期画册</span></figcaption>
        </figure>
      </div>
      <div class="current-submissions" id="submissions">
        {submissions.photoCount > 0 ? (
          <>
            <p class="collection-count">本期协会投稿 · {submissions.works.length} 组作品 · {submissions.photoCount} 张照片</p>
            <GuangyingWorkList collection={submissions} priority />
          </>
        ) : null}
      </div>
    </section>
    <section class="section collection-section" id="awards" aria-labelledby="awards-title">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Archive · Earlier Exhibitions</div>
          <h2 class="section-display" id="awards-title">往期展览</h2>
        </div>
        <p>按主题回看川大影像，打开每一期，慢慢看。</p>
      </div>
      <div class="theme-issue-list">
        {themeIssues.map((issue, index) => (
          <article class:list={["theme-issue-card", { "theme-feature": index === 0 || index === themeIssues.length - 1, "theme-finale": index === themeIssues.length - 1 }]}>
            <a class="theme-issue-link" href={issue.href}>
              <div class="theme-issue-visual">
                <GalleryImage photo={issue.cover} alt={issue.cover.title || issue.title} sizes={index === 0 || index === themeIssues.length - 1 ? "(max-width:700px) calc(100vw - 40px), 65vw" : "(max-width:700px) calc(100vw - 40px), 46vw"} />
              </div>
              <div class="theme-issue-content">
                <div class="theme-issue-heading"><span class="theme-issue-index">{String(index + 1).padStart(2, "0")}</span><h3>{issue.title}</h3><span class="theme-open" aria-hidden="true">↗</span></div>
                <div class="theme-issue-meta"><span>{issue.en}</span><span>{issue.photos.length} 张照片</span></div>
                <span class="theme-read">翻开这一辑 →</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
    <section class="section contribute-section" id="contribute" aria-labelledby="contribute-title">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Contribute · Two Ways to Submit</div>
          <h2 class="section-display" id="contribute-title">投稿入口</h2>
        </div>
      </div>
      <details class="call-notes">
        <summary>本期征集说明<span>长期开放 · 查看作品要求与展示机会 ＋</span></summary>
        <dl class="call-details">
          <div><dt>征集内容</dt><dd>与四川大学有关，能辨识出川大场景或相关符号的校园摄影作品。</dd></div>
          <div><dt>作品要求</dt><dd>内容积极、画面美观，记录真实的校园生活。</dd></div>
          <div><dt>展示机会</dt><dd>优秀作品有机会入选线下展览，或用于川大官方文创制作。</dd></div>
        </dl>
      </details>
      <div class="contribute-grid">
        <div class="channel-contribute" aria-labelledby="channel-title">
          <span class="channel-recommendation">推荐 · 协会征集</span>
          <h3 id="channel-title">QQ 频道投稿</h3>
          <p>进入摄影协会 QQ 频道，在「光影川大」栏目发布作品。</p>
          <p class="contribution-flow">频道投稿 → 协会筛选 → 推荐至光影川大</p>
          <a class="text-link channel-link" href={channelUrl} target="_blank" rel="noreferrer">进入 QQ 频道 ↗</a>
        </div>
        <div class="official-contribute" aria-labelledby="official-title">
          <h3 id="official-title">官方投稿</h3>
          <p>使用微信扫描下方小程序码，直接向「光影川大」提交作品。</p>
          <SubmissionCodeDialog src={qrSrc} />
        </div>
      </div>
      <p class="contribute-note">同一作品选择一种方式提交即可，两个入口的投稿不会自动同步。</p>
    </section>
  </div>
</BaseLayout>
<style>
  .guangying-opening { padding:clamp(28px,4vw,48px) 0 34px; }
  .opening-main { display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.5fr); grid-template-rows:auto 1fr; gap:30px clamp(28px,5vw,70px); align-items:start; }
  .opening-brand { display:flex; align-items:flex-end; gap:20px; grid-column:1; grid-row:1; }
  .guangying-heading { margin:0; line-height:1; }
  .guangying-logo { display:block; width:auto; height:88px; max-width:100%; }
  .opening-brand .eyebrow { max-width:115px; padding-bottom:3px; font-size:.56rem; letter-spacing:.13em; }
  .opening-copy { grid-column:1; grid-row:2; align-self:end; padding-bottom:24px; }
  .opening-kicker { display:flex; align-items:center; flex-wrap:wrap; gap:14px; }
  .opening-kicker .eyebrow { font-size:.6rem; }
  .call-status { font-size:.65rem; color:var(--muted); white-space:nowrap; }
  .opening-copy h2 { margin:20px 0; font:400 clamp(2.1rem,4vw,3.65rem)/1.24 var(--font-serif); letter-spacing:-.035em; }
  .opening-copy > p { max-width:310px; margin:0 0 26px; font-size:.83rem; line-height:1.95; color:var(--muted); }
  .current-actions { display:flex; align-items:center; flex-wrap:wrap; gap:22px; }
  .current-submit { padding:0 0 7px; border-bottom:1px solid var(--ink); font-size:.78rem; font-weight:700; }
  .current-actions .text-link { color:var(--muted); font-size:.72rem; }
  .opening-photograph { grid-column:2; grid-row:1 / span 2; margin:0; }
  .opening-photograph :global(img) { width:100%; height:auto; }
  .opening-photograph figcaption { display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px; margin-top:12px; font-size:.62rem; line-height:1.6; color:var(--muted); }
  .current-submissions:not(:empty) { margin-top:26px; }
  .theme-issue-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:40px 30px; }
  .theme-issue-link { display:block; }
  .theme-issue-visual :global(picture),.theme-issue-visual :global(img) { display:block; width:100%; height:auto; }
  .theme-issue-content { padding-top:16px; }
  .theme-issue-heading { display:flex; align-items:center; gap:12px; }
  .theme-issue-index { font-size:.65rem; color:var(--muted); letter-spacing:.08em; }
  .theme-issue-heading h3 { margin:0; font:400 clamp(1.5rem,2.6vw,2.1rem)/1.2 var(--font-serif); }
  .theme-open { margin-left:auto; font-size:1.2rem; transition:transform .2s ease; }
  .theme-issue-link:hover .theme-open { transform:translate(2px,-2px); }
  .theme-issue-meta { display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px; margin-top:10px; font-size:.62rem; letter-spacing:.06em; color:var(--muted); }
  .theme-read { display:none; }
  .theme-feature { grid-column:1 / -1; }
  .theme-feature .theme-issue-link { display:grid; grid-template-columns:minmax(0,1.6fr) minmax(0,1fr); align-items:center; gap:clamp(26px,5vw,64px); }
  .theme-feature .theme-issue-content { padding:0; }
  .theme-feature .theme-issue-heading { flex-wrap:wrap; gap:18px; }
  .theme-feature .theme-issue-index { width:100%; }
  .theme-feature h3 { font-size:clamp(2rem,3.5vw,3.3rem); }
  .theme-feature .theme-open { display:none; }
  .theme-feature .theme-issue-meta { justify-content:flex-start; flex-direction:column; gap:18px; margin-top:18px; }
  .theme-feature .theme-read { display:inline-block; margin-top:30px; padding-bottom:5px; border-bottom:1px solid var(--line); font-size:.75rem; }
  .theme-finale .theme-issue-link { grid-template-columns:minmax(0,1fr) minmax(0,1.6fr); }
  .theme-finale .theme-issue-visual { grid-column:2; grid-row:1; }
  .theme-finale .theme-issue-content { grid-column:1; grid-row:1; }
  .theme-issue-link:focus-visible { outline:2px solid var(--ink); outline-offset:6px; }
  .call-notes { margin:0 0 28px; border-block:1px solid var(--line); }
  .call-notes summary { display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px; padding:18px 0; cursor:pointer; list-style:none; font-size:.85rem; }
  .call-notes summary::-webkit-details-marker { display:none; }
  .call-notes summary span { font-size:.7rem; color:var(--muted); }
  .call-notes summary:focus-visible { outline:2px solid var(--ink); outline-offset:4px; }
  .call-details { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:28px; margin:0 0 22px; }
  .call-details dt { margin-bottom:10px; font-size:.73rem; }
  .call-details dd { margin:0; color:var(--muted); font-size:.8rem; line-height:1.8; }
  @media(max-width:700px) {
    .guangying-opening { padding:24px 0 28px; }
    .opening-main { grid-template-columns:1fr; gap:22px; }
    .opening-brand { grid-column:1; grid-row:1; justify-content:space-between; }
    .guangying-logo { height:70px; }
    .opening-brand .eyebrow { max-width:100px; font-size:.55rem; }
    .opening-photograph { grid-column:1; grid-row:2; }
    .opening-copy { grid-column:1; grid-row:3; padding:0; }
    .opening-copy h2 { margin:14px 0; font-size:2.5rem; }
    .opening-copy > p { max-width:none; font-size:.8rem; margin-bottom:18px; }
    .current-actions { gap:20px; }
    .theme-issue-list { grid-template-columns:1fr; gap:30px; }
    .theme-feature .theme-issue-link { display:block; }
    .theme-issue-content,.theme-feature .theme-issue-content { padding-top:12px; }
    .theme-feature .theme-issue-heading { flex-wrap:nowrap; gap:12px; }
    .theme-feature .theme-issue-index { width:auto; }
    .theme-feature h3 { font-size:1.65rem; }
    .theme-feature .theme-open { display:inline; }
    .theme-feature .theme-issue-meta { flex-direction:row; justify-content:space-between; gap:8px; margin-top:10px; }
    .theme-feature .theme-read { display:none; }
    .call-details { grid-template-columns:1fr; gap:18px; }
  }
  @media(prefers-reduced-motion:reduce) { .theme-open { transition:none; } }
  .current-submissions,.collection-section,.contribute-section { scroll-margin-top:110px; }
  .collection-count { display:block; margin:8px 0 18px; color:var(--muted); font-size:.72rem; }
  .collection-empty { margin:0; color:var(--muted); font-size:var(--font-body); }
  .contribute-grid { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr); gap:clamp(28px,5vw,72px); align-items:start; }
  .contribute-grid h3 { margin:12px 0 18px; font:400 clamp(1.6rem,3vw,2.5rem)/1.15 var(--font-serif); }
  .channel-recommendation { color:var(--muted); font-size:.72rem; }
  .channel-contribute { padding-right:24px; }
  .contribute-grid .contribution-flow { color:var(--ink); font-size:.85rem; }
  .channel-link { display:inline-block; margin-top:8px; }
  .official-contribute { padding-left:28px; border-left:1px solid var(--line); }
  .official-contribute h3 { margin-top:0; font-size:1.8rem; }
  .contribute-note { margin:26px 0 0; padding-top:18px; border-top:1px solid var(--line); color:var(--muted); font-size:.8rem; }
  @media (max-width:700px) {
    .contribute-grid { grid-template-columns:1fr; gap:26px; }
    .channel-contribute { padding-right:0; }
    .official-contribute { padding:24px 0 0; border-left:0; border-top:1px solid var(--line); }

  }
</style>
