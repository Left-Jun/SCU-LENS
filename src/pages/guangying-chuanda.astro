---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubmissionCodeDialog from "../components/SubmissionCodeDialog.astro";
import GuangyingWorkList from "../components/GuangyingWorkList.astro";
import { collections } from "../lib/guangying-chuanda";
import GalleryImage from "../components/GalleryImage.astro";
import { exhibitions } from "../lib/guangying-exhibitions";
const submissions = collections.find((collection) => collection.id === "submissions")!;
const qrSrc = "/images/guangying-chuanda/submission-code.jpg";
const channelUrl = "https://pd.qq.com/s/g39qgegw0?b=9";
---
<BaseLayout title="光影川大 · SCU LENS" description="光影川大本期征稿、往期展览与投稿入口，记录四川大学的校园影像。" active="/guangying-chuanda">
  <div class="page-shell">
    <section class="page-hero">
      <div class="page-hero-title">
        <div class="eyebrow">Light &amp; Life at SCU</div>
        <h1 class="display">光影川大</h1>
      </div>
    </section>
    <section class="section current-call" aria-labelledby="current-call-title">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Current Call · Campus Photography</div>
          <h2 class="section-display" id="current-call-title">本期征稿</h2>
        </div>
        <p><span class="call-status">常态征集</span></p>
      </div>
      <div class="call-copy">
        <p>欢迎记录川大的风景与日常。作品应与四川大学有关，能辨识出川大场景或相关符号，内容积极、画面美观。</p>
        <p>优秀作品有机会在春季线下展览中展出，或用于川大官方文创制作。</p>
        <a class="text-link" href="#contribute">查看投稿方式 ↓</a>
      </div>
      <div class="current-submissions" id="submissions">
        {submissions.photoCount > 0 ? (
          <>
            <p class="collection-count">本期协会投稿 · {submissions.works.length} 组作品 · {submissions.photoCount} 张照片</p>
            <GuangyingWorkList collection={submissions} priority />
          </>
        ) : <p class="collection-empty">期待你的川大影像。</p>}
      </div>
    </section>
    <section class="section collection-section" id="awards" aria-labelledby="awards-title">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Archive · Earlier Exhibitions</div>
          <h2 class="section-display" id="awards-title">往期展览</h2>
        </div>
        <p>从画册到台历，回看镜头中的川大。</p>
      </div>
      <div class="exhibition-covers">
        {exhibitions.map((exhibition, index) => (
          <a class="exhibition-cover" href={exhibition.href}>
            <div class="cover-image"><GalleryImage photo={exhibition.cover} alt={exhibition.cover.title} sizes="(max-width:700px) calc(100vw - 40px), 580px" priority={index === 0} /></div>
            <div class="cover-caption"><div><h3>{exhibition.title}</h3><p>{exhibition.count} 张照片</p></div><span>进入展览 →</span></div>
          </a>
        ))}
      </div>
    </section>
    <section class="section contribute-section" id="contribute" aria-labelledby="contribute-title">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Contribute · Two Ways to Submit</div>
          <h2 class="section-display" id="contribute-title">投稿入口</h2>
        </div>
      </div>
      <div class="contribute-grid">
        <div class="channel-contribute" aria-labelledby="channel-title">
          <span class="channel-recommendation">推荐 · 协会征集</span>
          <h3 id="channel-title">QQ 频道投稿</h3>
          <p>进入摄影协会 QQ 频道，在「光影川大」栏目发布作品。</p>
          <p class="contribution-flow">频道投稿 → 协会筛选 → 推荐至光影川大</p>
          <a class="text-link channel-link" href={channelUrl} target="_blank" rel="noreferrer">进入 QQ 频道 ↗</a>
        </div>
        <div class="official-contribute" aria-labelledby="official-title">
          <h3 id="official-title">官方投稿</h3>
          <p>使用微信扫描下方小程序码，直接向「光影川大」提交作品。</p>
          <SubmissionCodeDialog src={qrSrc} />
        </div>
      </div>
      <p class="contribute-note">同一作品选择一种方式提交即可，两个入口的投稿不会自动同步。</p>
    </section>
  </div>
</BaseLayout>
<style>
  .exhibition-covers { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:32px; }
  .cover-image { aspect-ratio:3/2; overflow:hidden; }
  .cover-image :global(picture),.cover-image :global(img) { width:100%; height:100%; object-fit:cover; }
  .cover-caption { display:flex; align-items:end; justify-content:space-between; gap:16px; padding-top:16px; }
  .cover-caption h3 { margin:0; font:400 clamp(1.6rem,3vw,2.5rem)/1.25 var(--font-serif); }
  .cover-caption p { margin:8px 0 0; color:var(--muted); font-size:.75rem; }
  .cover-caption > span { font-size:.78rem; white-space:nowrap; }
  .current-call { padding-block:28px; }
  .current-call .section-kicker-row { margin-bottom:16px; }
  .current-call .section-display { font-size:clamp(1.8rem,3vw,2.8rem); }
  .current-call > .section-kicker-row { grid-template-columns:minmax(0,1fr) auto; gap:14px; }
  .call-status { display:inline-block; padding:7px 10px; border:1px solid var(--ink); color:var(--ink); font-size:.72rem; font-weight:700; }
  .call-copy { max-width:780px; }
  .call-copy p,.contribute-grid p { margin:0 0 16px; color:var(--muted); font-size:var(--font-body); line-height:var(--line-body); }
  .call-copy .text-link { display:inline-block; margin-top:8px; }
  .current-submissions { margin-top:26px; }
  .current-submissions,.collection-section,.contribute-section { scroll-margin-top:110px; }
  .collection-count { display:block; margin:8px 0 18px; color:var(--muted); font-size:.72rem; }
  .collection-empty { margin:0; color:var(--muted); font-size:var(--font-body); }
  .contribute-grid { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr); gap:clamp(28px,5vw,72px); align-items:start; }
  .contribute-grid h3 { margin:12px 0 18px; font:400 clamp(1.6rem,3vw,2.5rem)/1.15 var(--font-serif); }
  .channel-recommendation { color:var(--muted); font-size:.72rem; }
  .channel-contribute { padding-right:24px; }
  .contribute-grid .contribution-flow { color:var(--ink); font-size:.85rem; }
  .channel-link { display:inline-block; margin-top:8px; }
  .official-contribute { padding-left:28px; border-left:1px solid var(--line); }
  .official-contribute h3 { margin-top:0; font-size:1.8rem; }
  .contribute-note { margin:26px 0 0; padding-top:18px; border-top:1px solid var(--line); color:var(--muted); font-size:.8rem; }
  @media (max-width:700px) {
    .exhibition-covers { grid-template-columns:1fr; gap:30px; }
    .cover-caption h3 { font-size:1.6rem; }
    .contribute-grid { grid-template-columns:1fr; gap:26px; }
    .channel-contribute { padding-right:0; }
    .official-contribute { padding:24px 0 0; border-left:0; border-top:1px solid var(--line); }
    .current-submissions { margin-top:22px; }
  }
</style>
