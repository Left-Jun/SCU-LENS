---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubmissionCodeDialog from "../components/SubmissionCodeDialog.astro";
import GuangyingWorkList from "../components/GuangyingWorkList.astro";
import { collections } from "../lib/guangying-chuanda";
import GalleryImage from "../components/GalleryImage.astro";
import { themeIssues } from "../lib/guangying-exhibitions";
const submissions = collections.find((collection) => collection.id === "submissions")!;
const qrSrc = "/images/guangying-chuanda/submission-code.jpg";
const channelUrl = "https://pd.qq.com/s/g39qgegw0?b=9";
---
<BaseLayout title="光影川大 · SCU LENS" description="光影川大本期征稿、往期展览与投稿入口，记录四川大学的校园影像。" active="/guangying-chuanda">
  <div class="page-shell">
    <section class="guangying-opening" aria-labelledby="current-call-title">
      <div class="opening-main">
        <div class="opening-brand">
          <h1 class="guangying-heading"><img class="guangying-logo" src="/images/guangying-chuanda/logo.svg" alt="光影川大" width="160" height="193" fetchpriority="high" /></h1>
          <span class="eyebrow">Light &amp; Life at SCU</span>
        </div>
        <div class="opening-copy">
          <div class="opening-kicker"><span class="eyebrow">Current Call · 本期征集</span><span class="call-status">长期开放</span></div>
          <h2 id="current-call-title">记录你眼中的川大。</h2>
          <p>校园里的风景、人物与日常，都值得被镜头留下。光影川大持续征集与四川大学有关的摄影作品。</p>
          <div class="current-actions"><a class="current-submit" href="#contribute">参与本期征集 →</a><a class="text-link" href="#awards">回看往期主题 ↓</a></div>
        </div>
      </div>
      <dl class="call-details">
        <div><dt>01 · 征集内容</dt><dd>能辨识出川大场景或相关符号的校园摄影作品。</dd></div>
        <div><dt>02 · 作品要求</dt><dd>内容积极、画面美观，记录真实的校园生活。</dd></div>
        <div><dt>03 · 展示机会</dt><dd>优秀作品有机会入选线下展览，或用于川大官方文创制作。</dd></div>
      </dl>
      <div class="current-submissions" id="submissions">
        {submissions.photoCount > 0 ? (
          <>
            <p class="collection-count">本期协会投稿 · {submissions.works.length} 组作品 · {submissions.photoCount} 张照片</p>
            <GuangyingWorkList collection={submissions} priority />
          </>
        ) : null}
      </div>
    </section>
    <section class="section collection-section" id="awards" aria-labelledby="awards-title">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Archive · Earlier Exhibitions</div>
          <h2 class="section-display" id="awards-title">往期展览</h2>
        </div>
        <p>按主题回看川大影像，打开每一期，慢慢看。</p>
      </div>
      <div class="theme-issue-list">
        {themeIssues.map((issue, index) => (
          <article class="theme-issue-card">
            <a class="theme-issue-link" href={issue.href}>
              <div class="theme-issue-visual">
                <GalleryImage photo={issue.cover} alt={issue.cover.title || issue.title} sizes="(max-width:700px) calc(100vw - 40px), (max-width:1280px) 46vw, 580px" />
              </div>
              <div class="theme-issue-content">
                <div class="theme-issue-heading"><span class="theme-issue-index">{String(index + 1).padStart(2, "0")}</span><h3>{issue.title}</h3><span class="theme-open" aria-hidden="true">↗</span></div>
                <div class="theme-issue-meta"><span>{issue.en}</span><span>{issue.photos.length} 张照片</span></div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
    <section class="section contribute-section" id="contribute" aria-labelledby="contribute-title">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Contribute · Two Ways to Submit</div>
          <h2 class="section-display" id="contribute-title">投稿入口</h2>
        </div>
      </div>
      <div class="contribute-grid">
        <div class="channel-contribute" aria-labelledby="channel-title">
          <span class="channel-recommendation">推荐 · 协会征集</span>
          <h3 id="channel-title">QQ 频道投稿</h3>
          <p>进入摄影协会 QQ 频道，在「光影川大」栏目发布作品。</p>
          <p class="contribution-flow">频道投稿 → 协会筛选 → 推荐至光影川大</p>
          <a class="text-link channel-link" href={channelUrl} target="_blank" rel="noreferrer">进入 QQ 频道 ↗</a>
        </div>
        <div class="official-contribute" aria-labelledby="official-title">
          <h3 id="official-title">官方投稿</h3>
          <p>使用微信扫描下方小程序码，直接向「光影川大」提交作品。</p>
          <SubmissionCodeDialog src={qrSrc} />
        </div>
      </div>
      <p class="contribute-note">同一作品选择一种方式提交即可，两个入口的投稿不会自动同步。</p>
    </section>
  </div>
</BaseLayout>
<style>
  .guangying-opening { padding:clamp(28px,4vw,52px) 0 30px; }
  .opening-main { display:grid; grid-template-columns:minmax(150px,.65fr) minmax(0,1.35fr); gap:clamp(32px,6vw,88px); align-items:center; }
  .opening-brand { display:flex; flex-direction:column; align-items:flex-start; gap:22px; }
  .guangying-heading { margin:0; line-height:1; }
  .guangying-logo { display:block; width:auto; height:clamp(150px,17vw,220px); max-width:100%; object-fit:contain; }
  .opening-brand .eyebrow { font-size:.65rem; letter-spacing:.12em; }
  .opening-kicker { display:flex; align-items:center; flex-wrap:wrap; gap:14px; }
  .call-status { font-size:.7rem; color:var(--muted); white-space:nowrap; }
  .call-status::before { content:""; display:inline-block; width:5px; height:5px; border-radius:50%; background:var(--ink); margin-right:7px; vertical-align:middle; }
  .opening-copy h2 { margin:20px 0 18px; font:400 clamp(2rem,4vw,3.7rem)/1.2 var(--font-serif); letter-spacing:-.025em; }
  .opening-copy > p { max-width:620px; margin:0 0 26px; font-size:var(--font-body); line-height:var(--line-body); color:var(--muted); }
  .current-actions { display:flex; align-items:center; flex-wrap:wrap; gap:24px; }
  .current-submit { background:var(--ink); color:var(--paper); padding:13px 19px; font-size:.8rem; font-weight:700; }
  .call-details { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:28px; margin:34px 0 0; padding-top:22px; border-top:1px solid var(--line); }
  .call-details dt { margin-bottom:10px; font-size:.73rem; }
  .call-details dd { margin:0; color:var(--muted); font-size:.82rem; line-height:1.8; }
  .current-submissions:not(:empty) { margin-top:26px; }
  .theme-issue-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:36px 30px; }
  .theme-issue-link { display:block; }
  .theme-issue-visual :global(picture),.theme-issue-visual :global(img) { display:block; width:100%; height:auto; }
  .theme-issue-content { padding-top:16px; }
  .theme-issue-heading { display:flex; align-items:center; gap:12px; }
  .theme-issue-index { font-size:.68rem; color:var(--muted); letter-spacing:.08em; }
  .theme-issue-heading h3 { margin:0; font:400 clamp(1.5rem,2.6vw,2.1rem)/1.2 var(--font-serif); }
  .theme-open { margin-left:auto; font-size:1.2rem; transition:transform .2s ease; }
  .theme-issue-link:hover .theme-open { transform:translate(2px,-2px); }
  .theme-issue-meta { display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px; margin-top:10px; font-size:.65rem; letter-spacing:.06em; color:var(--muted); }
  .theme-issue-link:focus-visible { outline:2px solid var(--ink); outline-offset:6px; }
  @media(max-width:700px) {
    .guangying-opening { padding:26px 0; }
    .opening-main { grid-template-columns:1fr; gap:24px; }
    .opening-brand { flex-direction:row; align-items:flex-end; justify-content:space-between; gap:18px; }
    .guangying-logo { height:128px; }
    .opening-brand .eyebrow { max-width:100px; font-size:.57rem; padding-bottom:4px; }
    .opening-copy h2 { margin:16px 0; font-size:clamp(1.8rem,7vw,2.7rem); }
    .opening-copy > p { margin-bottom:22px; }
    .current-actions { gap:20px; }
    .call-details { grid-template-columns:1fr; gap:16px; margin-top:26px; padding-top:20px; }
    .call-details > div { display:grid; grid-template-columns:88px minmax(0,1fr); gap:12px; }
    .call-details dt { margin:0; font-size:.68rem; line-height:1.8; }
    .call-details dd { font-size:.77rem; }
    .theme-issue-list { grid-template-columns:1fr; gap:28px; }
    .theme-issue-content { padding-top:12px; }
  }
  @media(prefers-reduced-motion:reduce) { .theme-open { transition:none; } }
  .current-submissions,.collection-section,.contribute-section { scroll-margin-top:110px; }
  .collection-count { display:block; margin:8px 0 18px; color:var(--muted); font-size:.72rem; }
  .collection-empty { margin:0; color:var(--muted); font-size:var(--font-body); }
  .contribute-grid { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr); gap:clamp(28px,5vw,72px); align-items:start; }
  .contribute-grid h3 { margin:12px 0 18px; font:400 clamp(1.6rem,3vw,2.5rem)/1.15 var(--font-serif); }
  .channel-recommendation { color:var(--muted); font-size:.72rem; }
  .channel-contribute { padding-right:24px; }
  .contribute-grid .contribution-flow { color:var(--ink); font-size:.85rem; }
  .channel-link { display:inline-block; margin-top:8px; }
  .official-contribute { padding-left:28px; border-left:1px solid var(--line); }
  .official-contribute h3 { margin-top:0; font-size:1.8rem; }
  .contribute-note { margin:26px 0 0; padding-top:18px; border-top:1px solid var(--line); color:var(--muted); font-size:.8rem; }
  @media (max-width:700px) {
    .contribute-grid { grid-template-columns:1fr; gap:26px; }
    .channel-contribute { padding-right:0; }
    .official-contribute { padding:24px 0 0; border-left:0; border-top:1px solid var(--line); }

  }
</style>
