---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubmissionCodeDialog from "../components/SubmissionCodeDialog.astro";
import GuangyingWorkList from "../components/GuangyingWorkList.astro";
import { collections } from "../lib/guangying-chuanda";
import GalleryImage from "../components/GalleryImage.astro";
import { themeIssues } from "../lib/guangying-exhibitions";
const submissions = collections.find((collection) => collection.id === "submissions")!;
const qrSrc = "/images/guangying-chuanda/submission-code.jpg";
const channelUrl = "https://pd.qq.com/s/g39qgegw0?b=9";
---
<BaseLayout title="光影川大 · SCU LENS" description="光影川大本期征稿、往期展览与投稿入口，记录四川大学的校园影像。" active="/guangying-chuanda">
  <div class="page-shell">
    <section class="page-hero">
      <div class="page-hero-title">
        <div class="eyebrow">Light &amp; Life at SCU</div>
        <h1 class="display">光影川大</h1>
      </div>
    </section>
    <section class="section current-call" aria-labelledby="current-call-title">
      <div class="current-feature">
        <div class="current-poster">
          <div class="eyebrow">Current Call · 本期征集</div>
          <h2 id="current-call-title">校园影像<br />持续征集</h2>
          <p>风景 · 人物 · 校园日常</p>
          <span class="poster-foot">光影川大 · 与你一起记录校园</span>
        </div>
        <div class="current-copy">
          <span class="call-status">正在征集 · 长期开放</span>
          <h3>记录你眼中的川大。</h3>
          <p>一处熟悉的校园风景，一段鲜活的师生日常，都值得被镜头留下。</p>
          <dl>
            <div><dt>征集内容</dt><dd>与四川大学有关，能辨识出川大场景或相关符号的摄影作品。</dd></div>
            <div><dt>作品要求</dt><dd>内容积极，画面美观，保留真实的校园记忆。</dd></div>
            <div><dt>展示机会</dt><dd>优秀作品有机会入选线下展览，或用于川大官方文创制作。</dd></div>
          </dl>
          <div class="current-actions"><a class="current-submit" href="#contribute">参与本期征集 →</a><a class="text-link" href="#awards">回看往期主题 ↓</a></div>
        </div>
      </div>
      <div class="current-submissions" id="submissions">
        {submissions.photoCount > 0 ? (
          <>
            <p class="collection-count">本期协会投稿 · {submissions.works.length} 组作品 · {submissions.photoCount} 张照片</p>
            <GuangyingWorkList collection={submissions} priority />
          </>
        ) : null}
      </div>
    </section>
    <section class="section collection-section" id="awards" aria-labelledby="awards-title">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Archive · Earlier Exhibitions</div>
          <h2 class="section-display" id="awards-title">往期展览</h2>
        </div>
        <p>按主题回看川大影像，打开每一期，慢慢看。</p>
      </div>
      <div class="theme-issue-list">
        {themeIssues.map((issue, index) => (
          <article class="theme-issue-card">
            <span class="theme-issue-index">{String(index + 1).padStart(2, "0")}</span>
            <a class="theme-issue-visual" href={issue.href}>
              <GalleryImage photo={issue.cover} alt={issue.cover.title} sizes="(max-width:700px) calc(100vw - 40px), 1180px" priority={index === 0} />
              <div class="theme-issue-overlay"></div>
              <div class="theme-issue-content">
                <div class="theme-issue-meta"><span>{issue.source}</span><span>{issue.photos.length} 张照片</span></div>
                <div><p>{issue.en}</p><h3>{issue.title}</h3><span class="theme-open">查看本期 →</span></div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
    <section class="section contribute-section" id="contribute" aria-labelledby="contribute-title">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Contribute · Two Ways to Submit</div>
          <h2 class="section-display" id="contribute-title">投稿入口</h2>
        </div>
      </div>
      <div class="contribute-grid">
        <div class="channel-contribute" aria-labelledby="channel-title">
          <span class="channel-recommendation">推荐 · 协会征集</span>
          <h3 id="channel-title">QQ 频道投稿</h3>
          <p>进入摄影协会 QQ 频道，在「光影川大」栏目发布作品。</p>
          <p class="contribution-flow">频道投稿 → 协会筛选 → 推荐至光影川大</p>
          <a class="text-link channel-link" href={channelUrl} target="_blank" rel="noreferrer">进入 QQ 频道 ↗</a>
        </div>
        <div class="official-contribute" aria-labelledby="official-title">
          <h3 id="official-title">官方投稿</h3>
          <p>使用微信扫描下方小程序码，直接向「光影川大」提交作品。</p>
          <SubmissionCodeDialog src={qrSrc} />
        </div>
      </div>
      <p class="contribute-note">同一作品选择一种方式提交即可，两个入口的投稿不会自动同步。</p>
    </section>
  </div>
</BaseLayout>
<style>
  .current-feature { display:grid; grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); gap:clamp(28px,5vw,64px); align-items:stretch; }
  .current-poster { display:flex; flex-direction:column; justify-content:space-between; min-height:420px; padding:30px; background:#e5e2d6; }
  .current-poster h2 { margin:34px 0 20px; font:400 clamp(3rem,5vw,5rem)/1.12 var(--font-serif); letter-spacing:-.025em; }
  .current-poster > p { margin:0 0 40px; font-size:.82rem; color:var(--muted); }
  .poster-foot { padding-top:18px; border-top:1px solid var(--line); font-size:.7rem; color:var(--muted); }
  .current-copy { padding:4px 0; display:flex; flex-direction:column; align-items:flex-start; }
  .current-copy h3 { margin:24px 0 16px; font:400 clamp(1.8rem,3vw,3rem)/1.25 var(--font-serif); }
  .current-copy > p { margin:0 0 24px; color:var(--muted); font-size:var(--font-body); }
  .current-copy dl { margin:0 0 28px; width:100%; }
  .current-copy dl > div { display:grid; grid-template-columns:76px minmax(0,1fr); gap:16px; padding:13px 0; border-top:1px solid var(--line); }
  .current-copy dt { font-size:.78rem; }
  .current-copy dd { margin:0; color:var(--muted); font-size:.85rem; }
  .current-actions { display:flex; align-items:center; flex-wrap:wrap; gap:20px; margin-top:auto; }
  .current-submit { background:var(--ink); color:var(--paper); padding:14px 20px; font-size:.82rem; font-weight:700; }
  @media(max-width:700px) { .current-feature { grid-template-columns:1fr; gap:26px; } .current-poster { min-height:0; padding:24px; } .current-poster h2 { margin:30px 0 18px; font-size:3.5rem; } .current-poster > p { margin-bottom:28px; } .current-copy h3 { margin-top:20px; } }

  .theme-issue-list { display:grid; gap:32px; }
  .theme-issue-card { display:grid; grid-template-columns:42px minmax(0,1fr); gap:14px; }
  .theme-issue-index { padding-top:10px; font-size:.72rem; color:var(--muted); letter-spacing:.12em; }
  .theme-issue-visual { position:relative; display:block; aspect-ratio:16/7; color:white; overflow:hidden; }
  .theme-issue-visual :global(picture),.theme-issue-visual :global(img) { width:100%; height:100%; object-fit:cover; }
  .theme-issue-overlay { position:absolute; inset:0; background:linear-gradient(90deg,rgba(13,13,11,.70),rgba(13,13,11,.08)),linear-gradient(180deg,rgba(0,0,0,.10),rgba(0,0,0,.36)); }
  .theme-issue-content { position:absolute; inset:0; padding:22px 24px; display:flex; flex-direction:column; justify-content:space-between; }
  .theme-issue-meta { display:flex; justify-content:space-between; gap:16px; font-size:.68rem; color:rgba(255,255,255,.8); }
  .theme-issue-content p { margin:0 0 8px; font-size:.66rem; letter-spacing:.16em; opacity:.75; }
  .theme-issue-content h3 { margin:0 0 18px; font:400 clamp(2.35rem,4.2vw,4.2rem)/1.05 var(--font-serif); }
  .theme-open { font-size:.78rem; font-weight:700; border-bottom:1px solid currentColor; padding-bottom:4px; }
  .theme-issue-visual:focus-visible { outline:2px solid var(--ink); outline-offset:4px; }
  @media(max-width:700px) { .theme-issue-card { grid-template-columns:1fr; gap:8px; } .theme-issue-index { padding:0; } .theme-issue-visual { aspect-ratio:4/3; } .theme-issue-content { padding:18px; } }

  .current-call { padding-block:28px; }
  .current-call .section-kicker-row { margin-bottom:16px; }
  .current-call .section-display { font-size:clamp(1.8rem,3vw,2.8rem); }
  .current-call > .section-kicker-row { grid-template-columns:minmax(0,1fr) auto; gap:14px; }
  .call-status { display:inline-block; padding:7px 10px; border:1px solid var(--ink); color:var(--ink); font-size:.72rem; font-weight:700; }
  .call-copy { max-width:780px; }
  .call-copy p,.contribute-grid p { margin:0 0 16px; color:var(--muted); font-size:var(--font-body); line-height:var(--line-body); }
  .call-copy .text-link { display:inline-block; margin-top:8px; }
  .current-submissions { margin-top:26px; }
  .current-submissions,.collection-section,.contribute-section { scroll-margin-top:110px; }
  .collection-count { display:block; margin:8px 0 18px; color:var(--muted); font-size:.72rem; }
  .collection-empty { margin:0; color:var(--muted); font-size:var(--font-body); }
  .contribute-grid { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr); gap:clamp(28px,5vw,72px); align-items:start; }
  .contribute-grid h3 { margin:12px 0 18px; font:400 clamp(1.6rem,3vw,2.5rem)/1.15 var(--font-serif); }
  .channel-recommendation { color:var(--muted); font-size:.72rem; }
  .channel-contribute { padding-right:24px; }
  .contribute-grid .contribution-flow { color:var(--ink); font-size:.85rem; }
  .channel-link { display:inline-block; margin-top:8px; }
  .official-contribute { padding-left:28px; border-left:1px solid var(--line); }
  .official-contribute h3 { margin-top:0; font-size:1.8rem; }
  .contribute-note { margin:26px 0 0; padding-top:18px; border-top:1px solid var(--line); color:var(--muted); font-size:.8rem; }
  @media (max-width:700px) {
    .contribute-grid { grid-template-columns:1fr; gap:26px; }
    .channel-contribute { padding-right:0; }
    .official-contribute { padding:24px 0 0; border-left:0; border-top:1px solid var(--line); }
    .current-submissions { margin-top:22px; }
  }
</style>
