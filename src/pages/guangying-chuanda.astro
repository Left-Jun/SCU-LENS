---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubmissionCodeDialog from "../components/SubmissionCodeDialog.astro";
import GuangyingFeaturedStrip from "../components/GuangyingFeaturedStrip.astro";
import { featuredPhotos, featuredPreview } from "../lib/guangying-featured";

import { exhibitions, guangyingPhoto } from "../lib/guangying-exhibitions";
const openingPhoto = guangyingPhoto("7207c5023eaf61d6bd2b");
const openingPhotos = [openingPhoto, ...featuredPhotos.filter(photo => photo.id !== openingPhoto.id)];
const calendar = exhibitions.find(exhibition => exhibition.slug === "calendar")!;
const calendarPhotos = calendar.sections.flatMap(section => section.photos);
const qrSrc = "/images/guangying-chuanda/submission-code.jpg";
const channelUrl = "https://pd.qq.com/s/g39qgegw0?b=9";
---
<BaseLayout title="光影川大 · SCU LENS" description="光影川大联合征稿与投稿入口，记录四川大学的校园影像。" active="/guangying-chuanda">
  <div class="page-shell">
    <section class="guangying-opening" aria-labelledby="current-call-title">
      <div class="opening-main">
        <div class="opening-brand">
          <h1 class="guangying-heading"><img class="guangying-logo" src="/images/guangying-chuanda/logo.svg" alt="光影川大" width="160" height="193" fetchpriority="high" /></h1>
          <span class="eyebrow">联合征稿</span>
        </div>
        <div class="opening-copy">
          <div class="opening-kicker"><span class="eyebrow">Current Call · 本期征集</span><span class="call-status">长期开放</span></div>
          <h2 id="current-call-title">看见川大，<br />留住此刻。</h2>
          <p>光穿过校园，也经过我们的日常。<br />持续征集校园影像，留下你眼中的川大。</p>
          <div class="current-actions"><a class="current-submit" href="#contribute">参与本期征集 →</a><a class="text-link" href="#awards">看看往期影像 ↓</a></div>
        </div>
        <div class="opening-photograph"><GuangyingFeaturedStrip photos={openingPhotos} compact groupId="guangying-opening" /></div>
      </div>
    </section>
    <section class="section featured-section" id="awards" aria-labelledby="awards-title">
      <div class="section-kicker-row">
        <div><div class="eyebrow">Selected Photographs</div><h2 class="section-display" id="awards-title">往期影像</h2></div>
        <p>看看镜头里的川大，也欢迎投来你的作品。</p>
      </div>
      <GuangyingFeaturedStrip photos={featuredPhotos} preview={featuredPreview} />
    </section>
    <section class="section calendar-section" id="calendar" aria-labelledby="calendar-title">
      <div class="calendar-intro"><div class="eyebrow">Calendar Collection</div><h2 class="section-display" id="calendar-title">台历选图</h2><p class="calendar-statement">川大，<br />四时入历。</p><p>让校园里的光景，<br />陪伴日常的每一页。</p></div>
      <GuangyingFeaturedStrip photos={calendarPhotos.slice(0,6)} groupId="guangying-calendar-preview" allHref="/guangying-chuanda/calendar" />
    </section>
    <section class="section contribute-section" id="contribute" aria-labelledby="contribute-title">
      <span id="submissions" class="submission-anchor" aria-hidden="true"></span>
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Open Call</div>
          <h2 class="section-display" id="contribute-title">投来你的<br class="desktop-break" />川大影像。</h2><p class="contribute-intro">长期征集 · 选择一种方式投稿即可</p>
        </div>
      </div>
      <details class="call-notes">
        <summary>本期征集说明<span>长期开放 · 查看作品要求与展示机会 <i class="call-note-toggle" aria-hidden="true"></i></span></summary>
        <dl class="call-details">
          <div><dt>征集内容</dt><dd>与四川大学有关，能辨识出川大场景或相关符号的校园摄影作品。</dd></div>
          <div><dt>作品要求</dt><dd>内容积极、画面美观，记录真实的校园生活。</dd></div>
          <div><dt>展示机会</dt><dd>优秀作品有机会入选线下展览，或用于川大官方文创制作。</dd></div>
        </dl>
      </details>
      <div class="contribute-grid">
        <div class="channel-contribute" aria-labelledby="channel-title">
          <span class="channel-recommendation">协会合作征集</span>
          <h3 id="channel-title">QQ 频道投稿</h3>
          <p>进入摄影协会 QQ 频道，在「光影川大」栏目发布作品。</p>
          <p class="contribution-flow">频道投稿 → 协会筛选 → 推荐至光影川大</p>
          <a class="text-link channel-link" href={channelUrl} target="_blank" rel="noreferrer">进入 QQ 频道 ↗</a>
        </div>
        <div class="official-contribute" aria-labelledby="official-title">
          <h3 id="official-title">官方投稿</h3>
          <p>使用微信扫描下方小程序码，直接向「光影川大」提交作品。</p>
          <SubmissionCodeDialog src={qrSrc} />
        </div>
      </div>
      <p class="contribute-note">同一作品选择一种方式提交即可，两个入口的投稿不会自动同步。</p>
    </section>
  </div>
</BaseLayout>
<style>
  :global(body:has(.featured-section)){min-width:0}
  .guangying-opening{padding:40px 0 48px}
  .opening-main{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.5fr);grid-template-rows:auto 1fr;gap:26px clamp(28px,5vw,70px);align-items:start}
  .opening-brand{display:flex;align-items:flex-end;gap:20px;grid-column:1;grid-row:1}
  .guangying-heading{margin:0;line-height:1}.guangying-logo{display:block;width:auto;height:88px;max-width:100%}
  .opening-brand .eyebrow{padding-bottom:3px;font-size:11px;letter-spacing:.05em;line-height:1.6}
  .opening-copy{grid-column:1;grid-row:2;align-self:end;padding-bottom:18px}
  .opening-kicker{display:flex;align-items:center;flex-wrap:wrap;gap:12px}.opening-kicker .eyebrow{font-size:10px;letter-spacing:.08em}.call-status{font-size:11px;color:var(--muted)}
  .opening-copy h2{margin:18px 0 22px;font:400 clamp(2rem,3.8vw,3.5rem)/1.22 var(--font-serif);letter-spacing:-.035em}
  .opening-copy>p{margin:0 0 24px;color:var(--muted);font-size:13px;line-height:1.95}
  .current-actions{display:flex;flex-wrap:wrap;gap:12px 22px}.current-actions a{display:inline-flex;align-items:center;min-height:44px;font-size:12px;padding-block:8px;border-bottom:1px solid var(--ink)}.current-submit{font-weight:700}.current-actions .text-link{font-weight:400;color:var(--muted);border-color:var(--line)}
  .opening-photograph{grid-column:2;grid-row:1/span 2;min-width:0}
  .section{padding-block:48px}
  .section-display{font:400 clamp(32px,4vw,54px)/1.15 var(--font-serif);letter-spacing:-.035em;margin:10px 0 0}
  .section-kicker-row{grid-template-columns:minmax(0,1fr) minmax(0,.75fr);gap:24px;margin-bottom:28px;align-items:end}.section-kicker-row>p{font-size:13px;line-height:1.8;max-width:290px;justify-self:end}
  .featured-section,.calendar-section,.contribute-section,.submission-anchor{scroll-margin-top:110px}
  .calendar-section{position:relative;isolation:isolate;display:grid;grid-template-columns:minmax(0,.65fr) minmax(0,1.35fr);gap:clamp(32px,5vw,72px);align-items:center;padding-block:48px}
  .calendar-section::before{content:"";position:absolute;inset:0;background:rgba(115,95,61,.035);z-index:-1;pointer-events:none}
  .calendar-intro .section-display{font-size:30px}.calendar-statement{font:400 clamp(36px,4vw,54px)/1.25 var(--font-serif);letter-spacing:-.035em;margin:28px 0 24px;color:var(--ink)!important}
  .calendar-intro>p:not(.calendar-statement){font-size:13px;line-height:1.9;color:var(--muted);margin:0}
  .contribute-section{position:relative;display:grid;grid-template-columns:minmax(0,.65fr) minmax(0,1.35fr);column-gap:clamp(32px,5vw,72px);row-gap:22px}
  .contribute-section>.section-kicker-row{display:block;grid-column:1;grid-row:1/span 3;margin:0}.contribute-section .section-display{font-size:clamp(32px,3.3vw,44px);line-height:1.3}.contribute-intro{font-size:12px;line-height:1.8;color:var(--muted);margin:20px 0 0}
  .call-notes,.contribute-grid,.contribute-note{grid-column:2;min-width:0}
  .call-notes{margin:0;border-bottom:1px solid var(--line)}.call-notes summary{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:44px;padding:0 0 16px;cursor:pointer;list-style:none;font-size:13px}.call-notes summary::-webkit-details-marker{display:none}.call-notes summary span{font-size:11px;color:var(--muted)}
  .call-note-toggle{font-style:normal}.call-note-toggle::before{content:"＋"}.call-notes[open] .call-note-toggle::before{content:"−"}
  .call-details{display:grid;grid-template-columns:1fr;gap:14px;margin:0 0 20px}.call-details>div{display:grid;grid-template-columns:64px minmax(0,1fr);gap:14px}.call-details dt{font-size:12px}.call-details dd{margin:0;font-size:12px;line-height:1.8;color:var(--muted)}
  .contribute-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:28px;align-items:start}.contribute-grid h3{font:400 24px/1.3 var(--font-serif);margin:8px 0 16px}.channel-recommendation{display:block;font-size:11px;color:var(--muted);margin-bottom:8px}.contribute-grid p{font-size:13px;color:var(--muted);line-height:1.85;margin:0 0 16px}.contribute-grid .contribution-flow{font-size:11px;color:var(--ink)}
  .contribute-grid a{display:inline-flex;align-items:center;min-height:44px;font-size:13px}.official-contribute{border-left:1px solid var(--line);padding-left:28px}.official-contribute h3{margin-top:27px}
  .contribute-note{margin:0;padding-top:18px;border-top:1px solid var(--line);font-size:11px;line-height:1.8;color:var(--muted)}
  .submission-anchor{position:absolute;top:0;left:0}
  summary:focus-visible{outline:2px solid var(--ink);outline-offset:4px}
  @media(min-width:1100px){.guangying-logo{height:160px}}
  @media(min-width:701px) and (max-width:1000px){.contribute-section{grid-template-columns:1fr;gap:24px}.contribute-section>.section-kicker-row{grid-row:auto;grid-column:1}.contribute-section .section-display br{display:none}.call-notes,.contribute-grid,.contribute-note{grid-column:1}.contribute-intro{margin-top:12px}}
  @media(max-width:700px){
    .guangying-opening{padding:28px 0 32px}.opening-main{grid-template-columns:72px minmax(0,1fr);grid-template-rows:auto;gap:10px 18px}.opening-brand,.opening-copy{display:contents}.guangying-heading{grid-column:1;grid-row:1/span 2;align-self:center}.opening-brand .eyebrow{grid-column:2;grid-row:1;align-self:end;padding:0}.opening-copy h2{grid-column:2;grid-row:2;margin:0;font-size:clamp(25px,7.3vw,34px);line-height:1.2}
    .opening-photograph{grid-column:1/-1;grid-row:3;margin-top:10px}.opening-kicker{grid-column:1/-1;grid-row:4;margin-top:2px}.opening-copy>p{grid-column:1/-1;grid-row:5;margin:0;font-size:13px;line-height:1.85}.current-actions{grid-column:1/-1;grid-row:6;gap:20px;margin-top:4px}
    .section{padding-block:32px}.section-display{font-size:32px}.section-kicker-row{grid-template-columns:1fr;gap:12px;margin-bottom:22px}.section-kicker-row>p{justify-self:start;max-width:none;font-size:12px}
    .calendar-section{grid-template-columns:1fr;gap:22px}.calendar-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px 20px;align-items:end}.calendar-intro>.eyebrow{grid-column:1/-1}.calendar-intro .section-display{grid-column:1;grid-row:2;font-size:30px;margin:4px 0 0}.calendar-intro .calendar-statement{display:none}.calendar-intro>p:not(.calendar-statement){grid-column:2;grid-row:2;font-size:11px;line-height:1.8}
    .contribute-section{grid-template-columns:1fr;gap:22px}.contribute-section>.section-kicker-row{grid-column:1;grid-row:auto}.contribute-section .section-display{font-size:32px}.desktop-break{display:none}.contribute-intro{margin-top:12px}.call-notes,.contribute-grid,.contribute-note{grid-column:1}.call-notes summary{flex-wrap:wrap}.call-details>div{gap:10px}
    .contribute-grid{grid-template-columns:1fr;gap:22px}.contribute-grid h3{font-size:24px}.official-contribute{padding:22px 0 0;border-left:0;border-top:1px solid var(--line);display:grid;grid-template-columns:minmax(0,1fr) 132px;column-gap:16px;align-content:start}.official-contribute h3{margin:0 0 12px;grid-column:1}.official-contribute>p{grid-column:1;font-size:12px;margin:0}.official-contribute :global(.submission-code){grid-column:2;grid-row:1/span 2;margin:0}.official-contribute :global(.submission-code figcaption){font-size:10px}.contribute-note{padding-top:16px}
  }
</style>
