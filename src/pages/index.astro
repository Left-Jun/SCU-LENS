---
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredWorks = [
  { title:"校园", en:"CAMPUS", source:"每月九图 · 江安青绿篇", author:"宫保鸡丁", image:"/images/monthly-nine/2026-jiang-an-green/gongbao/lotus-wind-1800.jpg", href:"/gallery/campus" },
  { title:"人文", en:"HUMANITY", source:"每月九图 · 新春篇", author:"Left-俊", image:"/images/monthly-nine/2026-spring-festival/left-jun/new-year-1800.jpg", href:"/gallery/humanity" },
  { title:"城市", en:"URBAN", source:"每月九图 · 新春篇", author:"Azp", image:"/images/monthly-nine/2026-spring-festival/azp/tokyo-dream-1800.jpg", href:"/gallery/urban" },
  { title:"自然", en:"NATURE", source:"每月九图 · 繁花篇", author:"一尾", image:"/images/monthly-nine/2026-blossom/yiwei/spring-blossom-1800.jpg", href:"/gallery/nature" },
  { title:"人像", en:"PORTRAIT", source:"每月九图 · 新春篇", author:"Left-俊", image:"/images/monthly-nine/2026-spring-festival/left-jun/new-year-1800.jpg", href:"/gallery/portrait" },
  { title:"动物", en:"ANIMALS", source:"每月九图 · 江安青绿篇", author:"宫保鸡丁", image:"/images/monthly-nine/2026-jiang-an-green/gongbao/lotus-wind-1800.jpg", href:"/gallery/animals" },
];

// 首页活动区是“当前状态入口”，不是长期/近期分类卡。
// 左卡默认展示最近发生/即将发生的具体活动；若某期每月九图刚公布结果，
// 可短期切换为结果卡并直接链接到该期图集。
// 右卡固定展示“当前每月九图状态”；只有进入征集期时才出现独立投稿快捷入口。
const eventCards = [
  {
    kind:"upcoming",
    kicker:"UPCOMING · 近期",
    title:"百团大战与新一轮招新",
    meta:"2026 · 10 月中旬",
    desc:"线下社团展示与新一轮集中招募将陆续展开，具体日期、摊位与现场安排以当期通知为准。",
    href:"/events#upcoming"
  },
  {
    kind:"monthly",
    kicker:"MONTHLY NINE · 当前状态",
    title:"新一轮主题正在准备中",
    meta:"等待下一期主题",
    desc:"上一期「江安青绿」已完成归档。下一轮主题公布后，这里会同步切换为征集状态。",
    href:"/events#monthly-nine-status",
    submitHref:null
  },
];

const monthlyTiles = [
  { month:"2026.05—07", title:"江安青绿", href:"/monthly-nine/2026-jiang-an-green", image:"/images/monthly-nine/2026-jiang-an-green/gongbao/lotus-wind-960.jpg" },
  { month:"2026.03", title:"繁花", href:"/monthly-nine/2026-blossom", image:"/images/monthly-nine/2026-blossom/yiwei/spring-blossom-960.jpg" },
  { month:"2026.01", title:"新春", href:"/monthly-nine/2026-spring-festival", image:"/images/monthly-nine/2026-spring-festival/left-jun/new-year-960.jpg" },
  { month:"2025.12", title:"黄色", href:"/monthly-nine/2025-yellow", image:"/images/monthly-nine/2025-yellow/sanchuan/09-960.jpg" },
];
---
<BaseLayout active="/">
  <div class="page-shell">
    <section class="hero">
      <div class="hero-brand-block">
        <div class="eyebrow">Sichuan University Photography Association</div>
        <h1 class="display">SCU<br/>LENS</h1>
        <div class="hero-index">Chengdu · Student Photography Community</div>
      </div>
      <div class="hero-copy">
        <img class="hero-logo-image" src="/images/scu-photo-logo-paper.png" alt="四川大学摄影协会 SCU LENS" />
      </div>
      <p class="hero-mobile-description">四川大学摄影协会的线上影像空间。作品从频道发生，在这里被整理、被看见、被长期保存。</p>
    </section>

    <section class="section monthly-preview">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Monthly Nine</div>
          <h2 class="section-display">每月九图</h2>
        </div>
        <a class="text-link" href="/monthly-nine">查看历期 <span>↗</span></a>
      </div>
      <div class="monthly-layout">
        <div class="issue-copy">
          <div class="issue-number">04 <span>/ ISSUES</span></div>
          <p>从冬日的黄色，到新春、繁花与盛夏江安的青绿。四期主题沿时间排列，留下不同季节里的校园光影。</p>
          <div class="issue-meta"><span>2025.12—2026.07</span><span>SCU LENS</span></div>
        </div>
        <div class="monthly-four-grid" aria-label="每月九图历期预览">
          {monthlyTiles.map((item) => (
            <a class="monthly-four-tile" href={item.href} aria-label={`查看 ${item.month} ${item.title}`}>
              <img src={item.image} alt="" loading="lazy" decoding="async" />
              <span class="monthly-four-shade"></span>
              <div><small>{item.month}</small><strong>{item.title}</strong></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section works-channel-section">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Selected Works</div>
          <h2 class="section-display">作品</h2>
        </div>
        <a class="text-link" href="/gallery">进入作品库 <span>↗</span></a>
      </div>
      <div class="works-preview">
        {featuredWorks.map((work) => (
          <article class="work-preview-item">
            <a class="work-card" href={work.href}>
              <div class="work-tile">
                <img src={work.image} alt="" loading="lazy" decoding="async" />
                <span class="work-tile-shade"></span>
                <div class="work-tile-meta">
                  <span>{work.source}</span>
                  <b>{work.author} 摄</b>
                </div>
              </div>
              <div class="work-category-panel">
                <span class="work-category-index">CATEGORY</span>
                <div class="work-category-name">
                  <strong>{work.title}</strong>
                  <span>{work.en}</span>
                </div>
                <span class="work-category-enter">进入分类 →</span>
              </div>
            </a>
          </article>
        ))}
      </div>
      <div class="works-source-note">
        <span>作品来自摄影协会 QQ 频道与「每月九图」等影像征集。</span>
        <a href="/submit">进入投稿专区 →</a>
      </div>
    </section>

    <section class="section">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Events & Field Notes</div>
          <h2 class="section-display">活动</h2>
        </div>
        <a class="text-link" href="/events">查看活动档案 <span>↗</span></a>
      </div>
      <div class="event-preview-grid">
        {eventCards.map((item) => (
          <article class:list={["event-preview-card","event-preview-" + item.kind]}>
            <a class="event-preview-main" href={item.href}>
              <span>{item.kicker}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
              <b>{item.meta} <i>↗</i></b>
            </a>
            {item.submitHref && (
              <a class="event-preview-submit" href={item.submitHref}>前往投稿 ↗</a>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="section home-links">
      <a class="home-link-row" href="/join">
        <span class="eyebrow">Join Us</span>
        <h2>加入我们</h2>
        <p>了解部门、加入方式与申请入口。</p>
        <b>查看加入方式 ↗</b>
      </a>
      <a class="home-link-row" href="/about#links">
        <span class="eyebrow">Links & Friends</span>
        <h2>联系与联动</h2>
        <p>QQ 频道、合作联系与外部入口。</p>
        <b>查看联系入口 ↗</b>
      </a>
    </section>

    <section class="section manifesto">
      <div class="eyebrow">Our point of view</div>
      <div>
        <blockquote>不是把每一刻都拍下来，<br/>而是知道<em>为什么按下快门。</em></blockquote>
      </div>
    </section>
  </div>
</BaseLayout>
