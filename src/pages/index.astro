---
import BaseLayout from "../layouts/BaseLayout.astro";

const channelCards = [
  { type: "相机组投稿", title: "城市与校园", note: "来自频道 · Camera", visual: "visual-city" },
  { type: "手机组投稿", title: "日常片段", note: "来自频道 · Mobile", visual: "visual-flower" },
  { type: "胶片组投稿", title: "胶片与时间", note: "来自频道 · Film", visual: "visual-film" },
];

const eventCards = [
  { date: "SEP · 2026", title: "新学年 · 摄协重新出发", tag: "本学期" },
  { date: "ARCHIVE", title: "讲座、外拍与共同经历", tag: "活动档案" },
];
---
<BaseLayout active="/">
  <div class="page-shell">
    <section class="hero">
      <div>
        <div class="eyebrow">Sichuan University Photography Association</div>
        <h1 class="display">SCU<br/>LENS</h1>
        <div class="hero-index">Chengdu · Student Photography Community</div>
      </div>
      <div class="hero-copy">
        <div class="feature-card">
          <span class="num">2026 / VISUAL ARCHIVE</span>
          <div>
            <h2>把光留下来。</h2>
            <p>四川大学摄影协会的线上影像空间。作品从频道发生，在这里被整理、被看见、被长期保存。</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section monthly-preview">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Monthly Nine</div>
          <h2 class="section-display">每月九图</h2>
        </div>
        <a class="text-link" href="/monthly-nine">查看历期 <span>↗</span></a>
      </div>
      <div class="monthly-layout">
        <div class="issue-copy">
          <div class="issue-number">05 <span>/ 2026</span></div>
          <p>频道里的历期记录正在逐步整理。当前已同步“黄色 / 新春 / 繁花 / 春 / 江安青绿”等主题，其中黄色、新春、繁花与江安青绿的入选照片已完成归档。</p>
          <div class="issue-meta"><span>9 PHOTOGRAPHS</span><span>1 MONTH</span><span>SCU</span></div>
        </div>
        <a class="nine-grid" href="/monthly-nine" aria-label="查看本期每月九图">
          {Array.from({ length: 9 }).map((_, i) => <span class={"nine-tile tone-" + (i + 1)}><b>{String(i + 1).padStart(2,"0")}</b></span>)}
        </a>
      </div>
    </section>

    <section class="section">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Selected Works</div>
          <h2 class="section-display">作品</h2>
        </div>
        <a class="text-link" href="/gallery">进入作品库 <span>↗</span></a>
      </div>
      <div class="works-preview">
        <a class="work-tile work-wide visual-campus" href="/gallery"><span class="work-label">校园 / CAMPUS</span></a>
        <a class="work-tile work-tall visual-portrait" href="/gallery"><span class="work-label">人像 / PORTRAIT</span></a>
        <a class="work-tile visual-documentary" href="/gallery"><span class="work-label">纪实 / DOCUMENTARY</span></a>
        <a class="work-tile visual-night" href="/gallery"><span class="work-label">城市 / CITY</span></a>
      </div>
    </section>

    <section class="section channel-section">
      <div class="section-title">
        <div>
          <div class="eyebrow">From the Channel</div>
          <h2>频道投稿</h2>
        </div>
        <p>相机、手机与胶片投稿主要发生在摄协 QQ 频道。官网负责将其中值得长期保存的照片重新整理成作品与专题。</p>
      </div>
      <div class="channel-grid">
        {channelCards.map((card) => (
          <article class="channel-card">
            <div class={"channel-visual " + card.visual}></div>
            <div class="channel-card-body">
              <span>{card.type}</span>
              <h3>{card.title}</h3>
              <p>{card.note}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="channel-note">
        <span>投稿入口仍在 QQ 频道</span>
        <a href="/about#channel">查看频道与网站如何联动 →</a>
      </div>
    </section>

    <section class="section">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Events & Field Notes</div>
          <h2 class="section-display">活动</h2>
        </div>
        <a class="text-link" href="/events">查看活动档案 <span>↗</span></a>
      </div>
      <div class="event-preview-grid">
        {eventCards.map((item, i) => (
          <a class={"event-preview-card event-tone-" + (i + 1)} href="/events">
            <span>{item.date}</span>
            <h3>{item.title}</h3>
            <b>{item.tag}</b>
          </a>
        ))}
      </div>
    </section>

    <section class="section split-cta">
      <a class="cta-panel cta-dark" href="/join">
        <span class="eyebrow">Join Us</span>
        <h2>加入我们</h2>
        <p>把招新、简历投递与后续联系放在一个长期有效的入口里。</p>
        <b>查看加入方式 ↗</b>
      </a>
      <a class="cta-panel" href="/about#links">
        <span class="eyebrow">Links & Friends</span>
        <h2>联系与联动</h2>
        <p>QQ 频道、友好影像账号与合作组织，在这里形成稳定的外部入口。</p>
        <b>查看联系入口 ↗</b>
      </a>
    </section>

    <section class="section manifesto">
      <div class="eyebrow">Our point of view</div>
      <div>
        <blockquote>不是把每一刻都拍下来，<br/>而是知道<em>为什么按下快门。</em></blockquote>
      </div>
    </section>
  </div>
</BaseLayout>
