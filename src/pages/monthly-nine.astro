---
import BaseLayout from "../layouts/BaseLayout.astro";

const channelUrl = "https://pd.qq.com/s/g39qgegw0?b=9";

const latestIssue = {
  href: "/monthly-nine/2026-jiang-an-green",
  date: "2026.05—07",
  title: "江安青绿",
  en: "JIANG'AN GREEN",
  state: "closed",
  status: "已完成 · 结果已公布",
  deadline: "结果公布 · 2026.07.03",
  count: "3 组入选作品",
  cover: "/images/monthly-nine/2026-jiang-an-green/gongbao/lotus-wind-1800.jpg",
  statement: [
    "盛夏漫染江安，青绿铺展满园。荷塘、萍叶、草木与水面共同构成一段属于江安夏日的青绿记录。我们希望这一期不只是寻找一种颜色，而是从校园里寻找那些被盛夏包围的呼吸感：风经过荷叶留下的起伏，水边植物彼此交叠的层次，以及人在青绿之间偶然出现的尺度。",
    "本期征集现已结束，并于 2026 年 7 月 3 日公布结果。入选作品为 Sebastian《浮鸭戏芳华》、宫保鸡丁《荷风满塘》与冬淋《清新脱俗小雏菊》。三组作品原图现已完成归档，可进入本期页面连续浏览。",
  ],
};

const issues = [
  {
    href: "/monthly-nine/2025-yellow",
    date: "2025.01",
    title: "黄色",
    en: "YELLOW",
    status: "已评选",
    summary: "黄色是光，是温度，是苏醒，也是沉淀。它可以是街角一盏暖灯，是季节更迭时的一抹秋意，也可以是某个瞬间落入镜中的情绪与故事。",
    count: "3 组入选作品",
    tone: 5,
    preview: [
      {
        browserSrc: "/images/monthly-nine/2025-yellow/sebastian/sebastian-960.jpg",
        browserSrcset: "/images/monthly-nine/2025-yellow/sebastian/sebastian-960.jpg 960w, /images/monthly-nine/2025-yellow/sebastian/sebastian-1800.jpg 1800w",
        originalSrc: "/images/monthly-nine/2025-yellow/sebastian/sebastian-original.jpg",
        alt: "《金黄芒节》· Sebastian",
        width: 3840,
        height: 5760,
      },
      {
        browserSrc: "/images/monthly-nine/2025-yellow/yiwei/yiwei-960.jpg",
        browserSrcset: "/images/monthly-nine/2025-yellow/yiwei/yiwei-960.jpg 960w, /images/monthly-nine/2025-yellow/yiwei/yiwei-1800.jpg 1191w",
        originalSrc: "/images/monthly-nine/2025-yellow/yiwei/yiwei-original.jpg",
        alt: "《捕捉阳光》· 一尾",
        width: 1191,
        height: 1920,
      },
      {
        browserSrc: "/images/monthly-nine/2025-yellow/sanchuan/09-960.jpg",
        browserSrcset: "/images/monthly-nine/2025-yellow/sanchuan/09-960.jpg 960w, /images/monthly-nine/2025-yellow/sanchuan/09-1800.jpg 1800w",
        originalSrc: "/images/monthly-nine/2025-yellow/sanchuan/09-original.jpg",
        alt: "《金黄色的》· 三川",
        width: 2382,
        height: 1587,
      },
    ],
  },
  {
    href: "/monthly-nine/2025-spring-festival",
    date: "2025.01—03",
    title: "新春",
    en: "NEW SPRING",
    status: "已评选",
    summary: "新春，是时空在日历上轻轻翻页的光痕。旧联、新桃、团圆饭与街巷灯火，都成为这一期的共同记忆。",
    count: "3 组入选作品",
    tone: 6,
    preview: [
      { browserSrc:"/images/monthly-nine/2025-spring-festival/left-jun/new-year-960.jpg", originalSrc:"/images/monthly-nine/2025-spring-festival/left-jun/new-year-original.jpg", alt:"《新年》· Left-俊", width:1620, height:1080 },
      { browserSrc:"/images/monthly-nine/2025-spring-festival/azp/tokyo-dream-960.jpg", originalSrc:"/images/monthly-nine/2025-spring-festival/azp/tokyo-dream-original.jpg", alt:"《东京迷梦》· Azp", width:3845, height:5768 },
      { browserSrc:"/images/monthly-nine/2025-spring-festival/kale-c/lion-fireworks/01-960.jpg", originalSrc:"/images/monthly-nine/2025-spring-festival/kale-c/lion-fireworks/01-original.jpg", alt:"《年味来自醒狮爆竹和烟花》· 卡乐C", width:6000, height:4000 },
    ],
  },
  {
    href: "/monthly-nine/2026-blossom",
    date: "2026.03",
    title: "繁花",
    en: "BLOSSOM",
    status: "已评选",
    summary: "在春风与光影的交织里，以花为题，记录春日里那些鲜明、热烈又柔软的瞬间。",
    count: "3 组入选作品",
    tone: 3,
    preview: [
      { browserSrc:"/images/monthly-nine/2026-blossom/yiwei/spring-blossom-960.jpg", originalSrc:"/images/monthly-nine/2026-blossom/yiwei/spring-blossom-original.jpg", alt:"《春日繁花》· 一尾", width:4288, height:2848 },
      { browserSrc:"/images/monthly-nine/2026-blossom/sebastian/shadowless-hall-960.jpg", originalSrc:"/images/monthly-nine/2026-blossom/sebastian/shadowless-hall-original.jpg", alt:"《无影堂下花隐无》· Sebastian", width:2160, height:3840 },
      { browserSrc:"/images/monthly-nine/2026-blossom/tiantian/butterfly-flower/01-960.jpg", originalSrc:"/images/monthly-nine/2026-blossom/tiantian/butterfly-flower/01-original.jpg", alt:"《蝴蝶与花》· 天天快乐", width:6016, height:4016 },
    ],
  },
  {
    date: "2026.04",
    title: "春",
    en: "SPRING",
    status: "征集记录",
    summary: "江安河畔的涟漪、梧桐絮、白玉兰与长桥上的风，都是春天在校园里留下的形状。",
    count: "主题档案",
    tone: 4,
  },
];
---
<BaseLayout title="每月九图 · SCU LENS" active="/monthly-nine">
  <div class="page-shell">
    <section class="page-hero monthly-hero">
      <div>
        <div class="eyebrow">Monthly Nine · Moments Collection</div>
        <h1 class="display">每月<br/>九图</h1>
      </div>
      <p>每月固定主题征集，从 QQ 频道投稿中选出代表作品。这里按月份保存主题、作品与作者，形成一条长期影像时间轴。</p>
    </section>

    <section class="section latest-issue" aria-labelledby="latest-issue-title">
      <div class="latest-issue-head">
        <div>
          <div class="eyebrow">Latest Issue · 当前一期</div>
          <div class="latest-status-row">
            <span class:list={["latest-status", { collecting: latestIssue.state === "collecting" }]}>{latestIssue.status}</span>
            <span>{latestIssue.deadline}</span>
          </div>
        </div>
        <span class="latest-date">{latestIssue.date}</span>
      </div>
      <div class="latest-issue-grid">
        <div class="latest-title-block" style={`background-image:linear-gradient(180deg,rgba(18,25,18,.08),rgba(18,25,18,.7)),url('${latestIssue.cover}');`}>
          <p>{latestIssue.en}</p>
          <h2 id="latest-issue-title">{latestIssue.title}</h2>
          <span>{latestIssue.count}</span>
        </div>
        <div class="latest-statement">
          {latestIssue.statement.map((paragraph) => <p>{paragraph}</p>)}
          <div class="latest-actions">
            {latestIssue.state === "collecting" ? (
              <a class="latest-primary" href={channelUrl} target="_blank" rel="noreferrer">前往 QQ 频道投稿 ↗</a>
            ) : latestIssue.href ? (
              <a class="latest-primary" href={latestIssue.href}>查看本期完整结果 →</a>
            ) : (
              <span class="latest-primary latest-primary-muted">本期完整图片整理中</span>
            )}
            <span>最新一期在总览页完整展示；历期内容在下方以摘要归档。</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section issue-list-section">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Archive · Earlier Issues</div>
          <h2 class="section-display">往期展览</h2>
        </div>
        <p>最新一期以上方完整策展形式呈现；这里保留往期摘要，作为长期影像档案入口。</p>
      </div>

      <div class="issue-card-list">
        {issues.map((issue, index) => (
          <article class="issue-card">
            <div class="issue-card-index">{String(index + 1).padStart(2, "0")}</div>
            <div class:list={["issue-card-visual", "tone-" + issue.tone, { "has-preview": issue.preview }]}>
              <span class="issue-card-date">{issue.date}</span>
              {issue.preview ? (
                <div class="issue-card-photo-preview">
                  {issue.preview.map((photo) => (
                    <a class="preview-photo-link" href={photo.originalSrc} target="_blank" rel="noopener" aria-label={`查看原图：${photo.alt}`}>
                      <img
                        src={photo.browserSrc}
                        srcset={photo.browserSrcset}
                        sizes="(max-width: 700px) 48vw, 420px"
                        data-browser-src={photo.browserSrc}
                        data-browser-srcset={photo.browserSrcset}
                        data-original-src={photo.originalSrc}
                        data-loaded-quality="browser"
                        alt={photo.alt}
                        width={photo.width}
                        height={photo.height}
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="preview-open-hint">点开原图 ↗</span>
                    </a>
                  ))}
                </div>
              ) : (
                <div class="issue-card-photo-layout">
                  <span></span><span></span><span></span>
                </div>
              )}
              <div class="issue-card-title">
                <p>{issue.en}</p>
                <h3>{issue.title}</h3>
              </div>
            </div>
            <div class="issue-card-copy">
              <div class="issue-card-meta">
                <span>{issue.status}</span>
                <span>{issue.count}</span>
              </div>
              <p>{issue.summary}</p>
              {issue.href ? <a class="issue-detail-link" href={issue.href}>查看本期 →</a> : <b>图片整理中</b>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section channel-join-panel">
      <div class="channel-join-copy">
        <div class="eyebrow">Contribute on QQ Channel</div>
        <h2>投稿仍然发生在频道。</h2>
        <p>官网不要求重复上传。扫描二维码或直接打开四川大学摄影协会 QQ 频道，在相机组、胶片组或手机组对应板块投稿。</p>
        <div class="channel-id">频道号 · <strong>pd77222624</strong></div>
        <a class="channel-open-button" href={channelUrl} target="_blank" rel="noreferrer">打开 QQ 频道 <span>↗</span></a>
      </div>
      <a class="channel-qr-card" href={channelUrl} target="_blank" rel="noreferrer">
        <div class="qr-card-head">
          <img src="/images/scu-photo-logo.jpg" alt="" />
          <div><strong>四川大学摄影协会</strong><span>SCU LENS · QQ CHANNEL</span></div>
        </div>
        <img class="qr-image" src="/images/qq-channel-qr.png" alt="四川大学摄影协会 QQ 频道二维码" />
        <div class="qr-card-foot"><span>扫码加入频道</span><b>pd77222624</b></div>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .monthly-hero { padding-top:84px; padding-bottom:44px; }
  .monthly-hero h1 { font-size:clamp(3.8rem,8vw,6.6rem); }
  .monthly-hero p { max-width:560px; font-size:.98rem; line-height:1.72; }
  .latest-issue,.issue-list-section,.channel-join-panel { padding-top:56px; padding-bottom:56px; }
  .latest-issue-head { display:flex; justify-content:space-between; gap:20px; align-items:flex-start; margin-bottom:28px; }
  .latest-status-row { display:flex; gap:12px; align-items:center; margin-top:15px; color:var(--muted); font-size:.72rem; }
  .latest-status { padding:7px 10px; border:1px solid var(--ink); color:var(--ink); font-weight:800; letter-spacing:.04em; }
  .latest-status.collecting { background:var(--ink); color:white; }
  .latest-date { font:400 clamp(1.65rem,3vw,3rem)/1 Georgia,serif; letter-spacing:-.045em; }
  .latest-issue-grid { display:grid; grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); gap:clamp(28px,4.5vw,64px); align-items:start; }
  .latest-title-block { width:100%; aspect-ratio:4/3; padding:24px; background-color:#294334; background-size:cover; background-position:center; color:#f5f0e6; display:flex; flex-direction:column; border:1px solid var(--line); text-shadow:0 1px 14px rgba(0,0,0,.28); }
  .latest-title-block > p { margin:0; font-size:.68rem; letter-spacing:.15em; opacity:.62; }
  .latest-title-block h2 { margin:auto 0 16px; max-width:7ch; font:400 clamp(3.1rem,5.6vw,5.8rem)/.88 Georgia,serif; letter-spacing:-.065em; }
  .latest-title-block > span { font-size:.75rem; opacity:.65; }
  .latest-statement { display:flex; flex-direction:column; gap:18px; align-self:stretch; }
  .latest-statement > p { margin:0; color:var(--muted); font-size:.95rem; line-height:1.8; }
  .latest-statement > p:first-child { color:var(--ink); font:400 clamp(1.12rem,1.7vw,1.48rem)/1.6 Georgia,serif; }
  .latest-actions { margin-top:8px; padding-top:20px; border-top:1px solid var(--line); display:flex; justify-content:space-between; gap:20px; align-items:end; }
  .latest-primary { flex:none; padding-bottom:6px; border-bottom:1px solid var(--ink); font-size:.82rem; font-weight:800; }
  .latest-primary-muted { color:var(--muted); border-bottom-color:var(--line); }
  .latest-actions > span:last-child { max-width:320px; color:var(--muted); font-size:.72rem; line-height:1.7; text-align:right; }
  .issue-card-list { display:grid; gap:32px; }
  .issue-card { display:grid; grid-template-columns:42px minmax(0,1.35fr) minmax(260px,.65fr); gap:14px; align-items:stretch; }
  .issue-card-index { padding-top:10px; color:var(--muted); font-size:.72rem; letter-spacing:.12em; }
  .issue-card-visual { width:100%; aspect-ratio:4/3; padding:20px; color:white; display:flex; flex-direction:column; justify-content:space-between; overflow:hidden; border:1px solid var(--line); }
  .issue-card-visual.has-preview { aspect-ratio:auto; }
  .issue-card-date { font-size:.72rem; letter-spacing:.12em; }
  .issue-card-photo-layout { display:grid; grid-template-columns:1.3fr .7fr; grid-template-rows:1fr 1fr; gap:6px; height:42%; margin:18px 0; opacity:.86; }
  .issue-card-photo-layout span { border:1px solid rgba(255,255,255,.56); background:rgba(255,255,255,.16); }
  .issue-card-photo-layout span:first-child { grid-row:1 / span 2; }
  .issue-card-photo-preview { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,.72fr); gap:6px; margin:18px 0; align-items:start; }
  .preview-photo-link { position:relative; display:block; color:inherit; }
  .issue-card-photo-preview .preview-photo-link:first-child { grid-row:span 2; }
  .issue-card-photo-preview img { display:block; width:100%; height:auto; border:1px solid rgba(255,255,255,.52); }
  .preview-open-hint { position:absolute; right:8px; bottom:7px; padding:4px 6px; background:rgba(18,17,14,.58); color:#fff; font-size:.58rem; letter-spacing:.04em; opacity:0; transition:opacity .18s ease; }
  .preview-photo-link:hover .preview-open-hint,.preview-photo-link:focus-visible .preview-open-hint { opacity:1; }
  .issue-card-title p { margin:0 0 8px; font-size:.66rem; letter-spacing:.16em; opacity:.72; }
  .issue-card-title h3 { margin:0; font:400 clamp(2.35rem,4.2vw,4.2rem)/.9 Georgia,serif; letter-spacing:-.065em; }
  .issue-card-copy { padding:22px; border:1px solid var(--line); background:rgba(255,255,255,.45); display:flex; flex-direction:column; }
  .issue-card-meta { display:flex; justify-content:space-between; gap:14px; color:var(--muted); font-size:.72rem; }
  .issue-card-copy > p { margin:auto 0 24px; color:var(--muted); font-size:.92rem; line-height:1.75; }
  .issue-card-copy b { font-size:.82rem; }
  .issue-detail-link { align-self:flex-start; font-size:.82rem; font-weight:800; border-bottom:1px solid currentColor; padding-bottom:4px; }
  .channel-join-panel { display:grid; grid-template-columns:1.2fr .8fr; gap:36px; align-items:stretch; }
  .channel-join-copy { display:flex; flex-direction:column; align-items:flex-start; }
  .channel-join-copy h2 { margin:10px 0 16px; font:400 clamp(2.2rem,4vw,4.2rem)/.98 Georgia,serif; letter-spacing:-.05em; }
  .channel-join-copy > p { max-width:620px; color:var(--muted); line-height:1.85; }
  .channel-id { margin-top:auto; padding-top:34px; color:var(--muted); }
  .channel-id strong { color:var(--ink); }
  .channel-open-button { margin-top:16px; padding:15px 19px; background:var(--ink); color:white; font-weight:700; }
  .channel-qr-card { aspect-ratio:4/3; min-height:0; padding:24px; background:#fff; border:1px solid var(--line); display:flex; flex-direction:column; box-shadow:0 22px 60px rgba(35,31,24,.07); }
  .qr-card-head { display:flex; gap:14px; align-items:center; }
  .qr-card-head img { width:52px; height:52px; object-fit:cover; border-radius:10px; }
  .qr-card-head div { display:grid; gap:5px; }
  .qr-card-head span { color:var(--muted); font-size:.65rem; letter-spacing:.1em; }
  .qr-image { width:min(78%,360px); margin:auto; image-rendering:pixelated; }
  .qr-card-foot { display:flex; justify-content:space-between; gap:12px; color:var(--muted); font-size:.76rem; }
  .qr-card-foot b { color:var(--ink); }
  @media (max-width:900px) {
    .latest-issue-grid { grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:28px; }
    .issue-card { grid-template-columns:30px 1fr; }
    .issue-card-copy { grid-column:2; }
  }
  @media (max-width:700px) {
    .channel-join-panel,.latest-issue-grid { grid-template-columns:1fr; }
    .latest-issue-head,.latest-actions { align-items:flex-start; flex-direction:column; }
    .latest-actions > span:last-child { text-align:left; }
    .monthly-hero { padding-top:58px; padding-bottom:32px; }
    .monthly-hero h1 { font-size:clamp(3rem,14vw,4.5rem); }
    .latest-issue,.issue-list-section,.channel-join-panel { padding-top:42px; padding-bottom:42px; }
    .latest-issue-head { margin-bottom:22px; }
    .latest-title-block { aspect-ratio:4/3; padding:20px; }
    .latest-title-block h2 { font-size:clamp(2.8rem,13vw,4.4rem); }
    .latest-statement > p { font-size:.9rem; line-height:1.72; }
    .latest-statement > p:first-child { font-size:1.08rem; line-height:1.58; }
    .issue-card { grid-template-columns:1fr; gap:12px; }
    .issue-card-index { display:none; }
    .issue-card-visual:not(.has-preview) { aspect-ratio:4/3; }
    .issue-card-photo-preview { grid-template-columns:1fr 1fr; }
    .issue-card-photo-preview .preview-photo-link:first-child { grid-row:auto; }
    .issue-card-photo-preview .preview-photo-link:last-child { grid-column:1 / -1; }
    .preview-open-hint { opacity:1; font-size:.54rem; }
    .issue-card-copy { grid-column:1; min-height:0; }
    .issue-card-copy > p { margin:26px 0 20px; }
    .channel-id { margin-top:28px; }
    .channel-qr-card { aspect-ratio:4/3; min-height:0; }
  }
</style>
