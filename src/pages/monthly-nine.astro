---
import BaseLayout from "../layouts/BaseLayout.astro";

const channelUrl = "https://pd.qq.com/s/g39qgegw0?b=9";

const latestIssue = {
  href: "/monthly-nine/2026-jiang-an-green",
  date: "2026.05—07",
  title: "江安青绿",
  en: "JIANG'AN GREEN",
  state: "closed",
  status: "已完成 · 结果已公布",
  count: "3 组入选作品",
  cover: "/images/monthly-nine/2026-jiang-an-green/gongbao/lotus-wind-1800.jpg",
  statement: [
    "春风退场，江安被层层叠叠的绿意拥入怀中。",
    "湖畔垂柳铺展浓荫，红砖楼宇隐在繁茂草木之间，湖光映着满校园深浅不一的青碧，风穿过教学楼与林荫小道，把江安独有的温柔绿意吹遍每个角落。",
    "不必奔赴远方，眼底即是盛景。",
    "用镜头收藏漫天青绿，留住校园最治愈的夏日风光。",
    "——四川大学摄影协会五月「江安青绿」每月九图",
    "以绿意寄温柔，以镜头赴热爱，征集属于川大江安的夏日绿意。",
    "本期评选推出 Sebastian《浮鸭戏芳华》、宫保鸡丁《荷风满塘》与冬淋《清新脱俗小雏菊》三组作品。",
  ],
};

const issues = [
  {
    href: "/monthly-nine/2025-yellow",
    date: "2025.12",
    title: "黄色",
    en: "YELLOW",
    status: "已评选",
    summary: "黄色，是校园银杏树下铺就的金黄地毯，是落日余晖与云隙夕照，也是乡间田野起伏的麦浪。这个金秋，记录生活中的每一抹黄色。",
    count: "3 组入选作品",
    tone: 5,
    preview: { browserSrc:"/images/monthly-nine/2025-yellow/sanchuan/09-960.jpg", originalSrc:"/images/monthly-nine/2025-yellow/sanchuan/09-original.jpg", alt:"《金黄色的》· 三川", width:2382, height:1587 },
  },
  {
    href: "/monthly-nine/2026-spring-festival",
    date: "2026.01",
    title: "新春",
    en: "NEW SPRING",
    status: "已评选",
    summary: "新春，是时空在日历上轻轻翻页的光痕。镜头记录旧联与新桃、团圆与灯火，也记录离散与重逢之间温暖的同步。",
    count: "3 组入选作品",
    tone: 6,
    preview: { browserSrc:"/images/monthly-nine/2026-spring-festival/left-jun/new-year-960.jpg", originalSrc:"/images/monthly-nine/2026-spring-festival/left-jun/new-year-original.jpg", alt:"《新年》· Left-俊", width:1620, height:1080 },
  },
  {
    href: "/monthly-nine/2026-blossom",
    date: "2026.03",
    title: "繁花",
    en: "BLOSSOM",
    status: "已评选",
    summary: "花开，是春天写给人间的温柔信笺。以花为景，以光为笔，记录枝头初绽、风拂花瓣与光影里最动人的春色。",
    count: "3 组入选作品",
    tone: 3,
    preview: { browserSrc:"/images/monthly-nine/2026-blossom/yiwei/spring-blossom-960.jpg", originalSrc:"/images/monthly-nine/2026-blossom/yiwei/spring-blossom-original.jpg", alt:"《春日繁花》· 一尾", width:4288, height:2848 },
  },
].reverse();
---
<BaseLayout title="每月九图 · SCU LENS" active="/monthly-nine">
  <div class="page-shell">
    <section class="page-hero monthly-hero">
      <div class="page-hero-title">
        <div class="eyebrow">Monthly Nine · Moments Collection</div>
        <h1 class="display">每月九图</h1>
      </div>
      <p>每月固定主题征集，从 QQ 频道投稿中选出代表作品。这里按月份保存主题、作品与作者，形成一条长期影像时间轴。</p>
    </section>

    <section class="section latest-issue" aria-labelledby="latest-issue-title">
      <div class="latest-issue-head">
        <div>
          <span class="latest-date">{latestIssue.date}</span>
          <div class="eyebrow">Latest Issue · 当前一期</div>
          <div class="latest-status-row">
            <span class:list={["latest-status", { collecting: latestIssue.state === "collecting" }]}>{latestIssue.status}</span>
          </div>
        </div>
      </div>
      <div class="latest-issue-grid">
        <div class="latest-title-block" style={`background-image:linear-gradient(180deg,rgba(18,25,18,.08),rgba(18,25,18,.7)),url('${latestIssue.cover}');`}>
          <p>{latestIssue.en}</p>
          <h2 id="latest-issue-title">{latestIssue.title}</h2>
          <span>{latestIssue.count}</span>
        </div>
        <div class="latest-right">
          <div class="latest-statement">
            {latestIssue.statement.map((paragraph) => <p>{paragraph}</p>)}
            <div class="latest-actions">
              {latestIssue.state === "collecting" ? (
                <a class="latest-primary" href="/submit">前往投稿专区 →</a>
              ) : latestIssue.href ? (
                <a class="latest-primary" href={latestIssue.href}>查看本期完整结果 →</a>
              ) : null}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section issue-list-section">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Archive · Earlier Issues</div>
          <h2 class="section-display">往期展览</h2>
        </div>
        <p>按时间回看过去的主题、入选作品与作者。</p>
      </div>

      <div class="issue-card-list">
        {issues.map((issue, index) => (
          <article class="issue-card">
            <div class="issue-card-index">{String(index + 1).padStart(2, "0")}</div>
            <div class:list={["issue-card-visual", "tone-" + issue.tone, { "has-preview": issue.preview }]}>
              {issue.preview ? (
                <img class="issue-card-cover" src={issue.preview.browserSrc} alt={issue.preview.alt} width={issue.preview.width} height={issue.preview.height} loading="lazy" decoding="async" />
              ) : (
                <div class="issue-card-photo-layout">
                  <span></span><span></span><span></span>
                </div>
              )}
              <div class="issue-card-overlay"></div>
              <div class="issue-card-content">
                <div class="issue-card-top">
                  <span class="issue-card-date">{issue.date}</span>
                  <span>{issue.status} · {issue.count}</span>
                </div>
                <div class="issue-card-title">
                  <p>{issue.en}</p>
                  <h3>{issue.title}</h3>
                  <p class="issue-card-summary">{issue.summary}</p>
                  {issue.href ? <a class="issue-detail-link" href={issue.href}>查看本期 →</a> : null}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section channel-join-panel">
      <div class="channel-join-copy">
        <div class="eyebrow">Contribute on QQ Channel</div>
        <h2>投稿从这里继续。</h2>
        <p>查看完整投稿说明、署名方式与分区规则；也可以直接扫描右侧二维码快速加入四川大学摄影协会 QQ 频道。</p>
        <div class="channel-id">频道号 · <strong>pd77222624</strong></div>
        <a class="channel-open-button" href="/submit">进入投稿专区 <span>→</span></a>
      </div>
      <a class="channel-qr-card" href={channelUrl} target="_blank" rel="noreferrer">
        <div class="qr-card-head">
          <img src="/images/scu-photo-logo.jpg" alt="" />
          <div><strong>四川大学摄影协会</strong><span>SCU LENS · QQ CHANNEL</span></div>
        </div>
        <img class="qr-image" src="/images/qq-channel-qr.png" alt="四川大学摄影协会 QQ 频道二维码" />
        <div class="qr-card-foot"><span>扫码加入频道</span><b>pd77222624</b></div>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .monthly-hero { padding-top:var(--space-page-top); padding-bottom:var(--space-page-bottom); }
  .monthly-hero h1 { font-size:clamp(3.8rem,8vw,6.6rem); }
  .monthly-hero p { max-width:560px; font-size:var(--font-body); line-height:var(--line-body); }
  .latest-issue,.issue-list-section,.channel-join-panel { padding-top:var(--space-section-top); padding-bottom:var(--space-section-bottom); }
  .latest-issue-head { display:flex; justify-content:flex-start; gap:20px; align-items:flex-start; margin-bottom:28px; }
  .latest-status-row { display:flex; gap:12px; align-items:center; margin-top:15px; color:var(--muted); font-size:.72rem; }
  .latest-status { padding:7px 10px; border:1px solid var(--ink); color:var(--ink); font-weight:700; letter-spacing:.05em; }
  .latest-status.collecting { background:var(--ink); color:white; }
  .latest-date { display:block; margin-bottom:18px; font:400 clamp(2rem,3.5vw,3.8rem)/1 var(--font-latin-serif); letter-spacing:-.03em; font-variant-numeric:lining-nums tabular-nums; }
  .latest-issue-grid { display:grid; grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); gap:clamp(28px,4.5vw,64px); align-items:start; }
  .latest-title-block { width:100%; aspect-ratio:4/3; padding:24px; background-color:#294334; background-size:cover; background-position:center; color:#f5f0e6; display:flex; flex-direction:column; border:1px solid var(--line); text-shadow:0 1px 14px rgba(0,0,0,.28); }
  .latest-title-block > p { margin:0; font-size:.68rem; letter-spacing:.15em; opacity:.62; }
  .latest-title-block h2 { margin:auto 0 16px; max-width:7ch; font:400 clamp(3.1rem,5.6vw,5.8rem)/.96 var(--font-serif); letter-spacing:-.032em; }
  .latest-title-block > span { font-size:.75rem; opacity:.65; }
  .latest-right { min-width:0; }
  .latest-statement { display:flex; flex-direction:column; gap:11px; padding-top:clamp(46px,5vw,72px); }
  .latest-statement > p { margin:0; color:var(--muted); font-size:var(--font-body); line-height:var(--line-body); }
  .latest-statement > p:first-child { color:var(--ink); font:400 clamp(1.08rem,1.55vw,1.38rem)/1.55 var(--font-serif); }
  .latest-actions { margin-top:8px; padding-top:20px; border-top:1px solid var(--line); display:flex; justify-content:space-between; gap:20px; align-items:end; }
  .latest-primary { flex:none; padding-bottom:6px; border-bottom:1px solid var(--ink); font-size:.82rem; font-weight:800; }
  .latest-primary-muted { color:var(--muted); border-bottom-color:var(--line); }
  .latest-actions > span:last-child { max-width:320px; color:var(--muted); font-size:.72rem; line-height:1.7; text-align:right; }
  .issue-card-list { display:grid; gap:32px; }
  .issue-card { display:grid; grid-template-columns:42px minmax(0,1fr); gap:14px; align-items:stretch; }
  .issue-card-index { padding-top:10px; color:var(--muted); font-size:.72rem; letter-spacing:.12em; }
  .issue-card-visual { position:relative; width:100%; aspect-ratio:16/7; color:white; overflow:hidden; border:1px solid var(--line); background:#666; }
  .issue-card-cover { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .issue-card-overlay { position:absolute; inset:0; background:linear-gradient(90deg,rgba(13,13,11,.70) 0%,rgba(13,13,11,.35) 48%,rgba(13,13,11,.08) 100%),linear-gradient(180deg,rgba(0,0,0,.10),rgba(0,0,0,.36)); }
  .issue-card-content { position:relative; z-index:2; height:100%; padding:22px 24px; display:flex; flex-direction:column; justify-content:space-between; }
  .issue-card-top { display:flex; justify-content:space-between; gap:16px; font-size:.68rem; letter-spacing:.08em; color:rgba(255,255,255,.78); }
  .issue-card-date { letter-spacing:.12em; font-variant-numeric:tabular-nums; }
  .issue-card-photo-layout { display:grid; grid-template-columns:1.3fr .7fr; grid-template-rows:1fr 1fr; gap:6px; height:42%; margin:18px 0; opacity:.86; }
  .issue-card-photo-layout span { border:1px solid rgba(255,255,255,.56); background:rgba(255,255,255,.16); }
  .issue-card-photo-layout span:first-child { grid-row:1 / span 2; }
  .issue-card-title p { margin:0 0 8px; font-size:.66rem; letter-spacing:.16em; opacity:.72; }
  .issue-card-title h3 { margin:0; font:400 clamp(2.35rem,4.2vw,4.2rem)/.96 var(--font-serif); letter-spacing:-.032em; }
  .issue-card-summary { max-width:620px; margin:10px 0 14px !important; font-size:.82rem !important; line-height:1.55; letter-spacing:0 !important; color:rgba(255,255,255,.72); opacity:1 !important; }
  .issue-detail-link { display:inline-block; font-size:.78rem; font-weight:800; border-bottom:1px solid currentColor; padding-bottom:4px; }
  .channel-join-panel { display:grid; grid-template-columns:1.2fr .8fr; gap:36px; align-items:stretch; }
  .channel-join-copy { display:flex; flex-direction:column; align-items:flex-start; }
  .channel-join-copy h2 { margin:10px 0 16px; font:400 clamp(2.2rem,4vw,4.2rem)/1.02 var(--font-serif); letter-spacing:-.028em; }
  .channel-join-copy > p { margin:0; max-width:620px; color:var(--muted); font-size:var(--font-body); line-height:var(--line-body); }
  .channel-id { margin-top:auto; padding-top:34px; color:var(--muted); }
  .channel-id strong { color:var(--ink); }
  .channel-open-button { margin-top:16px; padding:15px 19px; background:var(--ink); color:white; font-weight:700; }
  .channel-qr-card { min-height:0; padding:24px; background:#fff; border:1px solid var(--line); display:flex; flex-direction:column; box-shadow:0 22px 60px rgba(35,31,24,.07); overflow:hidden; }
  .qr-card-head { display:flex; gap:14px; align-items:center; }
  .qr-card-head img { width:52px; height:52px; object-fit:cover; border-radius:10px; }
  .qr-card-head div { display:grid; gap:5px; }
  .qr-card-head span { color:var(--muted); font-size:.65rem; letter-spacing:.1em; }
  .qr-image { display:block; width:min(100%,360px); max-width:100%; height:auto; margin:28px auto; background:#fff; image-rendering:pixelated; }
  .qr-card-foot { display:flex; justify-content:space-between; gap:12px; color:var(--muted); font-size:.76rem; }
  .qr-card-foot b { color:var(--ink); }
  @media (max-width:900px) {
    .latest-issue-grid { grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:28px; }
    .issue-card { grid-template-columns:30px 1fr; }
  }
  @media (max-width:700px) {
    .channel-join-panel,.latest-issue-grid { grid-template-columns:1fr; }
    .latest-issue-head,.latest-actions { align-items:flex-start; flex-direction:column; }
    .latest-date { margin-bottom:14px; font-size:clamp(2rem,10vw,3rem); }
    .latest-actions > span:last-child { text-align:left; }
    .monthly-hero { padding-top:var(--space-page-top); padding-bottom:var(--space-page-bottom); }
    .monthly-hero h1 { font-size:clamp(3rem,14vw,4.5rem); }
    .latest-issue,.issue-list-section,.channel-join-panel { padding-top:var(--space-section-top); padding-bottom:var(--space-section-bottom); }
    .latest-issue-head { margin-bottom:22px; }
    .latest-title-block { aspect-ratio:4/3; padding:20px; }
    .latest-title-block h2 { font-size:clamp(2.8rem,13vw,4.4rem); }
    .latest-statement > p { font-size:var(--font-body); line-height:var(--line-body); }
    .latest-statement > p:first-child { font-size:1.08rem; line-height:1.58; }
    .latest-statement { padding-top:6px; gap:9px; }
    .issue-card { grid-template-columns:1fr; gap:12px; }
    .issue-card-index { display:none; }
    .issue-card-visual { aspect-ratio:4/3; }
    .issue-card-content { padding:18px 18px 20px; }
    .issue-card-top { font-size:.6rem; }
    .issue-card-title h3 { font-size:clamp(2.6rem,13vw,4rem); }
    .issue-card-summary { max-width:92%; font-size:.74rem !important; line-height:1.5; }
    .channel-id { margin-top:28px; }
    .channel-qr-card { min-height:0; padding:18px; overflow:hidden; }
    .qr-image { width:min(100%,320px); max-width:100%; margin:22px auto; }
  }
</style>
