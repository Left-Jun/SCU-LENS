---
import BaseLayout from "../layouts/BaseLayout.astro";

const channelUrl = "https://pd.qq.com/s/g39qgegw0?b=9";

const issues = [
  {
    href: "/monthly-nine/2025-yellow",
    date: "2025.01",
    title: "黄色",
    en: "YELLOW",
    status: "已评选",
    summary: "黄色是光，是温度，是苏醒，也是沉淀。它可以是街角一盏暖灯，是季节更迭时的一抹秋意，也可以是某个瞬间落入镜中的情绪与故事。",
    count: "3 组入选作品",
    tone: 5,
  },
  {
    date: "2025.01—03",
    title: "新春",
    en: "NEW SPRING",
    status: "已评选",
    summary: "新春，是时空在日历上轻轻翻页的光痕。旧联、新桃、团圆饭与街巷灯火，都成为这一期的共同记忆。",
    count: "3 组入选作品",
    tone: 6,
  },
  {
    date: "2026.03",
    title: "繁花",
    en: "BLOSSOM",
    status: "已评选",
    summary: "在春风与光影的交织里，以花为题，记录春日里那些鲜明、热烈又柔软的瞬间。",
    count: "3 组入选作品",
    tone: 3,
  },
  {
    date: "2026.04",
    title: "春",
    en: "SPRING",
    status: "征集记录",
    summary: "江安河畔的涟漪、梧桐絮、白玉兰与长桥上的风，都是春天在校园里留下的形状。",
    count: "主题档案",
    tone: 4,
  },
  {
    date: "2026.05—07",
    title: "江安青绿",
    en: "JIANG'AN GREEN",
    status: "已评选",
    summary: "盛夏漫染江安，青绿铺展满园。荷塘、萍叶与草木共同构成一段属于江安夏日的青绿记录。",
    count: "3 组入选作品",
    tone: 7,
  },
];
---
<BaseLayout title="每月九图 · SCU LENS" active="/monthly-nine">
  <div class="page-shell">
    <section class="page-hero monthly-hero">
      <div>
        <div class="eyebrow">Monthly Nine · Moments Collection</div>
        <h1 class="display">每月<br/>九图</h1>
      </div>
      <p>每月固定主题征集，从 QQ 频道投稿中选出代表作品。这里按月份保存主题、作品与作者，形成一条长期影像时间轴。</p>
    </section>

    <section class="section monthly-intro">
      <div>
        <div class="eyebrow">How It Works</div>
        <h2>一月一页，一期一展。</h2>
      </div>
      <div class="monthly-rule-list">
        <p>总览页以每个月的大卡片展示主题与代表作品。</p>
        <p>点进某一期后，再按作品逐件展示标题、摄影者与图片。</p>
        <p>如果某个入选作品本身是图集，则继续点进作品页查看完整组图。</p>
      </div>
    </section>

    <section class="section issue-list-section">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Archive · 2025—2026</div>
          <h2 class="section-display">历期展览</h2>
        </div>
        <p>先把结构搭起来。你接下来继续按期把原图发来，我们逐期替换成真实作品。</p>
      </div>

      <div class="issue-card-list">
        {issues.map((issue, index) => (
          <a class="issue-card" href={issue.href ?? "#"}>
            <div class="issue-card-index">{String(index + 1).padStart(2, "0")}</div>
            <div class={"issue-card-visual tone-" + issue.tone}>
              <span class="issue-card-date">{issue.date}</span>
              <div class="issue-card-photo-layout">
                <span></span><span></span><span></span>
              </div>
              <div class="issue-card-title">
                <p>{issue.en}</p>
                <h3>{issue.title}</h3>
              </div>
            </div>
            <div class="issue-card-copy">
              <div class="issue-card-meta">
                <span>{issue.status}</span>
                <span>{issue.count}</span>
              </div>
              <p>{issue.summary}</p>
              <b>{issue.href ? "查看本期 →" : "图片整理中"}</b>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="section channel-join-panel">
      <div class="channel-join-copy">
        <div class="eyebrow">Contribute on QQ Channel</div>
        <h2>投稿仍然发生在频道。</h2>
        <p>官网不要求重复上传。扫描二维码或直接打开四川大学摄影协会 QQ 频道，在相机组、胶片组或手机组对应板块投稿。</p>
        <div class="channel-id">频道号 · <strong>pd77222624</strong></div>
        <a class="channel-open-button" href={channelUrl} target="_blank" rel="noreferrer">打开 QQ 频道 <span>↗</span></a>
      </div>
      <a class="channel-qr-card" href={channelUrl} target="_blank" rel="noreferrer">
        <div class="qr-card-head">
          <img src="/images/scu-photo-logo.jpg" alt="" />
          <div><strong>四川大学摄影协会</strong><span>SCU LENS · QQ CHANNEL</span></div>
        </div>
        <img class="qr-image" src="/images/qq-channel-qr.png" alt="四川大学摄影协会 QQ 频道二维码" />
        <div class="qr-card-foot"><span>扫码加入频道</span><b>pd77222624</b></div>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .monthly-intro { display:grid; grid-template-columns:.8fr 1.2fr; gap:64px; align-items:start; }
  .monthly-intro h2 { margin:10px 0 0; font:400 clamp(2.6rem,5vw,5rem)/.98 Georgia,serif; letter-spacing:-.05em; }
  .monthly-rule-list { display:grid; border-top:1px solid var(--line); }
  .monthly-rule-list p { margin:0; padding:18px 0; border-bottom:1px solid var(--line); color:var(--muted); line-height:1.75; }
  .issue-card-list { display:grid; gap:54px; }
  .issue-card { display:grid; grid-template-columns:54px minmax(0,1.35fr) minmax(280px,.65fr); gap:18px; align-items:stretch; }
  .issue-card-index { padding-top:10px; color:var(--muted); font-size:.72rem; letter-spacing:.12em; }
  .issue-card-visual { min-height:440px; padding:24px; color:white; display:flex; flex-direction:column; justify-content:space-between; overflow:hidden; border:1px solid var(--line); }
  .issue-card-date { font-size:.72rem; letter-spacing:.12em; }
  .issue-card-photo-layout { display:grid; grid-template-columns:1.3fr .7fr; grid-template-rows:1fr 1fr; gap:7px; height:220px; margin:30px 0; opacity:.86; }
  .issue-card-photo-layout span { border:1px solid rgba(255,255,255,.56); background:rgba(255,255,255,.16); }
  .issue-card-photo-layout span:first-child { grid-row:1 / span 2; }
  .issue-card-title p { margin:0 0 8px; font-size:.66rem; letter-spacing:.16em; opacity:.72; }
  .issue-card-title h3 { margin:0; font:400 clamp(3.3rem,7vw,6.8rem)/.86 Georgia,serif; letter-spacing:-.07em; }
  .issue-card-copy { padding:28px; border:1px solid var(--line); background:rgba(255,255,255,.45); display:flex; flex-direction:column; }
  .issue-card-meta { display:flex; justify-content:space-between; gap:14px; color:var(--muted); font-size:.72rem; }
  .issue-card-copy > p { margin:auto 0 34px; color:var(--muted); line-height:1.85; }
  .issue-card-copy b { font-size:.82rem; }
  .channel-join-panel { display:grid; grid-template-columns:1.2fr .8fr; gap:50px; align-items:stretch; }
  .channel-join-copy { display:flex; flex-direction:column; align-items:flex-start; }
  .channel-join-copy h2 { margin:10px 0 20px; font:400 clamp(3rem,6vw,6rem)/.94 Georgia,serif; letter-spacing:-.055em; }
  .channel-join-copy > p { max-width:620px; color:var(--muted); line-height:1.85; }
  .channel-id { margin-top:auto; padding-top:34px; color:var(--muted); }
  .channel-id strong { color:var(--ink); }
  .channel-open-button { margin-top:16px; padding:15px 19px; background:var(--ink); color:white; font-weight:700; }
  .channel-qr-card { min-height:520px; padding:28px; background:#fff; border:1px solid var(--line); display:flex; flex-direction:column; box-shadow:0 28px 80px rgba(35,31,24,.08); }
  .qr-card-head { display:flex; gap:14px; align-items:center; }
  .qr-card-head img { width:52px; height:52px; object-fit:cover; border-radius:10px; }
  .qr-card-head div { display:grid; gap:5px; }
  .qr-card-head span { color:var(--muted); font-size:.65rem; letter-spacing:.1em; }
  .qr-image { width:min(78%,360px); margin:auto; image-rendering:pixelated; }
  .qr-card-foot { display:flex; justify-content:space-between; gap:12px; color:var(--muted); font-size:.76rem; }
  .qr-card-foot b { color:var(--ink); }
  @media (max-width:900px) {
    .issue-card { grid-template-columns:36px 1fr; }
    .issue-card-copy { grid-column:2; }
  }
  @media (max-width:700px) {
    .monthly-intro,.channel-join-panel { grid-template-columns:1fr; }
    .issue-card { grid-template-columns:1fr; gap:12px; }
    .issue-card-index { display:none; }
    .issue-card-visual { min-height:360px; }
    .issue-card-copy { grid-column:1; min-height:250px; }
    .channel-id { margin-top:28px; }
    .channel-qr-card { min-height:460px; }
  }
</style>
