---
import MonthlyGroupPage from "../../../components/MonthlyGroupPage.astro";
import { galleryPhoto, monthlyNinePhotoIds, viewerPhoto } from "../../../lib/monthly-nine";
const ids=monthlyNinePhotoIds.springFestival2026;
const frames = ids.kaleC.map((id, i) => {
  const no = String(i + 1).padStart(2,"0");
  const p=galleryPhoto(id);
  return { width:p.width,height:p.height, src:p.browserSrc, srcset:p.browserSrcset, original:p.original, alt:`《年味来自醒狮爆竹和烟花》· ${no} · 卡乐C` };
});
const viewerItems = [
  viewerPhoto(ids.leftJun,{ title:"新年", author:"Left-俊", kicker:"单图 · New Spring", alt:"《新年》· Left-俊" }),
  viewerPhoto(ids.azp,{ title:"东京迷梦", author:"Azp", kicker:"单图 · New Spring", alt:"《东京迷梦》· Azp" }),
  ...ids.kaleC.map((id,i)=>viewerPhoto(id,{ title:"年味来自醒狮爆竹和烟花", author:"卡乐C", kicker:`组图 · ${String(i+1).padStart(2,"0")} / 05`, alt:frames[i].alt }))
];
const nextPreviewItems = [
  { src:galleryPhoto(monthlyNinePhotoIds.blossom2026.yiwei).src, alt:"《春日繁花》· 一尾" },
  { src:galleryPhoto(monthlyNinePhotoIds.blossom2026.tiantian[0]).src, alt:"《蝴蝶与花》· 01 · 天天快乐" },
  { src:galleryPhoto(monthlyNinePhotoIds.blossom2026.tiantian[1]).src, alt:"《蝴蝶与花》· 02 · 天天快乐" },
];
---
<MonthlyGroupPage
  issueTitle="新春" issueDate="2026.01"
  title="年味来自醒狮爆竹和烟花" author="卡乐C"
  frames={frames} viewerItems={viewerItems} viewerGroup="spring-festival-2026" viewerOffset={2}
  backHref="/monthly-nine/2026-spring-festival"
  nextTitle="繁花"
  nextSummary="2026.03 · 下一期以繁花为题。"
  nextHref="/monthly-nine/2026-blossom"
  nextPreviewItems={nextPreviewItems}
/>
