---
import MonthlyGroupPage from "../../../components/MonthlyGroupPage.astro";
import { galleryPhoto, monthlyNinePhotoIds, viewerPhoto } from "../../../lib/monthly-nine";
const ids=monthlyNinePhotoIds.blossom2026;
const frames=ids.tiantian.map((id,i)=>{ const p=galleryPhoto(id); const no=String(i+1).padStart(2,"0"); return {width:p.width,height:p.height,src:p.browserSrc,srcset:p.browserSrcset,original:p.original,alt:`《蝴蝶与花》· ${no} · 天天快乐`};});
const viewerItems=[
  ...ids.tiantian.map((id,i)=>viewerPhoto(id,{title:"蝴蝶与花",author:"天天快乐",kicker:`组图 · ${String(i+1).padStart(2,"0")} / 02`,alt:frames[i].alt})),
  viewerPhoto(ids.sebastian,{title:"无影堂下花隐无",author:"Sebastian",kicker:"单图 · Blossom",alt:"《无影堂下花隐无》· Sebastian"}),
  viewerPhoto(ids.yiwei,{title:"春日繁花",author:"一尾",kicker:"单图 · Blossom",alt:"《春日繁花》· 一尾"}),
];
const nextPreviewItems=[
  {src:galleryPhoto(monthlyNinePhotoIds.jianganGreen2026.ze).src,alt:"《荷风满塘》· 宫保鸡丁"}
];
---
<MonthlyGroupPage
  issueTitle="繁花" issueDate="2026.03"
  title="蝴蝶与花" author="天天快乐"
  frames={frames} viewerItems={viewerItems} viewerGroup="blossom-2026"
  backHref="/monthly-nine/2026-blossom"
  nextTitle="江安青绿" nextSummary="2026.05—07 · 下一期「江安青绿」。" nextHref="/monthly-nine/2026-jiang-an-green"
  nextPreviewItems={nextPreviewItems}
/>
