---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { authorHref } from "../../lib/gallery-archive";
import { galleryPhoto, monthlyNinePhotoIds, viewerPhoto } from "../../lib/monthly-nine";

const ids=monthlyNinePhotoIds.yellow2025;
const sebastian=galleryPhoto(ids.sebastian);
const yiwei=galleryPhoto(ids.yiwei);
const sanchuan=ids.sanchuan.map((id)=>galleryPhoto(id));

const works = [
  { no: "01", title: "金黄芒节", author: "Sebastian", kind: "单图", browserSrc: sebastian.browserSrc, browserSrcset: sebastian.browserSrcset, originalSrc: sebastian.original, width: sebastian.width, height: sebastian.height, orientation: "portrait" },
  { no: "02", title: "捕捉阳光", author: "一尾", kind: "单图", browserSrc: yiwei.browserSrc, browserSrcset: yiwei.browserSrcset, originalSrc: yiwei.original, width: yiwei.width, height: yiwei.height, orientation: "portrait" },
  { no: "03", title: "金黄色的", author: "彡川", kind: "9 张组图", browserSrc: sanchuan[8].browserSrc, browserSrcset: sanchuan[8].browserSrcset, originalSrc: sanchuan[8].original, width: sanchuan[8].width, height: sanchuan[8].height, orientation: "landscape", href: "/monthly-nine/2025-yellow/golden-yellow" },
];

const galleryItems = [
  viewerPhoto(ids.sebastian,{ title:"金黄芒节", author:"Sebastian", kicker:"单图 · Yellow", alt:"《金黄芒节》· Sebastian" }),
  viewerPhoto(ids.yiwei,{ title:"捕捉阳光", author:"一尾", kicker:"单图 · Yellow", alt:"《捕捉阳光》· 一尾" }),
  ...ids.sanchuan.map((id, i) => {
    const no = String(i + 1).padStart(2, "0");
    return viewerPhoto(id,{
      title:"金黄色的",
      author:"彡川",
      kicker:`组图 · ${no} / 09`,
      alt:`《金黄色的》· ${no} · 彡川`,
    });
  }),
];
const nextPreviewItems = [
  { src:galleryPhoto(monthlyNinePhotoIds.springFestival2026.azp).src, alt:"《东京迷梦》· Azp" },
  { src:galleryPhoto(monthlyNinePhotoIds.springFestival2026.kaleC[0]).src, alt:"《年味来自醒狮爆竹和烟花》· 01 · 卡乐C" },
  { src:galleryPhoto(monthlyNinePhotoIds.springFestival2026.kaleC[1]).src, alt:"《年味来自醒狮爆竹和烟花》· 02 · 卡乐C" },
];
---
<BaseLayout title="黄色 · 每月九图 · SCU LENS" active="/monthly-nine">
  <div class="page-shell">
    <section class="page-hero issue-detail-hero">
      <div>
        <a class="back-link" href="/monthly-nine">← 返回每月九图</a>
        <div class="eyebrow">Monthly Nine · 2025.12</div>
        <h1 class="display">黄色</h1>
      </div>
    </section>

    <section class="section issue-detail-meta">
      <span>本期主题 · YELLOW</span>
      <span>征集时间 · 2025.12</span>
      <span>3 组入选作品</span>
    </section>

    <section class="section issue-statement">
      <div>
        <div class="eyebrow">Theme Archive · 完整主题档案</div>
      </div>
      <div class="issue-statement-copy">
        <p>黄色，是校园银杏树下，落叶铺就的金黄地毯，沙沙作响，奏响秋的赞歌；是落日余晖洒落水面，光影重叠，跃动着的点点鎏金；是云隙之间藏不住的温柔夕照，静静守候每一段动情时光；是乡间田野上起伏的麦浪，承载丰收，在心底漾开宁静的幸福。</p>
        <p>这个金秋，生活中的每一抹黄色被镜头留存下来：银杏、夕照、麦浪与那些稍纵即逝的暖色，共同构成这一期的秋日记忆。</p>
      </div>
    </section>

    <section class="issue-work-list">
      {works.map((work) => (
        <article class="issue-work">
          <div class:list={["yellow-photo", work.orientation]}>
            <a class="photo-open-link" href={work.originalSrc} data-viewer-open={`yellow-2025:${work.no === "01" ? 0 : work.no === "02" ? 1 : 10}`} aria-label={`打开看图：《${work.title}》· ${work.author}`}>
              <img src={work.browserSrc} srcset={work.browserSrcset} sizes="(max-width: 900px) 100vw, 920px" data-browser-src={work.browserSrc} data-browser-srcset={work.browserSrcset} data-original-src={work.originalSrc} data-loaded-quality="browser" alt={`《${work.title}》· ${work.author}`} width={work.width} height={work.height} loading={work.no === "01" ? "eager" : "lazy"} fetchpriority={work.no === "01" ? "high" : "auto"} decoding="async" />
            </a>
            <span>{work.no}</span>
            {work.kind !== "单图" && <b>+ 9</b>}
          </div>
          <div class="issue-work-caption">
            <div>
              <span>{work.kind}</span>
              <h2>《{work.title}》</h2>
              <p>摄影 / {work.author}</p>
            </div>
            {work.href ? <a href={work.href}>查看完整组图 →</a> : null}
          </div>
        </article>
      ))}
    </section>

    <section class="section issue-next">
      <span class="eyebrow">Next Issue</span>
      <h2>下一主题 · 新春</h2>
      <a href="/monthly-nine/2026-spring-festival">查看下一期 →</a>
    </section>
    <div class="viewer-registry" hidden>
      {galleryItems.map((item, index) => (
        <span
          data-viewer-item
          data-viewer-group="yellow-2025"
          data-viewer-src={item.src}
          data-original-src={item.original}
          data-viewer-alt={item.alt}
          data-viewer-title={item.title}
          data-viewer-author={item.author}
          data-viewer-author-href={authorHref(item.author)}
          data-viewer-kicker={item.kicker}
          data-viewer-issue="每月九图 · 黄色"
          data-viewer-issue-href="/monthly-nine/2025-yellow"
          data-viewer-section={item.section}
          data-viewer-date={item.date}
          data-viewer-original-label="查看高清图 ↗"
          data-next-title={index === galleryItems.length - 1 ? "新春" : undefined}
          data-next-summary={index === galleryItems.length - 1 ? "2026.01 · 下一期主题「新春」。继续浏览旧联、新桃、团圆灯火与新年旅途中的影像记录。" : undefined}
          data-next-href={index === galleryItems.length - 1 ? "/monthly-nine/2026-spring-festival" : undefined}
          data-next-previews={index === galleryItems.length - 1 ? JSON.stringify(nextPreviewItems) : undefined}
        ></span>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .issue-detail-hero { display:block; padding-bottom:var(--space-page-bottom); }
  .issue-detail-hero h1 { margin-top:14px; font-size:clamp(4.2rem,10vw,8rem); }
  .back-link { display:inline-block; margin-bottom:26px; color:var(--muted); font-size:.82rem; }
  .issue-detail-meta { display:flex; justify-content:space-between; gap:20px; padding-top:34px; padding-bottom:34px; color:var(--muted); font-size:.78rem; letter-spacing:.05em; }
  .issue-statement { display:grid; grid-template-columns:180px minmax(0,1fr); gap:clamp(28px,5vw,64px); align-items:start; padding-top:46px; padding-bottom:54px; }
  .issue-statement-copy { display:grid; gap:18px; }
  .issue-statement-copy > p { margin:0; max-width:760px; color:var(--muted); font-size:.96rem; line-height:1.82; }
  .archive-note { margin-top:14px; padding-top:20px; border-top:1px solid var(--line); display:grid; grid-template-columns:150px 1fr; gap:22px; }
  .archive-note > span { color:var(--muted); font-size:.68rem; letter-spacing:.12em; text-transform:uppercase; }
  .archive-note p { margin:0; color:var(--muted); line-height:1.75; }
  .issue-work-list { padding-bottom:68px; }
  .issue-work { padding:56px 0; border-top:1px solid var(--line); }
  .yellow-photo { position:relative; width:100%; border:1px solid var(--line); background:#ddd8ca; }
  .yellow-photo.portrait { max-width:min(72vw,720px); margin-inline:auto; }
  .yellow-photo.landscape { max-width:100%; }
  .photo-open-link { display:block; cursor:zoom-in; }
  .yellow-photo img { display:block; width:100%; height:auto; }
  .yellow-photo::after { content:""; position:absolute; inset:0; background:linear-gradient(180deg,transparent,rgba(17,17,15,.08)); }
  .yellow-photo > span { position:absolute; left:18px; top:16px; z-index:1; color:white; font-size:.72rem; letter-spacing:.12em; }
  .yellow-photo > b { position:absolute; right:18px; bottom:16px; z-index:1; color:white; font:400 2rem var(--font-serif); }
  .yellow-photo > span,.yellow-photo > b,.yellow-photo::after { pointer-events:none; }
  .issue-work-caption { display:flex; justify-content:space-between; gap:30px; padding-top:18px; align-items:end; }
  .issue-work-caption span { color:var(--muted); font-size:.72rem; letter-spacing:.08em; }
  .issue-work-caption h2 { margin:8px 0 4px; font:400 clamp(2.1rem,4vw,4.4rem)/1 var(--font-serif); }
  .issue-work-caption p { margin:0; color:var(--muted); }
  .issue-work-caption a { border-bottom:1px solid var(--ink); padding-bottom:5px; font-weight:700; font-size:.82rem; }
  .muted-note { align-self:flex-end; }
  .issue-next { display:grid; grid-template-columns:.4fr 1fr auto; gap:24px; align-items:end; }
  .issue-next h2 { margin:0; font:400 clamp(2rem,4vw,4rem)/1 var(--font-serif); }
  .issue-next a { font-weight:700; font-size:.82rem; }
  @media (max-width:700px) {
    .issue-detail-hero { padding-top:var(--space-page-top); padding-bottom:var(--space-page-bottom); }
    .issue-detail-hero h1 { font-size:clamp(3.8rem,18vw,5.8rem); }
    .back-link { margin-bottom:22px; }
    .issue-detail-meta { padding-top:28px; padding-bottom:28px; gap:18px; font-size:.72rem; }
    .issue-statement { grid-template-columns:1fr; gap:20px; padding-top:34px; padding-bottom:40px; }
    .issue-statement-copy { gap:16px; }
    .issue-statement-copy > p { font-size:.9rem; line-height:1.72; }
    .archive-note { grid-template-columns:1fr; gap:8px; }
    .issue-work { padding:44px 0; }
    .issue-work-caption { flex-direction:column; align-items:flex-start; }
    .issue-next { grid-template-columns:1fr; }
  }
</style>
