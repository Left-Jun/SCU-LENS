---
import MonthlyIssuePage from "../../components/MonthlyIssuePage.astro";

const base = "/images/monthly-nine/2026-spring-festival";
const viewerItems = [
  { title:"新年", author:"Left-俊", kicker:"单图 · New Spring", src:`${base}/left-jun/new-year-1800.jpg`, original:`${base}/left-jun/new-year-original.jpg`, alt:"《新年》· Left-俊" },
  { title:"东京迷梦", author:"Azp", kicker:"单图 · New Spring", src:`${base}/azp/tokyo-dream-1800.jpg`, original:`${base}/azp/tokyo-dream-original.jpg`, alt:"《东京迷梦》· Azp" },
  ...[
    [6000,4000],[3473,5212],[4000,6000],[2160,3840],[3330,2380]
  ].map((_, i) => {
    const no = String(i + 1).padStart(2,"0");
    return { title:"年味来自醒狮爆竹和烟花", author:"卡乐C", kicker:`组图 · ${no} / 05`, src:`${base}/kale-c/lion-fireworks/${no}-1800.jpg`, original:`${base}/kale-c/lion-fireworks/${no}-original.jpg`, alt:`《年味来自醒狮爆竹和烟花》· ${no} · 卡乐C` };
  }),
];

const works = [
  { no:"01", title:"新年", author:"Left-俊", photoCount:1, viewerIndex:0, browserSrc:`${base}/left-jun/new-year-1800.jpg`, browserSrcset:`${base}/left-jun/new-year-960.jpg 960w, ${base}/left-jun/new-year-1800.jpg 1620w`, originalSrc:`${base}/left-jun/new-year-original.jpg`, width:1620, height:1080 },
  { no:"02", title:"东京迷梦", author:"Azp", photoCount:1, viewerIndex:1, browserSrc:`${base}/azp/tokyo-dream-1800.jpg`, browserSrcset:`${base}/azp/tokyo-dream-960.jpg 960w, ${base}/azp/tokyo-dream-1800.jpg 1800w`, originalSrc:`${base}/azp/tokyo-dream-original.jpg`, width:3845, height:5768 },
  { no:"03", title:"年味来自醒狮爆竹和烟花", author:"卡乐C", photoCount:5, viewerIndex:2, browserSrc:`${base}/kale-c/lion-fireworks/01-1800.jpg`, browserSrcset:`${base}/kale-c/lion-fireworks/01-960.jpg 960w, ${base}/kale-c/lion-fireworks/01-1800.jpg 1800w`, originalSrc:`${base}/kale-c/lion-fireworks/01-original.jpg`, width:6000, height:4000, href:"/monthly-nine/2026-spring-festival/lion-fireworks" },
];
const nextPreviewItems = [
  { src:"/images/monthly-nine/2026-blossom/yiwei/spring-blossom-960.jpg", alt:"《春日繁花》· 一尾" },
  { src:"/images/monthly-nine/2026-blossom/tiantian/butterfly-flower/01-960.jpg", alt:"《蝴蝶与花》· 01 · 天天快乐" },
  { src:"/images/monthly-nine/2026-blossom/tiantian/butterfly-flower/02-960.jpg", alt:"《蝴蝶与花》· 02 · 天天快乐" },
];
const summary = [
  "新春，是时空在日历上轻轻翻页的光痕。过去蜷缩成爆竹的余温，未来在碗筷清脆的碰撞声中悄然铺展。",
  "快门是目光的延伸——它不只记录场景，更截取时间流动的姿势。拍下旧联被新桃覆盖时，那道未说出口的、去年的愿望；拍下团圆饭桌上，那双悬在半空、突然懂得了滋味的筷子；拍下所有喧哗边缘的静默：未熄灭的屏幕，欲言又止的窗，以及红灯笼下独自明亮的影子。",
  "这不仅仅是一个节日。这是一次集体的回望与出发，是光线最柔软、最善于显影真相的时刻。",
  "本月，邀请你一同加入这场光的采集：用镜头存留传统崭新的模样，定格每一次离散与重逢之间，那瞬息的、温暖的同步。让画面成为这个春天，你最独特的注解。"
];
---
<MonthlyIssuePage
  title="新春"
  en="NEW SPRING"
  date="2026.01"
  collectionPeriod="2026.01"
  summary={summary}
  works={works}
  viewerItems={viewerItems}
  viewerGroup="spring-festival-2026"
  nextTitle="繁花"
  nextSummary="2026.03 · 下一期以繁花为题，记录春风与花影之间鲜明、热烈又柔软的瞬间。"
  nextHref="/monthly-nine/2026-blossom"
  nextPreviewItems={nextPreviewItems}
/>
