---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const frames = [
  { no:"01", width:2485, height:1600 },
  { no:"02", width:1345, height:1917 },
  { no:"03", width:2400, height:1600 },
  { no:"04", width:1600, height:2400 },
  { no:"05", width:1600, height:2352 },
  { no:"06", width:2341, height:1551 },
  { no:"07", width:2349, height:1566 },
  { no:"08", width:2150, height:1477 },
  { no:"09", width:2382, height:1587 },
].map((frame) => ({ ...frame, browserWidth: Math.min(frame.width, 1800) }));
---
<BaseLayout title="《金黄色的》· 三川 · SCU LENS" active="/monthly-nine">
  <div class="page-shell">
    <section class="page-hero group-hero">
      <div>
        <a class="back-link" href="/monthly-nine/2025-yellow">← 返回「黄色」</a>
        <div class="eyebrow">Monthly Nine · Yellow · Photo Series</div>
        <h1 class="display">金黄色的</h1>
      </div>
      <div class="group-meta">
        <p>摄影 / <strong>三川</strong></p>
        <p>2025 每月九图 · 黄色</p>
        <p>9 张组图</p>
      </div>
    </section>

    <section class="series-grid">
      {frames.map((frame, i) => (
        <figure class:list={["series-frame", frame.height > frame.width ? "portrait" : "landscape"]}>
          <img src={`/images/monthly-nine/2025-yellow/sanchuan/${frame.no}-1800.jpg`} srcset={`/images/monthly-nine/2025-yellow/sanchuan/${frame.no}-960.jpg 960w, /images/monthly-nine/2025-yellow/sanchuan/${frame.no}-1800.jpg ${frame.browserWidth}w`} sizes="(max-width: 700px) 100vw, 58vw" data-browser-src={`/images/monthly-nine/2025-yellow/sanchuan/${frame.no}-1800.jpg`} data-browser-srcset={`/images/monthly-nine/2025-yellow/sanchuan/${frame.no}-960.jpg 960w, /images/monthly-nine/2025-yellow/sanchuan/${frame.no}-1800.jpg ${frame.browserWidth}w`} data-original-src={`/images/monthly-nine/2025-yellow/sanchuan/${frame.no}-original.jpg`} data-loaded-quality="browser" alt={`《金黄色的》· ${frame.no} · 三川`} width={frame.width} height={frame.height} loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "auto"} decoding="async" />
          <figcaption>《金黄色的》· {frame.no}</figcaption>
        </figure>
      ))}
    </section>

    <section class="section series-note">
      <div class="eyebrow">Series View</div>
      <p>月度页保留一张主图作为入口，这里完整展开《金黄色的》的 9 张作品。顶部“图片”开关可在浏览图与原图之间切换。</p>
    </section>
  </div>
</BaseLayout>

<style>
  .group-hero { display:grid; grid-template-columns:1.2fr .8fr; gap:50px; align-items:end; }
  .group-hero h1 { margin-top:18px; font-size:clamp(4.6rem,11vw,9rem); }
  .back-link { display:inline-block; margin-bottom:34px; color:var(--muted); font-size:.82rem; }
  .group-meta { align-self:end; padding-bottom:8px; }
  .group-meta p { margin:8px 0; color:var(--muted); }
  .series-grid { display:grid; grid-template-columns:repeat(12,1fr); grid-auto-flow:dense; gap:42px 16px; padding:20px 0 84px; align-items:start; }
  .series-frame { margin:0; }
  .series-frame.landscape { grid-column:span 7; }
  .series-frame.portrait { grid-column:span 5; }
  .series-frame img { display:block; width:100%; height:auto; border:1px solid var(--line); background:#ddd8ca; }
  figcaption { padding-top:9px; color:var(--muted); font-size:.72rem; }
  .series-note { display:grid; grid-template-columns:.3fr 1fr; gap:30px; }
  .series-note p { margin:0; max-width:700px; color:var(--muted); line-height:1.8; }
  @media (max-width:700px) {
    .group-hero { grid-template-columns:1fr; }
    .series-grid { grid-template-columns:1fr; }
    .series-frame,.series-frame.landscape,.series-frame.portrait { grid-column:1; }
    .series-note { grid-template-columns:1fr; }
  }
</style>
