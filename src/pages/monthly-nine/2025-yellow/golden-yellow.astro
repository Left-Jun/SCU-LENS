---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { authorHref } from "../../../lib/gallery-archive";
import { galleryPhoto, monthlyNinePhotoIds, viewerPhoto } from "../../../lib/monthly-nine";

const ids=monthlyNinePhotoIds.yellow2025;
const frames = ids.sanchuan.map((id,i) => {
  const photo=galleryPhoto(id);
  return { no:String(i+1).padStart(2,"0"), width:photo.width, height:photo.height, src:photo.browserSrc, srcset:photo.browserSrcset, original:photo.original };
});

const galleryItems = [
  viewerPhoto(ids.sebastian,{ title:"金黄芒节", author:"Sebastian", kicker:"单图 · Yellow", alt:"《金黄芒节》· Sebastian" }),
  viewerPhoto(ids.yiwei,{ title:"捕捉阳光", author:"一尾", kicker:"单图 · Yellow", alt:"《捕捉阳光》· 一尾" }),
  ...ids.sanchuan.map((id,i) => ({
    ...viewerPhoto(id),
    title:"金黄色的",
    author:"彡川",
    kicker:`组图 · ${String(i+1).padStart(2,"0")} / 09`,
    alt:`《金黄色的》· ${String(i+1).padStart(2,"0")} · 彡川`,
  })),
];
const nextPreviewItems = [
  { src:galleryPhoto(monthlyNinePhotoIds.springFestival2026.azp).src, alt:"《东京迷梦》· Azp" },
  { src:galleryPhoto(monthlyNinePhotoIds.springFestival2026.kaleC[0]).src, alt:"《年味来自醒狮爆竹和烟花》· 01 · 卡乐C" },
  { src:galleryPhoto(monthlyNinePhotoIds.springFestival2026.kaleC[1]).src, alt:"《年味来自醒狮爆竹和烟花》· 02 · 卡乐C" },
];
---
<BaseLayout title="《金黄色的》· 彡川 · SCU LENS" active="/monthly-nine">
  <div class="page-shell">
    <section class="page-hero group-hero">
      <div>
        <a class="back-link" href="/monthly-nine/2025-yellow">← 返回「黄色」</a>
        <div class="eyebrow">Monthly Nine · Yellow · Photo Series</div>
        <h1 class="display">金黄色的</h1>
      </div>
      <div class="group-meta">
        <p>摄影 / <strong>彡川</strong></p>
        <p>2025.12 每月九图 · 黄色</p>
        <p>9 张组图</p>
      </div>
    </section>

    <section class="series-grid">
      {frames.map((frame, i) => (
        <figure class:list={["series-frame", frame.height > frame.width ? "portrait" : "landscape"]}>
          <a class="series-photo-link" href={frame.original} data-viewer-open={`yellow-2025:${i + 2}`} aria-label={`打开看图：《金黄色的》· ${frame.no}`}>
            <img src={frame.src} srcset={frame.srcset} sizes="(max-width: 700px) 100vw, 58vw" alt={`《金黄色的》· ${frame.no} · 彡川`} width={frame.width} height={frame.height} loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "auto"} decoding="async" />
          </a>
          <figcaption>《金黄色的》· {frame.no}</figcaption>
        </figure>
      ))}
    </section>

    <section class="section series-note">
      <div class="eyebrow">Series View</div>
      <p>《金黄色的》由 9 张照片组成，彡川以连续画面记录「黄色」主题中的秋日光线、银杏与温暖色彩。</p>
    </section>
    <div class="viewer-registry" hidden>
      {galleryItems.map((item, index) => (
        <span
          data-viewer-item
          data-viewer-group="yellow-2025"
          data-viewer-src={item.src}
          data-original-src={item.original}
          data-viewer-alt={item.alt}
          data-viewer-title={item.title}
          data-viewer-author={item.author}
          data-viewer-author-href={authorHref(item.author)}
          data-viewer-kicker={item.kicker}
          data-viewer-issue="每月九图 · 黄色"
          data-viewer-issue-href="/monthly-nine/2025-yellow"
          data-viewer-section={item.section}
          data-viewer-date={item.date}
          data-viewer-original-label="查看高清图 ↗"
          data-next-title={index === galleryItems.length - 1 ? "新春" : undefined}
          data-next-summary={index === galleryItems.length - 1 ? "2026.01 · 下一期主题「新春」。继续浏览旧联、新桃、团圆灯火与新年旅途中的影像记录。" : undefined}
          data-next-href={index === galleryItems.length - 1 ? "/monthly-nine/2026-spring-festival" : undefined}
          data-next-previews={index === galleryItems.length - 1 ? JSON.stringify(nextPreviewItems) : undefined}
        ></span>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .group-hero { display:grid; grid-template-columns:1.2fr .8fr; gap:50px; align-items:end; }
  .group-hero h1 { margin-top:18px; font-size:clamp(4.6rem,11vw,9rem); }
  .back-link { display:inline-block; margin-bottom:34px; color:var(--muted); font-size:.82rem; }
  .group-meta { align-self:end; padding-bottom:8px; }
  .group-meta p { margin:8px 0; color:var(--muted); }
  .series-grid { display:grid; grid-template-columns:repeat(12,1fr); grid-auto-flow:dense; gap:22px 12px; padding:20px 0 84px; align-items:start; }
  .series-frame { margin:0; }
  .series-frame.landscape { grid-column:span 7; }
  .series-frame.portrait { grid-column:span 5; }
  .series-photo-link { display:block; cursor:zoom-in; }
  .series-frame img { display:block; width:100%; height:auto; border:1px solid var(--line); background:#ddd8ca; }
  figcaption { padding-top:6px; color:var(--muted); font-size:.72rem; }
  .series-note { display:grid; grid-template-columns:.3fr 1fr; gap:30px; }
  .series-note p { margin:0; max-width:700px; color:var(--muted); line-height:1.8; }
  @media (max-width:700px) {
    .group-hero { grid-template-columns:1fr; }
    .series-grid { grid-template-columns:1fr; gap:42px 0; }
    figcaption { padding-top:9px; }
    .series-frame,.series-frame.landscape,.series-frame.portrait { grid-column:1; }
    .series-note { grid-template-columns:1fr; }
  }
</style>
