---
import MonthlyIssuePage from "../../components/MonthlyIssuePage.astro";
import { galleryPhoto, monthlyNinePhotoIds, viewerPhoto } from "../../lib/monthly-nine";
const ids=monthlyNinePhotoIds.jianganGreen2026;
const duck=galleryPhoto(ids.sebastian);
const lotus=galleryPhoto(ids.ze);
const daisy=galleryPhoto(ids.donglin);
const viewerItems=[
  viewerPhoto(ids.sebastian,{title:"浮鸭戏芳华",author:"Sebastian",kicker:"单图 · Jiang'an Green",alt:"《浮鸭戏芳华》· Sebastian"}),
  viewerPhoto(ids.ze,{title:"荷风满塘",author:"宫保鸡丁",kicker:"单图 · Jiang'an Green",alt:"《荷风满塘》· 宫保鸡丁"}),
  viewerPhoto(ids.donglin,{title:"清新脱俗小雏菊",author:"冬淋",kicker:"单图 · Jiang'an Green",alt:"《清新脱俗小雏菊》· 冬淋"}),
];
const works=[
  {no:"01",title:"浮鸭戏芳华",author:"Sebastian",photoCount:1,viewerIndex:0,browserSrc:duck.browserSrc,browserSrcset:duck.browserSrcset,originalSrc:duck.original,width:duck.width,height:duck.height},
  {no:"02",title:"荷风满塘",author:"宫保鸡丁",photoCount:1,viewerIndex:1,browserSrc:lotus.browserSrc,browserSrcset:lotus.browserSrcset,originalSrc:lotus.original,width:lotus.width,height:lotus.height},
  {no:"03",title:"清新脱俗小雏菊",author:"冬淋",photoCount:1,viewerIndex:2,browserSrc:daisy.browserSrc,browserSrcset:daisy.browserSrcset,originalSrc:daisy.original,width:daisy.width,height:daisy.height},
];
const summary=[
  "春风退场，江安被层层叠叠的绿意拥入怀中。湖畔垂柳铺展浓荫，红砖楼宇隐在繁茂草木之间，湖光映着满校园深浅不一的青碧，风穿过教学楼与林荫小道，把江安独有的温柔绿意吹遍每个角落。",
  "不必奔赴远方，眼底即是盛景。用镜头收藏漫天青绿，留住校园最治愈的夏日风光。",
  "——四川大学摄影协会五月「江安青绿」每月九图。以绿意寄温柔，以镜头赴热爱，这一期留下了属于川大江安的夏日绿意。"
];
---
<MonthlyIssuePage
  title="江安青绿" en="JIANG'AN GREEN" date="2026.05—07" collectionPeriod="2026.05.20—06.20"
  summary={summary} works={works} viewerItems={viewerItems} viewerGroup="jiang-an-green-2026"
  nextTitle="已至最新一期" nextSummary="回到历期总览，查看每一期的主题与入选作品。" nextHref="/monthly-nine"
/>
