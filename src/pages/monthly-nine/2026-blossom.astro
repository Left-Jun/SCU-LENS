---
import MonthlyIssuePage from "../../components/MonthlyIssuePage.astro";
import { galleryPhoto, monthlyNinePhotoIds, viewerPhoto } from "../../lib/monthly-nine";
const ids=monthlyNinePhotoIds.blossom2026;
const butterfly=ids.tiantian.map((id)=>galleryPhoto(id));
const shadowless=galleryPhoto(ids.sebastian);
const springBlossom=galleryPhoto(ids.yiwei);
const viewerItems = [
  viewerPhoto(ids.tiantian[0],{ title:"蝴蝶与花", author:"天天快乐", kicker:"组图 · 01 / 02", alt:"《蝴蝶与花》· 01 · 天天快乐" }),
  viewerPhoto(ids.tiantian[1],{ title:"蝴蝶与花", author:"天天快乐", kicker:"组图 · 02 / 02", alt:"《蝴蝶与花》· 02 · 天天快乐" }),
  viewerPhoto(ids.sebastian,{ title:"无影堂下花隐无", author:"Sebastian", kicker:"单图 · Blossom", alt:"《无影堂下花隐无》· Sebastian" }),
  viewerPhoto(ids.yiwei,{ title:"春日繁花", author:"一尾", kicker:"单图 · Blossom", alt:"《春日繁花》· 一尾" }),
];
const works = [
  { no:"01", title:"蝴蝶与花", author:"天天快乐", photoCount:2, viewerIndex:0, browserSrc:butterfly[0].browserSrc, browserSrcset:butterfly[0].browserSrcset, originalSrc:butterfly[0].original, width:butterfly[0].width, height:butterfly[0].height, href:"/monthly-nine/2026-blossom/butterfly-flower" },
  { no:"02", title:"无影堂下花隐无", author:"Sebastian", photoCount:1, viewerIndex:2, browserSrc:shadowless.browserSrc, browserSrcset:shadowless.browserSrcset, originalSrc:shadowless.original, width:shadowless.width, height:shadowless.height },
  { no:"03", title:"春日繁花", author:"一尾", photoCount:1, viewerIndex:3, browserSrc:springBlossom.browserSrc, browserSrcset:springBlossom.browserSrcset, originalSrc:springBlossom.original, width:springBlossom.width, height:springBlossom.height },
];
const nextPreviewItems = [
  { src:galleryPhoto(monthlyNinePhotoIds.jianganGreen2026.ze).src, alt:"《荷风满塘》· 宫保鸡丁" },
];
const summary = [
  "花开，是春天写给人间的温柔信笺。快门，是我们与繁花相遇的印记。",
  "枝头初绽的期待、风拂花瓣的轻盈、光影里最动人的春色，都被收入这一期的镜头之中。这不止是照片，也是我们用影像收藏下来的春天。"
];
---
<MonthlyIssuePage
  title="繁花" en="BLOSSOM" date="2026.03" collectionPeriod="2026.03.15—04.15"
  summary={summary}
  works={works} viewerItems={viewerItems} viewerGroup="blossom-2026"
  nextTitle="江安青绿"
  nextSummary="2026.05—07 · 下一期「江安青绿」，记录湖畔垂柳、校园草木与盛夏层层叠叠的绿意。"
  nextHref="/monthly-nine/2026-jiang-an-green"
  nextPreviewItems={nextPreviewItems}
/>
