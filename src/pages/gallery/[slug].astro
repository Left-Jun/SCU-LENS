---
import BaseLayout from "../../layouts/BaseLayout.astro";
import galleryData from "../../data/gallery.generated.json";
import { authorHref, categoryMeta, groupSubmissions } from "../../lib/gallery-archive";

export function getStaticPaths() {
  return ["campus","humanity","urban","nature","portrait","animals"].map((slug) => ({ params:{ slug } }));
}

const { slug } = Astro.params;
const category = categoryMeta[slug];
const works = (galleryData.items as any[])
  .filter((item) => item.category === slug)
  .sort((a, b) => b.date.localeCompare(a.date) || a.filename.localeCompare(b.filename));
const submissions = groupSubmissions(works);

const viewerGroup = `gallery-${slug}`;
const viewerItems = submissions.flatMap((submission) =>
  submission.photos.map((photo) => ({
    src: photo.viewerSrc || photo.src,
    original: photo.originalSrc || photo.src,
    alt: submission.description || `《${submission.title}》· ${submission.author}`,
    title: submission.title,
    author: submission.author,
    description: submission.description,
    kicker: `Works · ${category.en}`,
    issue: `${submission.section} · ${submission.date}`,
    authorHref: authorHref(submission.author),
    photoId: photo.id,
  }))
);
const viewerIndexById = new Map(viewerItems.map((item, index) => [item.photoId, index]));
---
<BaseLayout title={`${category.title} · 作品 · SCU LENS`} active="/gallery">
  <div class="page-shell">
    <section class="page-hero gallery-section-hero">
      <div>
        <a class="back-link" href="/gallery">← 返回作品</a>
        <div class="eyebrow">Works · {category.en}</div>
        <h1 class="display">{category.title}</h1>
      </div>
      <div class="category-intro">
        <p>{category.intro}</p>
        <span>{submissions.length} 组 · {works.length} 张已归档</span>
      </div>
    </section>

    {submissions.length > 0 ? (
      <section class="section work-wall" aria-label={`${category.title}作品`}>
        {submissions.map((submission) => (
          <article class="archive-work-card">
            <header class="archive-work-heading">
              <h2>{submission.title}</h2>
              <time datetime={submission.date}>{submission.date}</time>
            </header>

            <div class:list={["archive-work-media", { "is-album": submission.photos.length > 1 }]}>
              {submission.photos.map((photo, index) => (
                <a
                  class="archive-image-link"
                  href={photo.originalSrc || photo.src}
                  data-viewer-open={`${viewerGroup}:${viewerIndexById.get(photo.id) ?? 0}`}
                  aria-label={`查看《${submission.title}》${submission.photos.length > 1 ? `第 ${index + 1} 张` : ""}`}
                >
                  <img
                    src={photo.src}
                    srcset={photo.srcset}
                    sizes="(max-width: 700px) 100vw, (max-width: 980px) 50vw, 33vw"
                    alt={submission.description || `《${submission.title}》· ${submission.author}`}
                    width={photo.width}
                    height={photo.height}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ))}
            </div>

            <div class="archive-work-copy">
              {submission.description && <p class="archive-work-description">{submission.description}</p>}
              <div class="archive-work-byline">
                <a class="archive-work-author" href={authorHref(submission.author)}>{submission.author}</a>
                <div class="archive-work-tags">
                  <span>{submission.section}</span>
                  {submission.monthlyNine && (
                    <a href={submission.monthlyNine.href}>每月九图 · {submission.monthlyNine.issue} →</a>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </section>
    ) : (
      <section class="section empty-state">
        <p>这一分类暂时还没有完成归档的作品。</p>
      </section>
    )}

    <div class="viewer-registry" hidden>
      {viewerItems.map((item) => (
        <span
          data-viewer-item
          data-viewer-group={viewerGroup}
          data-viewer-src={item.src}
          data-original-src={item.original}
          data-viewer-alt={item.alt}
          data-viewer-title={item.title}
          data-viewer-author={item.author}
          data-viewer-author-href={item.authorHref}
          data-viewer-description={item.description}
          data-viewer-kicker={item.kicker}
          data-viewer-issue={item.issue}
          data-viewer-original-label="查看高清图 ↗"
        ></span>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .back-link { display:inline-block; margin-bottom:26px; color:var(--muted); font-size:.82rem; }
  .category-intro { align-self:end; }
  .category-intro p { margin:0; max-width:620px; color:var(--muted); line-height:var(--line-body); }
  .category-intro span { display:block; margin-top:12px; color:var(--muted); font-size:.72rem; letter-spacing:.06em; }

  .work-wall { columns:3; column-gap:18px; padding-top:14px; }
  .archive-work-card { break-inside:avoid; margin:0 0 34px; border-bottom:1px solid var(--line); padding-bottom:24px; }
  .archive-work-heading { display:flex; justify-content:space-between; align-items:baseline; gap:16px; margin:0 0 11px; }
  .archive-work-heading h2 { margin:0; min-width:0; font:600 1rem/1.3 var(--font-sans); letter-spacing:-.012em; }
  .archive-work-heading time { flex:0 0 auto; color:var(--muted); font-size:.68rem; font-variant-numeric:tabular-nums; }
  .archive-work-media { display:grid; gap:8px; }
  .archive-image-link { display:block; background:var(--panel); overflow:hidden; }
  .archive-image-link img { display:block; width:100%; height:auto; transition:transform .28s ease, filter .28s ease; }
  .archive-image-link:hover img { transform:scale(1.008); filter:saturate(1.04); }
  .archive-work-copy { padding-top:12px; }
  .archive-work-description { margin:0 0 12px; color:var(--muted); font-size:.8rem; line-height:1.68; white-space:pre-line; }
  .archive-work-byline { display:flex; justify-content:space-between; gap:16px; align-items:center; }
  .archive-work-author { min-width:0; font-size:.84rem; font-weight:600; border-bottom:1px solid transparent; }
  .archive-work-author:hover { border-bottom-color:currentColor; }
  .archive-work-tags { margin-left:auto; display:flex; justify-content:flex-end; flex-wrap:wrap; gap:6px 8px; align-items:center; }
  .archive-work-tags span,
  .archive-work-tags a { border:1px solid var(--line); padding:4px 7px; font-size:.62rem; line-height:1; }
  .archive-work-tags a { background:var(--ink); color:var(--paper); border-color:var(--ink); }
  .empty-state { border-top:1px solid var(--line); color:var(--muted); }

  @media (max-width:980px) {
    .work-wall { columns:2; }
  }
  @media (max-width:700px) {
    .work-wall { columns:1; column-gap:0; padding-top:14px; }
    .archive-work-card { margin-bottom:24px; padding-bottom:18px; }
    .archive-work-heading { margin:0 0 10px; align-items:baseline; }
    .archive-work-heading h2 { font-size:1rem; line-height:1.22; }
    .archive-work-heading time { font-size:.72rem; }
    .archive-work-media { gap:10px; }
    .archive-work-copy { padding-top:10px; }
    .archive-work-description { margin:0 0 10px; font-size:.82rem; line-height:1.65; }
    .archive-work-byline { align-items:center; gap:10px; }
    .archive-work-author { font-size:.88rem; }
    .archive-work-tags { gap:6px; }
  }
</style>
