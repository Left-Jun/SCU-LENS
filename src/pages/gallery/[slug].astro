---
import BaseLayout from "../../layouts/BaseLayout.astro";
import galleryData from "../../data/gallery.generated.json";

const categories = {
  campus: { title:"校园", en:"Campus", intro:"校园空间、日常、植物、建筑与季节变化中的影像。" },
  humanity: { title:"人文", en:"Humanity", intro:"人与环境、生活方式、事件、习俗与文化场景中的真实片段。" },
  urban: { title:"城市", en:"Urban", intro:"街道、建筑、夜色、交通与城市生活留下的切片。" },
  nature: { title:"自然", en:"Nature", intro:"风景、植物、山水、季节与自然环境中的光线和变化。" },
  portrait: { title:"人像", en:"Portrait", intro:"人物、姿态、表情，以及人与镜头之间的关系。" },
  animals: { title:"动物", en:"Animals", intro:"鸟类、昆虫、校园动物、宠物与其他生命的瞬间。" },
};

export function getStaticPaths() {
  return ["campus","humanity","urban","nature","portrait","animals"].map((slug) => ({ params:{ slug } }));
}

const { slug } = Astro.params;
const category = categories[slug];
const works = galleryData.items
  .filter((item) => item.category === slug)
  .sort((a, b) => b.date.localeCompare(a.date) || a.filename.localeCompare(b.filename));
---
<BaseLayout title={`${category.title} · 作品 · SCU LENS`} active="/gallery">
  <div class="page-shell">
    <section class="page-hero gallery-section-hero">
      <div>
        <a class="back-link" href="/gallery">← 返回作品</a>
        <div class="eyebrow">Works · {category.en}</div>
        <h1 class="display">{category.title}</h1>
      </div>
      <div class="category-intro">
        <p>{category.intro}</p>
        <span>{works.length} 张已归档 · 人工分类</span>
      </div>
    </section>

    {works.length > 0 ? (
      <section class="section work-wall" aria-label={`${category.title}作品`}>
        {works.map((work) => (
          <article class="archive-work-card">
            <a class="archive-image-link" href={work.src} target="_blank" rel="noreferrer" aria-label={`查看 ${work.author} 的作品`}>
              <img src={work.src} alt={work.description || `${work.author} 的摄影作品`} loading="lazy" decoding="async" />
            </a>
            <div class="archive-work-copy">
              <div class="archive-work-topline">
                <strong>{work.author}</strong>
                <time datetime={work.date}>{work.date}</time>
              </div>
              {work.description && <p>{work.description}</p>}
              <div class="archive-work-tags">
                <span>{work.section}</span>
                {work.monthlyNine && (
                  <a href={work.monthlyNine.href}>每月九图 · {work.monthlyNine.issue} →</a>
                )}
              </div>
            </div>
          </article>
        ))}
      </section>
    ) : (
      <section class="section empty-state">
        <p>这一分类暂时还没有完成归档的作品。</p>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .back-link { display:inline-block; margin-bottom:26px; color:var(--muted); font-size:.82rem; }
  .category-intro { align-self:end; }
  .category-intro p { margin:0; max-width:620px; color:var(--muted); line-height:var(--line-body); }
  .category-intro span { display:block; margin-top:12px; color:var(--muted); font-size:.72rem; letter-spacing:.06em; }

  .work-wall { columns:3; column-gap:18px; padding-top:0; }
  .archive-work-card { break-inside:avoid; margin:0 0 34px; border-top:1px solid var(--line); padding-top:12px; }
  .archive-image-link { display:block; background:var(--panel); overflow:hidden; }
  .archive-image-link img { display:block; width:100%; height:auto; transition:transform .28s ease, filter .28s ease; }
  .archive-image-link:hover img { transform:scale(1.008); filter:saturate(1.04); }
  .archive-work-copy { padding-top:11px; }
  .archive-work-topline { display:flex; justify-content:space-between; gap:14px; align-items:baseline; }
  .archive-work-topline strong { font-size:.88rem; }
  .archive-work-topline time { color:var(--muted); font-size:.68rem; font-variant-numeric:tabular-nums; }
  .archive-work-copy > p { margin:8px 0 0; color:var(--muted); font-size:.8rem; line-height:1.62; white-space:pre-line; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:4; overflow:hidden; }
  .archive-work-tags { display:flex; flex-wrap:wrap; gap:6px 8px; margin-top:10px; align-items:center; }
  .archive-work-tags span,
  .archive-work-tags a { border:1px solid var(--line); padding:4px 7px; font-size:.62rem; line-height:1; }
  .archive-work-tags a { background:var(--ink); color:var(--paper); border-color:var(--ink); }
  .empty-state { border-top:1px solid var(--line); color:var(--muted); }

  @media (max-width:980px) {
    .work-wall { columns:2; }
  }
  @media (max-width:700px) {
    .work-wall { columns:1; column-gap:0; }
    .archive-work-card { margin-bottom:30px; }
  }
</style>
