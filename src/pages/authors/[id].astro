---
import BaseLayout from "../../layouts/BaseLayout.astro";
import galleryData from "../../data/gallery.generated.json";
import { authorHref, authorId, categoryMeta, groupSubmissions } from "../../lib/gallery-archive";

export function getStaticPaths() {
  const authors = [...new Set((galleryData.items as any[]).map((item) => item.author).filter(Boolean))];
  return authors.map((author) => ({ params: { id: authorId(author) }, props: { author } }));
}

const { author } = Astro.props;
const id = authorId(author);
const works = (galleryData.items as any[])
  .filter((item) => item.author === author)
  .sort((a, b) => b.date.localeCompare(a.date) || a.filename.localeCompare(b.filename));
const submissions = groupSubmissions(works);
const viewerGroup = `author-${id}`;
const viewerItems = submissions.flatMap((submission) =>
  submission.photos.map((photo) => ({
    src: photo.viewerSrc || photo.src,
    original: photo.originalSrc || photo.src,
    alt: submission.description || `《${submission.title}》· ${author}`,
    title: submission.title,
    author,
    description: submission.description,
    kicker: "Author Archive · 作者档案",
    issue: `${submission.section} · ${submission.date}`,
    photoId: photo.id,
  }))
);
const viewerIndexById = new Map(viewerItems.map((item, index) => [item.photoId, index]));
---

<BaseLayout title={`${author} · 作者档案 · SCU LENS`} active="/gallery">
  <div class="page-shell">
    <section class="page-hero author-hero">
      <div>
        <a class="back-link" href="/gallery">← 返回作品</a>
        <div class="eyebrow">Author Archive · 作者档案</div>
        <h1 class="display">{author}</h1>
      </div>
      <div class="author-summary">
        <p>按投稿记录整理的个人作品档案。组图保留为同一次投稿，不拆分为独立作品卡片。</p>
        <span>{submissions.length} 组投稿 · {works.length} 张照片</span>
      </div>
    </section>

    <section class="section author-work-wall" aria-label={`${author} 的作品`}>
      {submissions.map((submission) => (
        <article class="author-work-card">
          <header class="author-work-heading">
            <h2>{submission.title}</h2>
            <time datetime={submission.date}>{submission.date}</time>
          </header>

          <div class:list={["author-work-media", { "is-album": submission.photos.length > 1 }]}>
            {submission.photos.map((photo, index) => (
              <a
                class="author-image-link"
                href={photo.originalSrc || photo.src}
                data-viewer-open={`${viewerGroup}:${viewerIndexById.get(photo.id) ?? 0}`}
                aria-label={`查看《${submission.title}》${submission.photos.length > 1 ? `第 ${index + 1} 张` : ""}`}
              >
                <img
                  src={photo.src}
                  srcset={photo.srcset}
                  sizes="(max-width: 700px) 100vw, (max-width: 980px) 50vw, 33vw"
                  alt={submission.description || `《${submission.title}》· ${author}`}
                  width={photo.width}
                  height={photo.height}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ))}
          </div>

          <div class="author-work-copy">
            {submission.description && <p class="author-work-description">{submission.description}</p>}
            <div class="author-work-footer">
              <div class="author-work-categories">
                {submission.categories.map((category) => (
                  <a href={`/gallery/${category}`}>{categoryMeta[category]?.title || category}</a>
                ))}
              </div>
              <div class="author-work-tags">
                <span>{submission.section}</span>
                {submission.monthlyNine && (
                  <a href={submission.monthlyNine.href}>每月九图 · {submission.monthlyNine.issue} →</a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </section>

    <div class="viewer-registry" hidden>
      {viewerItems.map((item) => (
        <span
          data-viewer-item
          data-viewer-group={viewerGroup}
          data-viewer-src={item.src}
          data-original-src={item.original}
          data-viewer-alt={item.alt}
          data-viewer-title={item.title}
          data-viewer-author={item.author}
          data-viewer-author-href={authorHref(item.author)}
          data-viewer-description={item.description}
          data-viewer-kicker={item.kicker}
          data-viewer-issue={item.issue}
          data-viewer-original-label="查看高清图 ↗"
        ></span>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .back-link { display:inline-block; margin-bottom:26px; color:var(--muted); font-size:.82rem; }
  .author-summary { align-self:end; }
  .author-summary p { margin:0; max-width:620px; color:var(--muted); line-height:var(--line-body); }
  .author-summary span { display:block; margin-top:12px; color:var(--muted); font-size:.72rem; letter-spacing:.06em; }
  .author-work-wall { columns:3; column-gap:18px; padding-top:14px; }
  .author-work-card { break-inside:avoid; margin:0 0 34px; border-bottom:1px solid var(--line); padding-bottom:24px; }
  .author-work-heading { display:flex; justify-content:space-between; align-items:baseline; gap:16px; margin:0 0 11px; }
  .author-work-heading h2 { margin:0; min-width:0; font:600 1rem/1.3 var(--font-sans); letter-spacing:-.012em; }
  .author-work-heading time { flex:0 0 auto; color:var(--muted); font-size:.68rem; font-variant-numeric:tabular-nums; }
  .author-work-media { display:grid; gap:8px; }
  .author-image-link { display:block; background:var(--panel); overflow:hidden; }
  .author-image-link img { display:block; width:100%; height:auto; transition:transform .28s ease, filter .28s ease; }
  .author-image-link:hover img { transform:scale(1.008); filter:saturate(1.04); }
  .author-work-copy { padding-top:12px; }
  .author-work-description { margin:0 0 12px; color:var(--muted); font-size:.8rem; line-height:1.68; white-space:pre-line; }
  .author-work-footer { display:flex; justify-content:space-between; gap:16px; align-items:center; }
  .author-work-categories,.author-work-tags { display:flex; flex-wrap:wrap; gap:6px 8px; align-items:center; }
  .author-work-tags { margin-left:auto; justify-content:flex-end; }
  .author-work-categories a { font-size:.7rem; font-weight:600; border-bottom:1px solid var(--line); padding-bottom:2px; }
  .author-work-tags span,.author-work-tags a { border:1px solid var(--line); padding:4px 7px; font-size:.62rem; line-height:1; }
  .author-work-tags a { background:var(--ink); color:var(--paper); border-color:var(--ink); }

  @media (max-width:980px) { .author-work-wall { columns:2; } }
  @media (max-width:700px) {
    .author-work-wall { columns:1; column-gap:0; padding-top:14px; }
    .author-work-card { margin-bottom:24px; padding-bottom:18px; }
    .author-work-heading { margin:0 0 10px; }
    .author-work-heading h2 { font-size:1rem; line-height:1.22; }
    .author-work-heading time { font-size:.72rem; }
    .author-work-media { gap:10px; }
    .author-work-copy { padding-top:10px; }
    .author-work-description { margin:0 0 10px; font-size:.82rem; line-height:1.65; }
    .author-work-footer { gap:10px; align-items:center; }
  }
</style>
