---
import BaseLayout from "../layouts/BaseLayout.astro";

const upcoming = [
  ["2026 · 10 月中旬","百团大战","线下社团展示、现场交流与新学年集中招新入口。具体日期、摊位与现场安排以当期通知为准。","近期"],
  ["百团大战后","新一轮大规模招新","面向技术部、活动部和宣传部的新一轮集中招募。报名、沟通与后续安排会同步发布。","招新"],
];

const archive = [
  ["2026.09","新学年 · 摄协重新出发","迎新、组织调整与新一届工作的开始。","记录"],
  ["2025–26","年度活动档案","讲座、外拍、摄影比赛与成员共同经历留下的年度记录。","归档"],
];
---
<BaseLayout title="活动 · SCU LENS" active="/events">
  <div class="page-shell">
    <section class="page-hero">
      <div class="eyebrow">Events & Field Notes</div>
      <h1 class="display">活动</h1>
      <p>讲座、外拍、比赛与共同经历，都在这里留下现场、照片与故事。</p>
    </section>
    <section class="section event-group" id="upcoming">
      <div class="event-section-head">
        <div class="event-section-title">
          <div class="eyebrow">Upcoming</div>
          <h2>近期活动</h2>
        </div>
        <p>接下来会发生的活动与集中招募节点。</p>
      </div>
      <div class="timeline">
        {upcoming.map(([date,title,desc,tag]) => (
          <article>
            <div class="timeline-meta"><time>{date}</time><span class="tag">{tag}</span></div>
            <div><h2>{title}</h2><p>{desc}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="section event-group monthly-status-group" id="monthly-nine-status">
      <div class="monthly-status-card">
        <div class="monthly-status-copy">
          <div class="eyebrow">Monthly Nine Status</div>
          <span class="monthly-status-mark">PREPARING</span>
          <h2>新一轮主题正在准备中</h2>
          <p>上一期「江安青绿」已完成归档。下一轮主题公布后，这里会直接显示主题名与征集状态。</p>
          <div class="monthly-status-actions">
            <a href="/monthly-nine/2026-jiang-an-green">查看上一期 ↗</a>
          </div>
        </div>
        <div class="ongoing-inline">
          <div>
            <span class="eyebrow">Ongoing</span>
            <h3>日常投稿与作品收录</h3>
          </div>
          <p>相机、手机与胶片作品都可以在频道持续投稿，精选作品会进入网站作品库与专题。</p>
          <a href="/submit">投稿入口 ↗</a>
        </div>
      </div>
    </section>

    <section class="section event-group">
      <div class="event-section-head">
        <div class="event-section-title">
          <div class="eyebrow">Archive</div>
          <h2>过去记录</h2>
        </div>
        <p>已经发生的活动会逐步沉淀为照片、文字与年度档案。</p>
      </div>
      <div class="timeline">
        {archive.map(([date,title,desc,tag]) => (
          <article>
            <div class="timeline-meta"><time>{date}</time><span class="tag">{tag}</span></div>
            <div><h2>{title}</h2><p>{desc}</p></div>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
