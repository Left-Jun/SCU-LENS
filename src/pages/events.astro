---
import BaseLayout from "../layouts/BaseLayout.astro";
const events = [
  ["2026.09","新学年 · 摄协重新出发","招新、迎新与新一届组织工作的开始。","本学期"],
  ["2026","风光摄影讲座","围绕风光摄影的观察、拍摄与后期展开的交流活动。","讲座"],
  ["2025–26","年度活动档案","讲座、外拍、摄影比赛与成员共同经历留下的年度记录。","归档"],
];
---
<BaseLayout title="活动 · SCU LENS" active="/events">
  <div class="page-shell">
    <section class="page-hero">
      <div class="eyebrow">Events & Field Notes</div>
      <h1 class="display">活动</h1>
      <p>讲座、外拍、比赛与共同经历，都在这里留下现场、照片与故事。</p>
    </section>
    <section class="section timeline">
      {events.map(([date,title,desc,tag]) => (
        <article>
          <time>{date}</time>
          <div><h2>{title}</h2><p>{desc}</p></div>
          <span class="tag">{tag}</span>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>
