---
import BaseLayout from "../layouts/BaseLayout.astro";

const upcoming = [
  ["2026 · 10 月中旬","百团大战","线下社团展示、现场交流与新学年集中招新入口。具体日期、摊位与现场安排以当期通知为准。","近期"],
  ["百团大战后","新一轮大规模招新","面向技术部、活动部和宣传部的新一轮集中招募。报名、沟通与后续安排会同步发布。","招新"],
];

const ongoing = [
  ["持续进行","日常投稿与作品收录","相机、手机与胶片作品都可以在频道持续投稿，精选作品会进入网站作品库与专题。","投稿"],
];

const archive = [
  ["2026.09","新学年 · 摄协重新出发","迎新、组织调整与新一届工作的开始。","记录"],
  ["2025–26","年度活动档案","讲座、外拍、摄影比赛与成员共同经历留下的年度记录。","归档"],
];
---
<BaseLayout title="活动 · SCU LENS" active="/events">
  <div class="page-shell">
    <section class="page-hero">
      <div class="eyebrow">Events & Field Notes</div>
      <h1 class="display">活动</h1>
      <p>讲座、外拍、比赛与共同经历，都在这里留下现场、照片与故事。</p>
    </section>
    <section class="section event-group" id="upcoming">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Upcoming</div>
          <h2 class="section-display">近期活动</h2>
        </div>
        <p>接下来真正会发生的活动与集中招募节点，具体活动本身优先于分类标签。</p>
      </div>
      <div class="timeline">
        {upcoming.map(([date,title,desc,tag]) => (
          <article>
            <time>{date}</time>
            <div><h2>{title}</h2><p>{desc}</p></div>
            <span class="tag">{tag}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="section event-group monthly-status-group" id="monthly-nine-status">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Monthly Nine · Status</div>
          <h2 class="section-display">每月九图</h2>
        </div>
        <p>这里不重复做一期图集，而是记录当前这一轮处在哪个阶段。</p>
      </div>
      <div class="monthly-status-row">
        <span class="monthly-status-mark">PREPARING</span>
        <div>
          <h2>新一轮主题正在准备中</h2>
          <p>上一期「江安青绿」已完成归档。下一轮主题公布后，这里会切换为“主题名 + 正在征集中”，并开放投稿快捷入口。</p>
        </div>
        <a href="/monthly-nine/2026-jiang-an-green">查看上一期 ↗</a>
      </div>
    </section>

    <section class="section event-group" id="ongoing">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Ongoing</div>
          <h2 class="section-display">长期项目</h2>
        </div>
        <p>除每月九图外，持续发生、持续积累的日常项目。</p>
      </div>
      <div class="timeline">
        {ongoing.map(([date,title,desc,tag]) => (
          <article>
            <time>{date}</time>
            <div><h2>{title}</h2><p>{desc}</p></div>
            <span class="tag">{tag}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="section event-group">
      <div class="section-kicker-row">
        <div>
          <div class="eyebrow">Archive</div>
          <h2 class="section-display">过去记录</h2>
        </div>
        <p>已经发生的活动会逐步沉淀为照片、文字与年度档案。</p>
      </div>
      <div class="timeline">
        {archive.map(([date,title,desc,tag]) => (
          <article>
            <time>{date}</time>
            <div><h2>{title}</h2><p>{desc}</p></div>
            <span class="tag">{tag}</span>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
