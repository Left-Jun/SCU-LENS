---
import GalleryImage from "./GalleryImage.astro";
import type { GuangyingPhoto } from "../lib/guangying-exhibitions";
interface Props { photos: GuangyingPhoto[]; preview?: boolean; compact?: boolean; groupId?: string; allHref?: string; }
const { photos, preview=false, compact=false, groupId="guangying-featured", allHref="/guangying-chuanda/album" }=Astro.props;
const label=(p:GuangyingPhoto)=>[p.title,p.author].filter(Boolean).join(" · ")||"光影川大往期影像";
---
{photos.length ? <div class:list={["image-showcase",{compact}]} data-showcase data-count={photos.length}>
  {preview && <p class="preview-note">展示图片暂作版式预览，精选作品后续更新</p>}
  <div class="showcase-stage" tabindex={photos.length>1?0:undefined} role="region" aria-label="影像展示，使用左右键切换">
    {photos.map((photo,index)=><a hidden={index!==0} class="showcase-image" data-showcase-image href={photo.originalSrc} data-viewer-open={`${groupId}:${index}`} aria-label={`放大照片：${label(photo)}`}>
      <GalleryImage photo={photo} alt={label(photo)} sizes={compact?"(max-width:700px) calc(100vw - 40px), 740px":"(max-width:1220px) calc(100vw - 40px), 1180px"} priority={compact&&index===0}/>
    </a>)}
  </div>
  <div class="showcase-bar">
    <div class="showcase-caption">{photos.map((photo,index)=><span data-showcase-caption hidden={index!==0}>{photo.captionInImage?"":label(photo)}</span>)}</div>
    <div class="showcase-actions"><span data-showcase-count>01 / {String(photos.length).padStart(2,"0")}</span>{photos.length>1&&<button type="button" data-showcase-pause aria-label="暂停自动切换" aria-pressed="false">暂停</button>}</div>
  </div>
  {!compact&&<>
    {photos.length>1&&<div class="showcase-thumbs" aria-label="选择展示照片">{photos.map((photo,index)=><button type="button" data-showcase-thumb aria-label={`查看第 ${index+1} 张：${label(photo)}`} aria-pressed={index===0?"true":"false"}><GalleryImage photo={photo} alt="" sizes="180px"/><span>{String(index+1).padStart(2,"0")}</span></button>)}</div>}
    <div class="showcase-footer"><span>点击大图，放大欣赏</span><a class="text-link" href={allHref}>查看全部 →</a></div>
  </>}
  <div hidden>{photos.map(photo=><span data-viewer-item data-viewer-group={groupId} data-viewer-src={photo.viewerSrc} data-original-src={photo.originalSrc} data-viewer-alt={label(photo)} data-viewer-title={photo.title} data-viewer-author={photo.author} data-viewer-kicker="光影川大" data-viewer-issue="返回光影川大" data-viewer-issue-href="/guangying-chuanda#awards"/>)}</div>
</div>:<p>往期影像陆续更新。</p>}
<script>
  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach(root=>{
    const images=Array.from(root.querySelectorAll<HTMLElement>('[data-showcase-image]'));
    const captions=Array.from(root.querySelectorAll<HTMLElement>('[data-showcase-caption]'));
    const thumbs=Array.from(root.querySelectorAll<HTMLButtonElement>('[data-showcase-thumb]'));
    const count=root.querySelector<HTMLElement>('[data-showcase-count]');
    const pause=root.querySelector<HTMLButtonElement>('[data-showcase-pause]');
    const reduced=matchMedia('(prefers-reduced-motion: reduce)');
    let active=0,paused=reduced.matches,hover=false,visible=false;
    const show=(index:number)=>{
      active=(index+images.length)%images.length;
      images.forEach((image,i)=>image.hidden=i!==active);
      captions.forEach((caption,i)=>caption.hidden=i!==active);
      thumbs.forEach((thumb,i)=>thumb.setAttribute('aria-pressed',String(i===active)));
      if(count)count.textContent=`${String(active+1).padStart(2,'0')} / ${String(images.length).padStart(2,'0')}`;
    };
    const syncPause=()=>{if(pause){pause.textContent=paused?'播放':'暂停';pause.setAttribute('aria-label',paused?'播放自动切换':'暂停自动切换');pause.setAttribute('aria-pressed',String(paused));}};
    let timer:ReturnType<typeof setInterval>;
    const restart=()=>{clearInterval(timer);if(images.length>1)timer=setInterval(()=>{if(!paused&&!hover&&visible&&!document.hidden&&!root.contains(document.activeElement)&&!document.documentElement.classList.contains('viewer-open'))show(active+1);},7000);};
    thumbs.forEach((thumb,i)=>thumb.addEventListener('click',()=>{show(i);restart();}));
    root.querySelector('.showcase-stage')?.addEventListener('keydown',event=>{const key=(event as KeyboardEvent).key;if(!document.documentElement.classList.contains('viewer-open')&&(key==='ArrowLeft'||key==='ArrowRight')){event.preventDefault();show(active+(key==='ArrowRight'?1:-1));restart();}});
    pause?.addEventListener('click',()=>{paused=!paused;syncPause();restart();});
    root.addEventListener('mouseenter',()=>hover=true);root.addEventListener('mouseleave',()=>hover=false);
    new IntersectionObserver(entries=>visible=entries[0].isIntersecting).observe(root);
    reduced.addEventListener('change',()=>{paused=reduced.matches;syncPause();});
    syncPause();restart();
  });
</script>
<style>
  .image-showcase{min-width:0}.preview-note{margin:0 0 20px;font-size:12px;color:var(--muted)}
  .showcase-stage{position:relative;aspect-ratio:3/2;background:rgba(0,0,0,.025)}
  .showcase-image{display:block;width:100%;height:100%;cursor:zoom-in}.showcase-image[hidden],[data-showcase-caption][hidden]{display:none}
  .showcase-image :global(picture),.showcase-image :global(img){display:block;width:100%;height:100%;object-fit:cover}
  .showcase-bar{display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:52px;font-size:12px;color:var(--muted)}
  .showcase-actions{display:flex;align-items:center;gap:14px;white-space:nowrap;font-variant-numeric:tabular-nums}.showcase-actions button{border:0;background:none;color:inherit;font:inherit;min-height:44px;min-width:44px;cursor:pointer}
  .showcase-thumbs{display:flex;gap:12px;overflow-x:auto;padding:3px 0 10px;scrollbar-width:thin}
  .showcase-thumbs button{position:relative;flex:1 0 calc((100% - 60px)/6);min-width:80px;max-width:200px;aspect-ratio:3/2;padding:0;border:0;background:none;opacity:.5;cursor:pointer;outline-offset:-3px}
  .showcase-thumbs button[aria-pressed="true"]{opacity:1;outline:2px solid var(--ink)}
  .showcase-thumbs :global(picture),.showcase-thumbs :global(img){display:block;width:100%;height:100%;object-fit:cover}
  .showcase-thumbs span{position:absolute;bottom:4px;left:6px;font-size:10px;color:white;background:#2229;padding:2px 4px}
  .showcase-footer{display:flex;justify-content:space-between;align-items:center;margin-top:14px;font-size:12px;color:var(--muted)}.showcase-footer a{display:inline-flex;align-items:center;min-height:44px;color:var(--ink)}
  button:focus-visible,a:focus-visible,.showcase-stage:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
  .compact .showcase-bar{font-size:11px}.compact .showcase-caption{min-width:0}
  @media(max-width:700px){.showcase-thumbs{gap:8px}.showcase-thumbs button{flex:0 0 24%;min-width:64px}.showcase-bar{gap:8px;font-size:11px}.showcase-actions{gap:6px}.showcase-caption{line-height:1.6}}
</style>
