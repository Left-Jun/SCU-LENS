---
import GalleryImage from "./GalleryImage.astro";
import type { GuangyingPhoto } from "../lib/guangying-exhibitions";
interface Props { photos: GuangyingPhoto[]; preview?: boolean; compact?: boolean; sideThumbs?: boolean; groupId?: string; allHref?: string; }
const { photos, preview=false, compact=false, sideThumbs=false, groupId="guangying-featured", allHref="/guangying-chuanda/album" }=Astro.props;
const label=(p:GuangyingPhoto)=>[p.title,p.author].filter(Boolean).join(" · ")||"光影川大往期影像";
---
{photos.length ? <div class:list={["image-showcase",{compact, "side-thumbs":sideThumbs}]} data-showcase data-count={photos.length}>
  {preview && <p class="preview-note">展示图片暂作版式预览，精选作品后续更新</p>}
  <div class="showcase-stage" tabindex={photos.length>1?0:undefined} role="region" aria-label="影像展示，使用左右键切换">
    <div class="showcase-track" data-showcase-track>
    {[...photos, ...(photos.length>1?[photos[0]]:[])].map((photo,index)=><a aria-hidden={index!==0?"true":"false"} tabindex={index!==0?-1:undefined} class="showcase-image" draggable="false" data-showcase-image href={photo.originalSrc} data-viewer-open={`${groupId}:${index%photos.length}`} aria-label={`放大照片：${label(photo)}`}>
      <GalleryImage photo={photo} alt={label(photo)} sizes={compact?"(max-width:700px) calc(100vw - 40px), 740px":"(max-width:1220px) calc(100vw - 40px), 1180px"} priority={compact&&index===0}/>
    </a>)}
    </div>
  </div>
  <div class="showcase-bar">
    <div class="showcase-caption">{photos.map((photo,index)=><span data-showcase-caption hidden={index!==0}>{photo.captionInImage?"":label(photo)}</span>)}</div>
    <div class="showcase-actions"><span data-showcase-count>01 / {String(photos.length).padStart(2,"0")}</span></div>
  </div>
  {!compact&&<>
    {photos.length>1&&<div class="showcase-thumbs" aria-label="选择展示照片">{photos.map((photo,index)=><button type="button" data-showcase-thumb aria-label={`查看第 ${index+1} 张：${label(photo)}`} aria-pressed={index===0?"true":"false"}><GalleryImage photo={photo} alt="" sizes="180px"/></button>)}</div>}
    <div class="showcase-footer"><span>点击大图，放大欣赏</span><a class="text-link" href={allHref}>查看全部 →</a></div>
  </>}
  <div hidden>{photos.map(photo=><span data-viewer-item data-viewer-group={groupId} data-viewer-src={photo.viewerSrc} data-original-src={photo.originalSrc} data-viewer-alt={label(photo)} data-viewer-title={photo.title} data-viewer-author={photo.author} data-viewer-kicker="光影川大" data-viewer-issue="返回光影川大" data-viewer-issue-href={sideThumbs?"/guangying-chuanda#calendar":"/guangying-chuanda#awards"}/>)}</div>
</div>:<p>往期影像陆续更新。</p>}
<script>
  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach(root=>{
    const images=Array.from(root.querySelectorAll<HTMLElement>('[data-showcase-image]'));
    const captions=Array.from(root.querySelectorAll<HTMLElement>('[data-showcase-caption]'));
    const thumbs=Array.from(root.querySelectorAll<HTMLButtonElement>('[data-showcase-thumb]'));
    const count=root.querySelector<HTMLElement>('[data-showcase-count]');
    const track=root.querySelector<HTMLElement>('[data-showcase-track]')!;
    const stage=root.querySelector<HTMLElement>('.showcase-stage');
    const total=Number(root.dataset.count);
    const reduced=matchMedia('(prefers-reduced-motion: reduce)');
    let active=0,position=0,visible=false;
    const prepare=(index:number)=>{
      const image=images[index];
      image?.querySelectorAll<HTMLPictureElement>('picture[data-gallery-lazy="pending"]').forEach(picture=>{
        picture.querySelectorAll<HTMLSourceElement>('source[data-srcset]').forEach(source=>{source.srcset=source.dataset.srcset||'';source.removeAttribute('data-srcset');});
        const img=picture.querySelector<HTMLImageElement>('img[data-src]');
        if(img){img.loading='eager';if(img.dataset.srcset)img.srcset=img.dataset.srcset;img.src=img.dataset.src||'';img.removeAttribute('data-src');img.removeAttribute('data-srcset');}
        picture.dataset.galleryLazy='loaded';
      });
    };
    const move=(index:number,animate=true)=>{
      prepare(index);prepare((index+1)%images.length);
      position=index;
      track.style.transition=animate&&!reduced.matches?'transform 650ms cubic-bezier(.22,.61,.36,1)':'none';
      track.style.transform=`translate3d(${-index*100}%,0,0)`;
      images.forEach((image,i)=>{image.setAttribute('aria-hidden',String(i!==index));image.tabIndex=i===index?0:-1;});
    };
    const revealThumb=()=>{
      const strip=root.querySelector<HTMLElement>('.showcase-thumbs');
      if(strip&&thumbs[active]){
        const vertical=root.classList.contains('side-thumbs');
        strip.scrollTo({left:vertical?0:Math.max(0,thumbs[active].offsetLeft-(strip.clientWidth-thumbs[active].clientWidth)/2),top:vertical?Math.max(0,thumbs[active].offsetTop-(strip.clientHeight-thumbs[active].clientHeight)/2):0,behavior:reduced.matches?'instant':'smooth'});
      }
    };
    const show=(index:number,automatic=false)=>{
      active=(index+total)%total;
      move(automatic&&index===total?total:active);
      captions.forEach((caption,i)=>caption.hidden=i!==active);
      thumbs.forEach((thumb,i)=>thumb.setAttribute('aria-pressed',String(i===active)));
      revealThumb();
      if(count)count.textContent=`${String(active+1).padStart(2,'0')} / ${String(total).padStart(2,'0')}`;
    };
    track.addEventListener('transitionend',event=>{if(event.target===track&&position===total)move(0,false);});
    let timer:ReturnType<typeof setInterval>;
    const restart=()=>{clearInterval(timer);if(total>1)timer=setInterval(()=>{if(!reduced.matches&&visible&&!document.hidden&&!document.documentElement.classList.contains('viewer-open'))show(active+1,true);},7000);};
    thumbs.forEach((thumb,i)=>thumb.addEventListener('click',()=>{show(i);restart();}));
    root.querySelector('.showcase-stage')?.addEventListener('keydown',event=>{const key=(event as KeyboardEvent).key;if(!document.documentElement.classList.contains('viewer-open')&&(key==='ArrowLeft'||key==='ArrowRight')){event.preventDefault();show(active+(key==='ArrowRight'?1:-1));restart();}});
    let pointer:number|null=null,startX=0,startY=0,swiped=false;
    stage?.addEventListener('pointerdown',event=>{pointer=event.pointerId;startX=event.clientX;startY=event.clientY;swiped=false;});
    stage?.addEventListener('pointerup',event=>{
      if(event.pointerId!==pointer)return;
      pointer=null;
      const dx=event.clientX-startX,dy=event.clientY-startY;
      if(total>1&&Math.abs(dx)>36&&Math.abs(dx)>Math.abs(dy)){swiped=true;show(active+(dx<0?1:-1));restart();}
    });
    stage?.addEventListener('pointercancel',()=>{pointer=null;});
    stage?.addEventListener('click',event=>{if(swiped&&event.detail>0){event.preventDefault();event.stopPropagation();}swiped=false;},true);
    new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;if(visible){prepare(position);prepare((position+1)%images.length);}}).observe(root);
    reduced.addEventListener('change',()=>{move(active,false);restart();});
    restart();
  });
</script>
<style>
  .image-showcase{min-width:0;width:100%;max-width:100%}.preview-note{margin:0 0 20px;font-size:12px;color:var(--muted)}
  .showcase-stage{position:relative;overflow:hidden;width:100%;min-width:0;height:auto;aspect-ratio:3/2;max-height:none;touch-action:pan-y pinch-zoom}
  .showcase-track{display:flex;width:100%;height:100%;will-change:transform}
  .showcase-image{display:block;flex:0 0 100%;min-width:0;width:100%;height:100%;cursor:zoom-in}
  .showcase-image :global(picture),.showcase-image :global(img){display:block;width:100%;height:100%;object-fit:contain;object-position:center}
  .showcase-image :global(img){user-select:none;-webkit-user-drag:none}
  [data-showcase-caption][hidden]{display:none}
  .showcase-bar{display:flex;justify-content:space-between;align-items:start;gap:16px;min-height:42px;padding:10px 0;font-size:12px;color:var(--muted)}
  .showcase-caption{min-width:0;line-height:1.5;overflow-wrap:anywhere}.showcase-actions{flex-shrink:0;white-space:nowrap;font-variant-numeric:tabular-nums;line-height:1.5}
  .showcase-thumbs{position:relative;display:flex;gap:12px;overflow-x:auto;padding:3px 0 6px;scrollbar-width:thin}
  .showcase-thumbs button{position:relative;flex:1 0 calc((100% - 60px)/6);min-width:80px;min-height:44px;max-width:200px;aspect-ratio:3/2;padding:0;border:0;background:rgba(255,255,255,.3);opacity:.65;cursor:pointer}
  .showcase-thumbs button[aria-pressed="true"]{opacity:1;outline:2px solid var(--ink);outline-offset:-3px}
  .showcase-thumbs :global(picture),.showcase-thumbs :global(img){display:block;width:100%;height:100%;object-fit:contain}
  .showcase-footer{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:8px;font-size:12px;color:var(--muted)}.showcase-footer a{display:inline-flex;align-items:center;min-height:44px;color:var(--ink)}
  button:focus-visible,a:focus-visible,.showcase-stage:focus-visible{outline:2px solid var(--ink);outline-offset:-3px}
  .compact .showcase-bar{font-size:11px}
  .side-thumbs{display:grid;grid-template-columns:minmax(0,1fr) clamp(100px,11vw,140px);column-gap:20px;align-items:start}
  .side-thumbs .showcase-stage{grid-column:1;grid-row:1}.side-thumbs .showcase-bar{grid-column:1/-1;grid-row:2}
  .side-thumbs .showcase-thumbs{grid-column:2;grid-row:1;contain:size;align-self:stretch;min-height:0;display:flex;flex-direction:column;overflow-y:auto;overflow-x:hidden;padding:3px 0;gap:12px;scrollbar-width:none}
  .side-thumbs .showcase-thumbs button{flex:0 0 auto;min-width:0;max-width:none;width:100%;aspect-ratio:3/2}
  .side-thumbs .showcase-footer{grid-column:1/-1;grid-row:3}
  @media(max-width:700px){
    .showcase-stage{width:100%;aspect-ratio:4/3;max-height:none}.showcase-bar{gap:12px;font-size:11px}
    .showcase-thumbs{gap:8px}.showcase-thumbs button{flex:0 0 25%;min-width:72px}
    .showcase-footer{font-size:11px}.showcase-footer a{font-size:12px}
    .side-thumbs{grid-template-columns:minmax(0,1fr) 52px;column-gap:8px}
    .side-thumbs .showcase-stage{width:100%;max-height:none}.side-thumbs .showcase-bar{grid-column:1/-1}
    .side-thumbs .showcase-thumbs{padding-inline:0;gap:8px}.side-thumbs .showcase-thumbs button{min-width:0;min-height:48px;aspect-ratio:1}
  }
  .side-thumbs .showcase-thumbs::-webkit-scrollbar{display:none}
  .showcase-footer,.showcase-bar{width:100%;box-sizing:border-box}
  .showcase-footer>a{flex-shrink:0;margin-left:auto;text-align:right}
  .showcase-actions{text-align:right;margin-left:auto}
  @media(max-width:700px){
    .showcase-bar{flex-direction:column;gap:4px;align-items:flex-start;text-align:left}
    .showcase-actions{margin-left:0;text-align:left}
    .showcase-footer{justify-content:flex-start;flex-wrap:wrap;gap:8px 20px;text-align:left}
    .showcase-footer>a{margin-left:0;text-align:left}
  }
</style>
