---
import GalleryImage from "./GalleryImage.astro";
import type { exhibitions } from "../lib/guangying-exhibitions";
interface Props {
  exhibition: (typeof exhibitions)[number];
  section: (typeof exhibitions)[number]["sections"][number];
  priority?: boolean;
}
const { exhibition, section, priority = false }: Props = Astro.props;
const group = `exhibition-${exhibition.slug}-${section.id}`;
---
<div class="photo-grid">
  {section.photos.map((photo, index) => (
    <figure>
      <a href={photo.originalSrc} data-viewer-open={`${group}:${index}`} aria-label={`打开看图：${photo.title}`}>
        <GalleryImage photo={photo} alt={[photo.title, photo.author].filter(Boolean).join(" · ")} sizes="(max-width:1000px) calc((100vw - 56px) / 2), 380px" priority={priority && index === 0} />
      </a>
      {!photo.captionInImage && (photo.title || photo.author) && <figcaption>{photo.title && <h3>{photo.title}</h3>}{photo.author && <p>摄影 / {photo.author}</p>}</figcaption>}
    </figure>
  ))}
</div>
<div hidden>
  {section.photos.map(photo => (
    <span data-viewer-item data-viewer-group={group} data-viewer-src={photo.viewerSrc} data-original-src={photo.originalSrc}
      data-viewer-title={photo.title} data-viewer-author={photo.author} data-viewer-alt={[photo.title, photo.author].filter(Boolean).join(" · ")}
      data-viewer-description={photo.caption} data-viewer-kicker={section.title} data-viewer-issue={exhibition.title}
      data-viewer-issue-href={`${exhibition.href}#${section.id}`} data-viewer-date={photo.date} data-viewer-original-label="查看高清图 ↗" />
  ))}
</div>
<style>
  .photo-grid { display:block; }
  figure { min-width:0; margin:0 0 48px; }
  a { display:block; cursor:zoom-in; }
  a :global(.gallery-responsive-picture img) { width:100%; height:auto; }
  figcaption { padding-top:10px; }
  h3 { margin:0; font:400 .95rem/1.5 var(--font-serif); overflow-wrap:anywhere; }
  p { margin:3px 0 0; font-size:.72rem; color:var(--muted); }
  @media(max-width:700px) { figure { margin-bottom:32px; } h3 { font-size:1.3rem; } }
</style>
