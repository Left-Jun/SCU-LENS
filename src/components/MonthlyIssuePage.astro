---
import BaseLayout from "../layouts/BaseLayout.astro";
import { authorHref } from "../lib/gallery-archive";

const {
  title,
  en,
  date,
  collectionPeriod,
  summary,
  works,
  viewerItems,
  viewerGroup,
  nextTitle,
  nextSummary,
  nextHref,
  nextPreviewItems = [],
  backHref = "/monthly-nine",
  collectionName = "每月九图",
  active = "/monthly-nine",
  backLabel = "返回每月九图",
  eyebrow = `Monthly Nine · ${date}`,
  countLabel,
  contributeHref,
  linkAuthors = true,
  showPhotoNumbers = true,
  showWorkType = true,
  variant = "default",
} = Astro.props;
---

<BaseLayout title={`${title} · ${collectionName} · SCU LENS`} active={active}>
  <div class:list={["page-shell", { "guangying-issue": variant === "guangying" }]}>
    <section class="page-hero issue-detail-hero">
      <div>
        <a class="back-link" href={backHref}>← {backLabel}</a>
        {variant !== "guangying" && <div class="eyebrow">{eyebrow}</div>}
        <h1 class="display">{title}</h1>
      </div>
    </section>

    <section class="section issue-detail-meta">
      <span>本期主题 · {en}</span>
      {collectionPeriod && <span>征集时间 · {collectionPeriod}</span>}
      <span>{countLabel ?? `${works.length} 组入选作品 · ${viewerItems.length} 张照片`}</span>
    </section>

    <section class="section issue-statement">
      {variant !== "guangying" && <div><div class="eyebrow">Theme Archive · 主题档案</div></div>}
      <div class="issue-statement-copy">
        {(Array.isArray(summary) ? summary : [summary]).map((paragraph) => <p>{paragraph}</p>)}
        {contributeHref && <a class="text-link" href={contributeHref}>查看征集与投稿方式 →</a>}
      </div>
    </section>

    <section class="issue-work-list">
      {works.map((work) => (
        <article class="issue-work">
          <div class:list={["issue-photo", work.height > work.width ? "portrait" : "landscape"]}>
            <a class="photo-open-link" href={work.originalSrc} data-viewer-open={`${viewerGroup}:${work.viewerIndex}`} aria-label={`打开看图：${work.alt ?? `《${work.title}》· ${work.author}`}`}>
              <img
                src={work.browserSrc}
                srcset={work.browserSrcset}
                sizes={variant === "guangying" ? "(max-width:1220px) calc(100vw - 40px), 1180px" : "(max-width: 900px) 100vw, 920px"}
                alt={work.alt ?? `《${work.title}》· ${work.author}`}
                width={work.width}
                height={work.height}
                loading={work.no === "01" ? "eager" : "lazy"}
                fetchpriority={work.no === "01" ? "high" : "auto"}
                decoding="async"
              />
            </a>
            {showPhotoNumbers && <span>{work.no}</span>}
            {work.photoCount > 1 && <b>+ {work.photoCount}</b>}
          </div>
          {!work.hideCaption && <div class="issue-work-caption">
            <div>
              {showWorkType && <span>{work.photoCount > 1 ? `${work.photoCount} 张组图` : "单图"}</span>}
              {work.title && <h2>《{work.title}》</h2>}
              {work.author && <p>摄影 / {work.author}</p>}
            </div>
            {work.href ? <a href={work.href}>查看完整组图 →</a> : null}
          </div>}
        </article>
      ))}
    </section>

    <section class="section issue-next">
      <span class="eyebrow">Next Issue</span>
      <h2>{nextTitle === "已至最新一期" ? nextTitle : nextTitle ? `下一主题 · ${nextTitle}` : "已至最新一期"}</h2>
      <a href={nextHref ?? "/monthly-nine"}>{nextTitle && nextTitle !== "已至最新一期" ? "查看下一期 →" : "返回历期总览 →"}</a>
    </section>

    <div class="viewer-registry" hidden>
      {viewerItems.map((item, index) => (
        <span
          data-viewer-item
          data-viewer-group={viewerGroup}
          data-viewer-src={item.src}
          data-original-src={item.original}
          data-viewer-alt={item.alt}
          data-viewer-title={item.title}
          data-viewer-author={item.author}
          data-viewer-author-href={linkAuthors ? authorHref(item.author) : undefined}
          data-viewer-kicker={item.kicker}
          data-viewer-issue={`${collectionName} · ${title}`}
          data-viewer-issue-href={Astro.url.pathname}
          data-viewer-section={item.section}
          data-viewer-date={item.date}
          data-viewer-original-label="查看高清图 ↗"
          data-next-title={index === viewerItems.length - 1 ? nextTitle : undefined}
          data-next-summary={index === viewerItems.length - 1 ? nextSummary : undefined}
          data-next-href={index === viewerItems.length - 1 ? nextHref : undefined}
          data-next-previews={index === viewerItems.length - 1 && nextPreviewItems.length ? JSON.stringify(nextPreviewItems) : undefined}
        ></span>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .issue-detail-hero { display:block; padding-bottom:42px; }
  .issue-detail-hero h1 { margin-top:14px; font-size:clamp(4.2rem,10vw,8rem); }
  .back-link { display:inline-block; margin-bottom:26px; color:var(--muted); font-size:.82rem; }
  .issue-detail-meta { display:flex; justify-content:space-between; gap:20px; padding-top:34px; padding-bottom:34px; color:var(--muted); font-size:.78rem; letter-spacing:.05em; }
  .issue-statement { display:grid; grid-template-columns:180px minmax(0,1fr); gap:clamp(28px,5vw,64px); align-items:start; padding-top:46px; padding-bottom:54px; }
  .issue-statement-copy { display:grid; gap:18px; }
  .issue-statement-copy > p { margin:0; max-width:760px; color:var(--muted); font-size:.96rem; line-height:1.82; }
  .issue-work-list { padding-bottom:68px; }
  .issue-work { padding:56px 0; border-top:1px solid var(--line); }
  .issue-photo { position:relative; width:100%; background:#ddd8ca; }
  .issue-photo.portrait { max-width:min(72vw,720px); margin-inline:auto; }
  .photo-open-link { display:block; cursor:zoom-in; }
  .issue-photo img { display:block; width:100%; height:auto; }
  .issue-photo > span { position:absolute; left:18px; top:16px; z-index:1; color:white; font-size:.72rem; letter-spacing:.12em; text-shadow:0 1px 8px rgba(0,0,0,.45); pointer-events:none; }
  .issue-photo > b { position:absolute; right:18px; bottom:16px; z-index:1; color:white; font:400 2rem var(--font-serif); text-shadow:0 1px 8px rgba(0,0,0,.45); pointer-events:none; }
  .issue-work-caption { display:flex; justify-content:space-between; gap:30px; padding-top:18px; align-items:end; }
  .issue-work-caption span { color:var(--muted); font-size:.72rem; letter-spacing:.08em; }
  .issue-work-caption h2 { margin:8px 0 4px; font:400 clamp(2.1rem,4vw,4.4rem)/1 var(--font-serif); }
  .issue-work-caption p { margin:0; color:var(--muted); }
  .issue-work-caption a { border-bottom:1px solid var(--ink); padding-bottom:5px; font-weight:700; font-size:.82rem; }
  .issue-next { display:grid; grid-template-columns:.4fr 1fr auto; gap:24px; align-items:end; }
  .issue-next h2 { margin:0; font:400 clamp(2rem,4vw,4rem)/1 var(--font-serif); }
  .issue-next a { font-weight:700; font-size:.82rem; }
  @media (max-width:700px) {
    .issue-detail-hero { padding-top:54px; padding-bottom:28px; }
    .issue-detail-hero h1 { font-size:clamp(3.8rem,18vw,5.8rem); }
    .issue-detail-meta { padding-top:28px; padding-bottom:28px; gap:12px; font-size:.68rem; flex-wrap:wrap; }
    .issue-statement { grid-template-columns:1fr; gap:20px; padding-top:34px; padding-bottom:40px; }
    .issue-work { padding:44px 0; }
    .issue-photo.portrait { max-width:100%; }
    .issue-work-caption { flex-direction:column; align-items:flex-start; }
    .issue-next { grid-template-columns:1fr; }
  }
  .guangying-issue .issue-detail-hero { padding-bottom:24px; }
  .guangying-issue .back-link { display:inline-flex; align-items:center; min-height:44px; margin-bottom:12px; }
  .guangying-issue .issue-detail-hero h1 { margin-top:0; font-size:clamp(44px,6vw,72px); line-height:1.15; }
  .guangying-issue .issue-detail-meta { flex-wrap:wrap; gap:8px 24px; padding-block:16px; font-size:12px; }
  .guangying-issue .issue-statement { display:block; padding-block:24px; }
  .guangying-issue .issue-statement-copy { gap:8px; }
  .guangying-issue .issue-statement-copy > p { font-size:14px; line-height:1.85; }
  .guangying-issue .issue-statement-copy > a { display:inline-flex; align-items:center; justify-self:start; min-height:44px; font-size:13px; }
  .guangying-issue .issue-work-list { display:grid; gap:40px; padding-bottom:48px; }
  .guangying-issue .issue-work { padding:0; border:0; }
  .guangying-issue .issue-photo { background:none; }
  .guangying-issue .issue-work-caption { padding-top:8px; gap:8px; }
  .guangying-issue .issue-work-caption h2 { margin:0 0 4px; font-size:18px; line-height:1.5; }
  .guangying-issue .issue-work-caption p { font-size:12px; line-height:1.7; }
  .guangying-issue .issue-next { padding-block:48px; }
  .guangying-issue .issue-next h2 { font-size:clamp(24px,3vw,36px); line-height:1.3; }
  .guangying-issue .issue-next a { display:inline-flex; align-items:center; min-height:44px; }
  @media(max-width:700px) {
    .guangying-issue .issue-detail-hero { padding-top:24px; padding-bottom:20px; }
    .guangying-issue .issue-detail-hero h1 { font-size:44px; }
    .guangying-issue .issue-statement { padding-block:20px; }
    .guangying-issue .issue-work-list { gap:24px; padding-bottom:32px; }
    .guangying-issue .issue-work-caption h2 { font-size:16px; }
    .guangying-issue .issue-next { padding-block:32px; gap:12px; }
  }
</style>
