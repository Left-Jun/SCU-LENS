---
import MonthlyIssuePage from "./MonthlyIssuePage.astro";
import { themeIssues } from "../lib/guangying-exhibitions";
interface Props { issue: (typeof themeIssues)[number]; }
const { issue }: Props = Astro.props;
const next = themeIssues[themeIssues.findIndex(candidate => candidate.slug === issue.slug) + 1];
const works = issue.photos.map((photo, index) => ({
  no: String(index + 1).padStart(2, "0"), title: photo.title, author: photo.author,
  photoCount: 1, viewerIndex: index, browserSrc: photo.src, browserSrcset: photo.srcset,
  originalSrc: photo.originalSrc, width: photo.width, height: photo.height,
  hideCaption: photo.captionInImage || (!photo.title && !photo.author),
  alt: photo.captionInImage ? "光影川大作品，标题和署名见图内" : [photo.title, photo.author].filter(Boolean).join(" · ") || "光影川大校园影像",
}));
const viewerItems = issue.photos.map(photo => ({ src: photo.viewerSrc, original: photo.originalSrc,
  title: photo.title, author: photo.author, alt: [photo.title, photo.author].filter(Boolean).join(" · ") || "光影川大校园影像", kicker: issue.title,
  section: photo.section, date: photo.date }));
---
<MonthlyIssuePage variant="guangying" title={issue.title} en={issue.en} collectionName="光影川大" active="/guangying-chuanda"
  eyebrow={`Light & Life at SCU · ${issue.en}`} backLabel="返回光影川大" backHref="/guangying-chuanda#awards"
  countLabel={`${issue.photos.length} 张照片 · ${issue.source}`}
  summary="光影川大持续征集校园影像，欢迎用镜头记录川大的风景与日常。"
  contributeHref="/guangying-chuanda#contribute" linkAuthors={false} showPhotoNumbers={false} showWorkType={false} works={works} viewerItems={viewerItems} viewerGroup={`guangying-issue-${issue.slug}`}
  nextTitle={next?.title} nextHref={next?.href ?? "/guangying-chuanda#awards"} />
